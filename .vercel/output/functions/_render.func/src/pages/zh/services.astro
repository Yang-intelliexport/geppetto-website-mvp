---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="CNC精密加工 | 透明制造服务 | Geppetto" 
  description="Geppetto提供透明的精密CNC加工服务，包含表面处理。72小时生产+运输，项目定制精度保证。"
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h1 class="text-5xl font-bold mb-6">
              透明精密制造服务
            </h1>
            <p class="text-2xl text-blue-100 mb-8">
              透明 • 可靠 • 初创友好
            </p>
            
            <!-- 核心服务指标 -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-12">
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">72小时生产完成</div>
                <div class="text-lg">保证交付</div>
                <div class="text-sm text-blue-200">可靠时间承诺</div>
              </div>
              
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">按需定制</div>
                <div class="text-lg">加工精度</div>
                <div class="text-sm text-blue-200">满足项目需求</div>
              </div>
              
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">50+</div>
                <div class="text-lg">材料选择</div>
                <div class="text-sm text-blue-200">全面材料库</div>
              </div>
              
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">100%</div>
                <div class="text-lg">成本透明</div>
                <div class="text-sm text-blue-200">每一分钱都说明</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 核心制造服务 -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              🔧 核心制造服务
            </h2>
            <p class="text-xl text-gray-600">
              覆盖从原型到批量生产的全制造链条
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- CNC精密加工 -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-3xl p-8 hover:shadow-xl transition-all duration-300">
              <div class="flex items-center mb-6">
                <div class="text-4xl mr-4">⚙️</div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-800">CNC精密加工</h3>
                  <p class="text-blue-600">业界领先的数控加工服务，支持3-5轴加工</p>
                </div>
              </div>
              
              <!-- 设备展示照片 -->
              <div class="mb-6 rounded-xl overflow-hidden">
                <img 
                  src="/images/facility/workshop-overview-1.jpg" 
                  alt="CNC精密加工车间" 
                  class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                />
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">加工能力</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 加工精度: 按项目需求定制</li>
                    <li>• 表面粗糙度: 项目定制精度标准</li>
                    <li>• 最大尺寸: 1500×1000×800mm</li>
                    <li>• 50+种材料选择</li>
                  </ul>
                </div>
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">应用领域</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 机器人关键部件</li>
                    <li>• 电子设备精密零件</li>
                    <li>• 机器人关键部件</li>
                    <li>• 医疗器械组件</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- 3D打印服务 -->
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-3xl p-8 hover:shadow-xl transition-all duration-300">
              <div class="flex items-center mb-6">
                <div class="text-4xl mr-4">🖨️</div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-800">3D打印服务</h3>
                  <p class="text-green-600">从快速原型到小批量生产的3D打印解决方案</p>
                </div>
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">技术能力</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 层厚精度: 项目定制标准</li>
                    <li>• 多种打印技术: FDM/SLA/SLS/SLM</li>
                    <li>• 金属与塑料材料</li>
                    <li>• 完整后处理服务</li>
                  </ul>
                </div>
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">应用场景</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 快速原型验证</li>
                    <li>• 复杂几何结构</li>
                    <li>• 小批量定制</li>
                    <li>• 功能性测试件</li>
                  </ul>
                </div>
              </div>
            </div>


            <!-- 表面处理 -->
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-3xl p-8 hover:shadow-xl transition-all duration-300">
              <div class="flex items-center mb-6">
                <div class="text-4xl mr-4">✨</div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-800">表面处理</h3>
                  <p class="text-purple-600">提升产品外观与性能的专业表面处理</p>
                </div>
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">处理工艺</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 阳极氧化/电镀/喷涂</li>
                    <li>• 防腐性能>240小时</li>
                    <li>• RAL/潘通色卡选择</li>
                    <li>• 激光雕刻定制</li>
                  </ul>
                </div>
                <div>
                  <h4 class="font-bold text-gray-700 mb-3">应用效果</h4>
                  <ul class="space-y-2 text-sm text-gray-600">
                    <li>• 外观质感提升</li>
                    <li>• 防腐蚀处理</li>
                    <li>• 品牌标识定制</li>
                    <li>• 功能性涂层</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI智能制造优势 -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              🤖 AI智能制造优势
            </h2>
            <p class="text-xl text-gray-600">
              将AI智能与传统制造完美融合
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- AI工艺规划 -->
            <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-3xl p-8 border border-blue-200 hover:shadow-lg transition-all duration-300">
              <div class="text-center">
                <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-6">
                  <span class="text-3xl text-white">🧠</span>
                </div>
                
                <h3 class="text-2xl font-bold text-gray-800 mb-4">AI工艺规划</h3>
                
                <div class="space-y-3 text-left">
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <span class="text-gray-700">图纸几何特征自动识别</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
                    <span class="text-gray-700">AI推荐最优加工路径</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <span class="text-gray-700">智能设定切削参数</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
                    <span class="text-gray-700">精确预测加工时间</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 智能排产调度 -->
            <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-3xl p-8 border border-green-200 hover:shadow-lg transition-all duration-300">
              <div class="text-center">
                <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-6">
                  <span class="text-3xl text-white">📊</span>
                </div>
                
                <h3 class="text-2xl font-bold text-gray-800 mb-4">智能排产调度</h3>
                
                <div class="space-y-3 text-left">
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                    <span class="text-gray-700">实时设备状态监控</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <span class="text-gray-700">智能排产算法优化</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                    <span class="text-gray-700">最优资源分配</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <span class="text-gray-700">动态调整生产计划</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 质量智能监控 -->
            <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-3xl p-8 border border-orange-200 hover:shadow-lg transition-all duration-300">
              <div class="text-center">
                <div class="w-20 h-20 bg-gradient-to-r from-orange-500 to-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
                  <span class="text-3xl text-white">🎯</span>
                </div>
                
                <h3 class="text-2xl font-bold text-gray-800 mb-4">质量智能监控</h3>
                
                <div class="space-y-3 text-left">
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                    <span class="text-gray-700">加工过程实时监控</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-red-500 rounded-full"></div>
                    <span class="text-gray-700">异常情况提前预警</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-orange-500 rounded-full"></div>
                    <span class="text-gray-700">质量数据深度分析</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-red-500 rounded-full"></div>
                    <span class="text-gray-700">工艺参数自动优化</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- AI+学徒制造模式 -->
          <div class="mt-16 bg-gradient-to-r from-purple-600 to-blue-600 rounded-3xl p-12 text-white">
            <div class="text-center mb-8">
              <h3 class="text-3xl font-bold mb-4">
                🎓 AI+学徒制造模式
              </h3>
              <p class="text-xl text-blue-100">
                AI的精准计算 × 资深师傅的工艺经验 = 制造业的降维打击
              </p>
            </div>

            <!-- 工作现场照片 -->
            <div class="relative mb-8 rounded-2xl overflow-hidden">
              <img 
                src="/images/manufacturing/cnc-operator.jpg" 
                alt="AI+学徒制造模式实际操作现场" 
                class="w-full h-64 object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
              <div class="text-center">
                <div class="text-4xl mb-3">🧮</div>
                <h4 class="font-bold text-yellow-300 mb-2">成本控制</h4>
                <p class="text-blue-200 text-sm">AI优化降低30%材料浪费</p>
              </div>
              
              <div class="text-center">
                <div class="text-4xl mb-3">⚡</div>
                <h4 class="font-bold text-yellow-300 mb-2">效率提升</h4>
                <p class="text-blue-200 text-sm">学徒执行降低50%人工成本</p>
              </div>
              
              <div class="text-center">
                <div class="text-4xl mb-3">🏆</div>
                <h4 class="font-bold text-yellow-300 mb-2">质量保证</h4>
                <p class="text-blue-200 text-sm">师傅监督确保工艺标准</p>
              </div>
              
              <div class="text-center">
                <div class="text-4xl mb-3">🚀</div>
                <h4 class="font-bold text-yellow-300 mb-2">速度保障</h4>
                <p class="text-blue-200 text-sm">AI排产实现工作时间交付</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 行业应用案例 -->
    <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              🌟 行业应用案例
            </h2>
            <p class="text-xl text-gray-600">
              专注服务机器人和电子制造行业，提供专业化制造解决方案
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- 机器人行业 -->
            <div class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-2xl transition-all duration-300 group">
              <div class="text-center">
                <div class="text-4xl mb-4">🤖</div>
                <h3 class="text-xl font-bold text-gray-800 mb-4">机器人制造专家</h3>
                <div class="space-y-2 text-sm text-gray-600">
                  <div>• 关节轴承座: 项目定制精度</div>
                  <div>• 减速器外壳: 复杂内腔</div>
                  <div>• 传感器支架: 轻量化设计</div>
                  <div>• 线缆保护套: 柔性材料</div>
                </div>
              </div>
            </div>

            <!-- 航空航天 -->
            <div class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-2xl transition-all duration-300 group">
              <div class="text-center">
                <div class="text-4xl mb-4">✈️</div>
                <h3 class="text-xl font-bold text-gray-800 mb-4">航空航天</h3>
                <div class="space-y-2 text-sm text-gray-600">
                  <div>• 发动机叶片: 复杂曲面</div>
                  <div>• 结构件: 高强度材料</div>
                  <div>• 紧固件: 特殊材料定制</div>
                  <div>• 测试夹具: 高精度要求</div>
                </div>
              </div>
            </div>

            <!-- 医疗器械 -->
            <div class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-2xl transition-all duration-300 group">
              <div class="text-center">
                <div class="text-4xl mb-4">🏥</div>
                <h3 class="text-xl font-bold text-gray-800 mb-4">医疗器械</h3>
                <div class="space-y-2 text-sm text-gray-600">
                  <div>• 手术器械: 不锈钢精密</div>
                  <div>• 植入物: 钛合金生物材料</div>
                  <div>• 检测设备: 传感器外壳</div>
                  <div>• 康复器材: 人体工程学</div>
                </div>
              </div>
            </div>

            <!-- 电子设备 -->
            <div class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-2xl transition-all duration-300 group">
              <div class="text-center">
                <div class="text-4xl mb-4">📱</div>
                <h3 class="text-xl font-bold text-gray-800 mb-4">电子制造专家</h3>
                <div class="space-y-2 text-sm text-gray-600">
                  <div>• 散热器: 复杂散热翅片结构</div>
                  <div>• EMI屏蔽罩: 电磁屏蔽性能</div>
                  <div>• 精密连接器: 微小特征加工</div>
                  <div>• 外壳组件: 超薄壁厚控制</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 精度技术能力 -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-6">
            🏗️ 项目定制精度保障体系
          </h2>
          <p class="text-xl text-gray-600">
            设备精度 × AI优化 × 工艺控制 × 质量监控 = 超越行业的精度水平
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
          <div class="bg-white rounded-xl p-6 shadow-lg text-center">
            <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center text-2xl mb-4 mx-auto">🔧</div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">设备精度基础</h3>
            <p class="text-gray-600 text-sm mb-4">五轴联动CNC设备，微米级精度控制能力</p>
            <div class="text-purple-600 font-bold">基础精度保障</div>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-lg text-center">
            <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-2xl mb-4 mx-auto">🤖</div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">AI智能优化</h3>
            <p class="text-gray-600 text-sm mb-4">实时刀路优化，动态补偿算法</p>
            <div class="text-blue-600 font-bold">智能精度提升</div>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-lg text-center">
            <div class="w-16 h-16 bg-green-100 text-green-600 rounded-lg flex items-center justify-center text-2xl mb-4 mx-auto">⚙️</div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">工艺流程控制</h3>
            <p class="text-gray-600 text-sm mb-4">标准化工艺参数，严格执行规范</p>
            <div class="text-green-600 font-bold">工艺精度控制</div>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-lg text-center">
            <div class="w-16 h-16 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center text-2xl mb-4 mx-auto">📊</div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">全程质量监控</h3>
            <p class="text-gray-600 text-sm mb-4">实时检测，数据驱动品质保证</p>
            <div class="text-orange-600 font-bold">监控精度验证</div>
          </div>
        </div>

        <!-- 精度数据展示 -->
        <div class="bg-white rounded-2xl shadow-xl p-8">
          <h3 class="text-2xl font-bold text-center text-gray-800 mb-8">实际精度表现</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="text-4xl font-bold text-green-600 mb-2">按需定制</div>
              <div class="text-gray-600 mb-2">实际平均精度</div>
              <div class="text-sm text-gray-500">根据项目需求定制精度标准</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-blue-600 mb-2">按需定制</div>
              <div class="text-gray-600 mb-2">最高精度记录</div>
              <div class="text-sm text-gray-500">极限精度挑战成功案例</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-purple-600 mb-2">99.5%</div>
              <div class="text-gray-600 mb-2">一次合格率</div>
              <div class="text-sm text-gray-500">质量稳定性表现</div>
            </div>
          </div>
        </div>
      </div>
    </section>

