---
// ProgressTracker Island组件 - 智能进度跟踪显示
// 使用client:visible指令按需加载，提升性能

interface ProgressStep {
  id: string;
  title: string;
  description?: string;
  status: 'pending' | 'active' | 'completed' | 'error';
  timestamp?: string;
  estimatedTime?: string;
}

interface Props {
  className?: string;
  steps: ProgressStep[];
  currentStep?: string;
  title?: string;
  showTimestamp?: boolean;
  showEstimatedTime?: boolean;
  autoUpdate?: boolean;
  updateInterval?: number; // seconds
}

const { 
  className = "",
  steps = [],
  currentStep = "",
  title = "处理进度",
  showTimestamp = true,
  showEstimatedTime = true,
  autoUpdate = false,
  updateInterval = 30
} = Astro.props;
---

<div id="progress-tracker" class={`progress-tracker-container ${className}`}>
  <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold text-gray-800 flex items-center">
        📊 {title}
      </h3>
      
      <!-- 总体进度 -->
      <div class="text-sm text-gray-600">
        <span id="progress-percentage">0%</span> 完成
      </div>
    </div>

    <!-- 进度条 -->
    <div class="mb-8">
      <div class="bg-gray-200 rounded-full h-3 shadow-inner">
        <div 
          id="overall-progress-bar" 
          class="bg-gradient-to-r from-purple-500 to-blue-500 h-3 rounded-full transition-all duration-500 relative"
          style="width: 0%"
        >
          <div class="absolute inset-0 bg-gradient-to-r from-purple-400 to-blue-400 rounded-full opacity-50 animate-pulse"></div>
        </div>
      </div>
    </div>

    <!-- 步骤列表 -->
    <div id="progress-steps" class="space-y-4">
      <!-- 步骤将通过JavaScript动态生成 -->
    </div>

    <!-- 实时状态 -->
    <div id="live-status" class="hidden mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
      <div class="flex items-center space-x-3">
        <div class="flex-shrink-0">
          <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
        </div>
        <div>
          <div class="font-medium text-blue-800">实时更新</div>
          <div id="status-message" class="text-sm text-blue-600">正在获取最新状态...</div>
          <div id="last-update" class="text-xs text-blue-500 mt-1"></div>
        </div>
      </div>
    </div>

    <!-- 操作按钮 -->
    <div id="action-buttons" class="hidden mt-6 flex justify-center space-x-4">
      <button 
        id="refresh-btn"
        class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors flex items-center space-x-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        <span>刷新状态</span>
      </button>
      
      <button 
        id="details-btn"
        class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center space-x-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>查看详情</span>
      </button>
    </div>

    <!-- 完成庆祝动画 -->
    <div id="completion-celebration" class="hidden text-center py-8">
      <div class="text-6xl mb-4">🎉</div>
      <h4 class="text-2xl font-bold text-green-600 mb-2">处理完成！</h4>
      <p class="text-gray-600">所有步骤已成功完成</p>
    </div>
  </div>
</div>

<script>
  // ProgressTracker Island组件的JavaScript逻辑
  // 使用client:visible按需加载，提升首屏性能
  
  class ProgressTrackerIsland {
    constructor(initialSteps = [], options = {}) {
      this.steps = initialSteps;
      this.options = {
        autoUpdate: options.autoUpdate || false,
        updateInterval: (options.updateInterval || 30) * 1000,
        showTimestamp: options.showTimestamp !== false,
        showEstimatedTime: options.showEstimatedTime !== false,
        onStepChange: options.onStepChange || null,
        onComplete: options.onComplete || null
      };
      
      this.updateTimer = null;
      this.isCompleted = false;
      
      this.initializeEventListeners();
      this.renderSteps();
      this.updateProgress();
      
      if (this.options.autoUpdate) {
        this.startAutoUpdate();
      }
    }

    initializeEventListeners() {
      const refreshBtn = document.getElementById('refresh-btn');
      const detailsBtn = document.getElementById('details-btn');
      
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => this.refresh());
      }
      
      if (detailsBtn) {
        detailsBtn.addEventListener('click', () => this.showDetails());
      }
    }

    renderSteps() {
      const stepsContainer = document.getElementById('progress-steps');
      if (!stepsContainer) return;

      stepsContainer.innerHTML = '';

      this.steps.forEach((step, index) => {
        const stepElement = document.createElement('div');
        stepElement.className = `progress-step-item ${step.status}`;
        stepElement.dataset.stepId = step.id;
        
        const isLast = index === this.steps.length - 1;
        const statusIcon = this.getStatusIcon(step.status);
        const statusColor = this.getStatusColor(step.status);
        
        stepElement.innerHTML = `
          <div class="flex items-start space-x-4">
            <!-- 步骤指示器 -->
            <div class="flex-shrink-0 relative">
              <div class="w-10 h-10 ${statusColor} rounded-full flex items-center justify-center text-white font-bold shadow-lg">
                ${statusIcon}
              </div>
              ${!isLast ? `<div class="absolute top-10 left-1/2 transform -translate-x-px w-0.5 h-8 ${step.status === 'completed' ? 'bg-green-300' : 'bg-gray-200'}"></div>` : ''}
            </div>
            
            <!-- 步骤内容 -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h4 class="font-semibold text-gray-800">${step.title}</h4>
                ${step.status === 'active' ? '<div class="flex space-x-1"><div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce"></div><div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div><div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div></div>' : ''}
              </div>
              
              ${step.description ? `<p class="text-sm text-gray-600 mt-1">${step.description}</p>` : ''}
              
              <div class="flex items-center justify-between mt-2 text-xs text-gray-500">
                <div class="flex items-center space-x-4">
                  ${step.timestamp && this.options.showTimestamp ? `
                    <span class="flex items-center space-x-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                      </svg>
                      <span>${this.formatTimestamp(step.timestamp)}</span>
                    </span>
                  ` : ''}
                  
                  ${step.estimatedTime && this.options.showEstimatedTime && step.status === 'active' ? `
                    <span class="flex items-center space-x-1 text-blue-600">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                      </svg>
                      <span>预计 ${step.estimatedTime}</span>
                    </span>
                  ` : ''}
                </div>
                
                <span class="step-status-badge ${step.status}">
                  ${this.getStatusText(step.status)}
                </span>
              </div>
            </div>
          </div>
        `;
        
        stepsContainer.appendChild(stepElement);
      });

      // 检查是否全部完成
      this.checkCompletion();
    }

    getStatusIcon(status) {
      const icons = {
        'pending': '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-.464 5.535a1 1 0 10-1.415-1.414 3 3 0 01-4.242 0 1 1 0 00-1.415 1.414 5 5 0 007.072 0z" clip-rule="evenodd"></path></svg>',
        'active': '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.293l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"></path></svg>',
        'completed': '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>',
        'error': '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>'
      };
      return icons[status] || icons['pending'];
    }

    getStatusColor(status) {
      const colors = {
        'pending': 'bg-gray-400',
        'active': 'bg-blue-500',
        'completed': 'bg-green-500',
        'error': 'bg-red-500'
      };
      return colors[status] || colors['pending'];
    }

    getStatusText(status) {
      const texts = {
        'pending': '待处理',
        'active': '进行中',
        'completed': '已完成',
        'error': '错误'
      };
      return texts[status] || texts['pending'];
    }

    formatTimestamp(timestamp) {
      const date = new Date(timestamp);
      const now = new Date();
      const diffMinutes = Math.floor((now - date) / (1000 * 60));
      
      if (diffMinutes < 1) return '刚刚';
      if (diffMinutes < 60) return `${diffMinutes}分钟前`;
      if (diffMinutes < 24 * 60) return `${Math.floor(diffMinutes / 60)}小时前`;
      
      return date.toLocaleDateString('zh-CN', { 
        month: 'short', 
        day: 'numeric', 
        hour: '2-digit', 
        minute: '2-digit' 
      });
    }

    updateProgress() {
      const completedSteps = this.steps.filter(step => step.status === 'completed').length;
      const totalSteps = this.steps.length;
      const percentage = totalSteps > 0 ? (completedSteps / totalSteps) * 100 : 0;
      
      const progressBar = document.getElementById('overall-progress-bar');
      const progressPercentage = document.getElementById('progress-percentage');
      
      if (progressBar) {
        progressBar.style.width = `${percentage}%`;
      }
      
      if (progressPercentage) {
        progressPercentage.textContent = `${Math.round(percentage)}%`;
      }
      
      // 显示操作按钮
      const actionButtons = document.getElementById('action-buttons');
      if (actionButtons && totalSteps > 0) {
        actionButtons.classList.remove('hidden');
      }
    }

    checkCompletion() {
      const allCompleted = this.steps.every(step => step.status === 'completed');
      
      if (allCompleted && !this.isCompleted && this.steps.length > 0) {
        this.isCompleted = true;
        this.showCompletionCelebration();
        
        if (this.options.onComplete) {
          this.options.onComplete(this.steps);
        }
        
        this.stopAutoUpdate();
      }
    }

    showCompletionCelebration() {
      const celebration = document.getElementById('completion-celebration');
      if (celebration) {
        celebration.classList.remove('hidden');
        
        // 触发庆祝动画
        setTimeout(() => {
          celebration.style.animation = 'bounceIn 1s ease-out';
        }, 100);
        
        // 触发烟花效果（如果可用）
        this.triggerConfetti();
      }
    }

    triggerConfetti() {
      // 简单的庆祝效果
      const colors = ['#7c3aed', '#3b82f6', '#10b981', '#f59e0b', '#ef4444'];
      
      for (let i = 0; i < 50; i++) {
        setTimeout(() => {
          const confetti = document.createElement('div');
          confetti.style.cssText = `
            position: fixed;
            width: 10px;
            height: 10px;
            background: ${colors[Math.floor(Math.random() * colors.length)]};
            top: -10px;
            left: ${Math.random() * 100}vw;
            z-index: 9999;
            pointer-events: none;
            border-radius: 50%;
            animation: confetti-fall 3s linear forwards;
          `;
          
          document.body.appendChild(confetti);
          
          setTimeout(() => {
            if (confetti.parentNode) {
              confetti.parentNode.removeChild(confetti);
            }
          }, 3000);
        }, i * 50);
      }
    }

    updateStep(stepId, updates) {
      const stepIndex = this.steps.findIndex(step => step.id === stepId);
      if (stepIndex === -1) return false;
      
      const oldStep = { ...this.steps[stepIndex] };
      this.steps[stepIndex] = { ...this.steps[stepIndex], ...updates };
      
      this.renderSteps();
      this.updateProgress();
      
      if (this.options.onStepChange) {
        this.options.onStepChange(this.steps[stepIndex], oldStep);
      }
      
      return true;
    }

    addStep(step) {
      this.steps.push(step);
      this.renderSteps();
      this.updateProgress();
    }

    setSteps(newSteps) {
      this.steps = newSteps;
      this.isCompleted = false;
      this.renderSteps();
      this.updateProgress();
    }

    refresh() {
      const refreshBtn = document.getElementById('refresh-btn');
      if (refreshBtn) {
        refreshBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg><span>刷新中...</span>';
        
        setTimeout(() => {
          refreshBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg><span>刷新状态</span>';
        }, 1000);
      }
      
      // 触发刷新事件
      const event = new CustomEvent('progressRefresh', { 
        detail: { steps: this.steps } 
      });
      document.dispatchEvent(event);
    }

    showDetails() {
      // 触发详情查看事件
      const event = new CustomEvent('progressDetails', { 
        detail: { steps: this.steps } 
      });
      document.dispatchEvent(event);
    }

    startAutoUpdate() {
      this.stopAutoUpdate();
      
      const liveStatus = document.getElementById('live-status');
      const lastUpdate = document.getElementById('last-update');
      
      if (liveStatus) {
        liveStatus.classList.remove('hidden');
      }
      
      this.updateTimer = setInterval(() => {
        // 触发自动更新事件
        const event = new CustomEvent('progressAutoUpdate', { 
          detail: { steps: this.steps } 
        });
        document.dispatchEvent(event);
        
        if (lastUpdate) {
          lastUpdate.textContent = `最后更新: ${new Date().toLocaleTimeString('zh-CN')}`;
        }
      }, this.options.updateInterval);
    }

    stopAutoUpdate() {
      if (this.updateTimer) {
        clearInterval(this.updateTimer);
        this.updateTimer = null;
      }
      
      const liveStatus = document.getElementById('live-status');
      if (liveStatus) {
        liveStatus.classList.add('hidden');
      }
    }

    destroy() {
      this.stopAutoUpdate();
    }
  }

  // 全局实例管理
  let progressTrackerInstance;

  // 组件初始化
  document.addEventListener('DOMContentLoaded', () => {
    // 从HTML数据属性获取初始配置
    const container = document.getElementById('progress-tracker');
    if (container) {
      const initialSteps = JSON.parse(container.dataset.steps || '[]');
      const options = JSON.parse(container.dataset.options || '{}');
      
      progressTrackerInstance = new ProgressTrackerIsland(initialSteps, options);
      
      // 暴露到全局
      window.progressTracker = progressTrackerInstance;
    }
  });
</script>

<style>
  .progress-tracker-container {
    max-width: 100%;
  }

  /* 步骤项样式 */
  .progress-step-item {
    padding: 1rem;
    border-radius: 0.75rem;
    transition: all 0.3s ease;
  }

  .progress-step-item.active {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05), rgba(124, 58, 237, 0.05));
    border: 1px solid rgba(59, 130, 246, 0.2);
  }

  .progress-step-item.completed {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(5, 150, 105, 0.05));
  }

  .progress-step-item.error {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.05), rgba(220, 38, 38, 0.05));
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  /* 状态徽章 */
  .step-status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .step-status-badge.pending {
    background: rgba(107, 114, 128, 0.1);
    color: #374151;
  }

  .step-status-badge.active {
    background: rgba(59, 130, 246, 0.1);
    color: #1d4ed8;
  }

  .step-status-badge.completed {
    background: rgba(16, 185, 129, 0.1);
    color: #065f46;
  }

  .step-status-badge.error {
    background: rgba(239, 68, 68, 0.1);
    color: #991b1b;
  }

  /* 庆祝动画 */
  @keyframes bounceIn {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.8;
    }
    70% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes confetti-fall {
    0% {
      transform: translateY(-100vh) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translateY(100vh) rotate(360deg);
      opacity: 0;
    }
  }

  /* 响应式设计 */
  @media (max-width: 640px) {
    .progress-step-item {
      padding: 0.75rem;
    }
    
    .progress-step-item .flex {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .progress-step-item .flex-shrink-0 {
      margin-bottom: 0.75rem;
    }
  }
</style>