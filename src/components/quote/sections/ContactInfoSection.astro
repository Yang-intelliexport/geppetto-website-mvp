---
interface Props {
  language?: 'zh' | 'en';
}

const { language = 'zh' } = Astro.props;

const text = {
  zh: {
    title: '联系信息',
    email: { label: '邮箱地址', placeholder: 'your@email.com', required: true },
    name: { label: '联系人姓名', placeholder: '请输入您的姓名', required: false },
    company: { label: '公司名称', placeholder: '请输入公司名称', required: false },
    phone: { label: '联系电话', placeholder: '请输入联系电话', required: false },
    validation: {
      emailRequired: '邮箱地址为必填项',
      emailInvalid: '请输入有效的邮箱地址',
      nameInvalid: '姓名长度应在2-50个字符之间',
      phoneInvalid: '请输入有效的电话号码'
    }
  },
  en: {
    title: 'Contact Information',
    email: { label: 'Email Address', placeholder: 'your@email.com', required: true },
    name: { label: 'Contact Name', placeholder: 'Enter your name', required: false },
    company: { label: 'Company Name', placeholder: 'Enter company name', required: false },
    phone: { label: 'Phone Number', placeholder: 'Enter phone number', required: false },
    validation: {
      emailRequired: 'Email address is required',
      emailInvalid: 'Please enter a valid email address',
      nameInvalid: 'Name should be between 2-50 characters',
      phoneInvalid: 'Please enter a valid phone number'
    }
  }
}

const t = text[language];
---

<div class="contact-info-section">
  <h3 class="text-lg font-medium text-gray-900 mb-4">{t.title}</h3>
  
  <div class="grid grid-cols-1 gap-4">
    <!-- Email (Required) -->
    <div class="form-field">
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        {t.email.label}
        <span class="text-red-500 ml-1">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder={t.email.placeholder}
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      />
      <div id="email-error" class="text-red-600 text-sm mt-1 hidden"></div>
    </div>

    <!-- Name (Optional) -->
    <div class="form-field">
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
        {t.name.label}
      </label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder={t.name.placeholder}
        maxlength="50"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      />
      <div id="name-error" class="text-red-600 text-sm mt-1 hidden"></div>
    </div>

    <!-- Company (Optional) -->
    <div class="form-field">
      <label for="company" class="block text-sm font-medium text-gray-700 mb-1">
        {t.company.label}
      </label>
      <input
        type="text"
        id="company"
        name="company"
        placeholder={t.company.placeholder}
        maxlength="100"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      />
    </div>

    <!-- Phone (Optional) -->
    <div class="form-field">
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
        {t.phone.label}
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        placeholder={t.phone.placeholder}
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      />
      <div id="phone-error" class="text-red-600 text-sm mt-1 hidden"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ language }}>
class ContactInfoValidator {
  constructor() {
    this.language = language;
    this.text = {
      zh: {
        emailRequired: '邮箱地址为必填项',
        emailInvalid: '请输入有效的邮箱地址',
        nameInvalid: '姓名长度应在2-50个字符之间',
        phoneInvalid: '请输入有效的电话号码'
      },
      en: {
        emailRequired: 'Email address is required',
        emailInvalid: 'Please enter a valid email address',
        nameInvalid: 'Name should be between 2-50 characters',
        phoneInvalid: 'Please enter a valid phone number'
      }
    };
    this.t = this.text[this.language];
    this.initializeValidation();
  }

  initializeValidation() {
    const emailInput = document.getElementById('email');
    const nameInput = document.getElementById('name');
    const phoneInput = document.getElementById('phone');

    if (emailInput) {
      emailInput.addEventListener('blur', () => this.validateEmail());
      emailInput.addEventListener('input', () => this.clearError('email'));
    }

    if (nameInput) {
      nameInput.addEventListener('blur', () => this.validateName());
      nameInput.addEventListener('input', () => this.clearError('name'));
    }

    if (phoneInput) {
      phoneInput.addEventListener('blur', () => this.validatePhone());
      phoneInput.addEventListener('input', () => this.clearError('phone'));
    }
  }

  validateEmail() {
    const emailInput = document.getElementById('email');
    const email = emailInput?.value.trim() || '';
    
    if (!email) {
      this.showError('email', this.t.emailRequired);
      return false;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      this.showError('email', this.t.emailInvalid);
      return false;
    }

    this.clearError('email');
    return true;
  }

  validateName() {
    const nameInput = document.getElementById('name');
    const name = nameInput?.value.trim() || '';
    
    // Name is optional, but if provided, should be valid
    if (name && (name.length < 2 || name.length > 50)) {
      this.showError('name', this.t.nameInvalid);
      return false;
    }

    this.clearError('name');
    return true;
  }

  validatePhone() {
    const phoneInput = document.getElementById('phone');
    const phone = phoneInput?.value.trim() || '';
    
    // Phone is optional, but if provided, should be valid
    if (phone) {
      // Basic phone validation - should contain digits and common phone characters
      const phoneRegex = /^[\+\-\(\)\s\d]{7,20}$/;
      if (!phoneRegex.test(phone)) {
        this.showError('phone', this.t.phoneInvalid);
        return false;
      }
    }

    this.clearError('phone');
    return true;
  }

  validateAll() {
    const emailValid = this.validateEmail();
    const nameValid = this.validateName();
    const phoneValid = this.validatePhone();
    
    return emailValid && nameValid && phoneValid;
  }

  showError(fieldId, message) {
    const errorElement = document.getElementById(`${fieldId}-error`);
    const inputElement = document.getElementById(fieldId);
    
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
    
    if (inputElement) {
      inputElement.classList.add('border-red-500');
      inputElement.classList.remove('border-gray-300');
    }
  }

  clearError(fieldId) {
    const errorElement = document.getElementById(`${fieldId}-error`);
    const inputElement = document.getElementById(fieldId);
    
    if (errorElement) {
      errorElement.classList.add('hidden');
    }
    
    if (inputElement) {
      inputElement.classList.remove('border-red-500');
      inputElement.classList.add('border-gray-300');
    }
  }

  getContactData() {
    return {
      email: document.getElementById('email')?.value.trim() || '',
      name: document.getElementById('name')?.value.trim() || '',
      company: document.getElementById('company')?.value.trim() || '',
      phone: document.getElementById('phone')?.value.trim() || ''
    };
  }
}

// Initialize contact info validator when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  window.contactInfoValidator = new ContactInfoValidator();
});
</script>

<style>
.contact-info-section {
  @apply w-full;
}

.form-field input:focus {
  @apply ring-2 ring-indigo-500 ring-opacity-50;
}

.form-field input.border-red-500:focus {
  @apply ring-red-500;
}
</style>