---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 获取所有中文资源文章（非草稿）
const allResources = await getCollection('resources', ({ data }) => {
  return !data.draft;
});

// 按发布日期排序
const sortedResources = allResources.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// 获取推荐文章
const featuredResources = sortedResources.filter(resource => resource.data.featured);

// 按分类分组
const categories = [
  'manufacturing-guides',
  'cnc-machining', 
  'materials-science',
  'design-tips',
  'industry-insights',
  'automation-ai',
  'quality-control',
  'cost-optimization'
];

const categoryMap = {
  'manufacturing-guides': '制造指南',
  'cnc-machining': 'CNC加工',
  'materials-science': '材料科学',
  'design-tips': '设计技巧',
  'industry-insights': '行业洞察',
  'automation-ai': '自动化与AI',
  'quality-control': '质量控制',
  'cost-optimization': '成本优化'
};

const resourcesByCategory = categories.reduce((acc, category) => {
  acc[category] = sortedResources.filter(resource => resource.data.category === category);
  return acc;
}, {});

const seoData = {
  title: 'Geppetto制造资源 - CNC加工指南与行业洞察',
  description: '深入了解CNC加工、材料科学、设计优化等制造领域专业知识。获取专家级制造指南，提升产品质量和生产效率。',
  keywords: ['CNC加工指南', '制造业知识', '材料科学', '设计优化', '质量控制', '成本优化', '智能制造', 'AI制造']
};

const formatDate = (date) => {
  return new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<BaseLayout
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl lg:text-6xl font-bold mb-6">
          制造知识库
        </h1>
        <p class="text-2xl text-blue-100 mb-8 max-w-3xl mx-auto">
          深度制造洞察 • 专家级指南 • 行业最佳实践
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/zh/create-quote"
            class="bg-white text-purple-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
          >
            获取专家报价
          </a>
          <a 
            href="#categories"
            class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-purple-600 transition-colors"
          >
            浏览资源
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 推荐文章 -->
  {featuredResources.length > 0 && (
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">
            ⭐ 推荐文章
          </h2>
          <p class="text-xl text-gray-600">
            精选专家深度解析，助力制造决策
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredResources.slice(0, 6).map((resource) => (
            <article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
              {resource.data.image && (
                <img 
                  src={resource.data.image} 
                  alt={resource.data.imageAlt || resource.data.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                <div class="flex items-center space-x-2 mb-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    {categoryMap[resource.data.category] || resource.data.category}
                  </span>
                  <span class="text-xs text-gray-500">
                    {resource.data.readingTime} 分钟
                  </span>
                </div>
                
                <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                  <a href={`/zh/resources/${resource.slug}`} class="hover:text-purple-600 transition-colors">
                    {resource.data.title}
                  </a>
                </h3>
                
                <p class="text-gray-600 mb-4 line-clamp-3">
                  {resource.data.description}
                </p>
                
                <div class="flex items-center justify-between text-sm text-gray-500">
                  <span>{resource.data.author}</span>
                  <time datetime={resource.data.publishDate.toISOString()}>
                    {formatDate(resource.data.publishDate)}
                  </time>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 分类浏览 -->
  <section id="categories" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          📂 分类浏览
        </h2>
        <p class="text-xl text-gray-600">
          按专业领域深入学习制造知识
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {categories.map((category) => {
          const categoryResources = resourcesByCategory[category] || [];
          const categoryName = categoryMap[category];
          
          if (categoryResources.length === 0) return null;
          
          return (
            <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden h-full flex flex-col">
              <div class="p-6 flex flex-col h-full">
                <!-- Header Section - Fixed Height -->
                <div class="text-center mb-4 flex-shrink-0">
                  <div class="w-16 h-16 bg-purple-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <span class="text-2xl">
                      {category === 'manufacturing-guides' ? '🏭' :
                       category === 'cnc-machining' ? '⚙️' :
                       category === 'materials-science' ? '🧪' :
                       category === 'design-tips' ? '✏️' :
                       category === 'industry-insights' ? '📈' :
                       category === 'automation-ai' ? '🤖' :
                       category === 'quality-control' ? '🎯' :
                       category === 'cost-optimization' ? '💰' : '📚'}
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2 min-h-[2.5rem] flex items-center justify-center">
                    {categoryName}
                  </h3>
                  <p class="text-gray-600 text-sm">
                    {categoryResources.length} 篇文章
                  </p>
                </div>
                
                <!-- Content Section - Flexible Height -->
                <div class="flex-grow mb-6">
                  <div class="space-y-3">
                    {categoryResources.slice(0, 3).map((resource) => (
                      <a 
                        href={`/zh/resources/${resource.slug}`}
                        class="block text-sm text-gray-700 hover:text-purple-600 transition-colors line-clamp-2 hover:bg-purple-50 p-2 rounded leading-tight"
                      >
                        {resource.data.title}
                      </a>
                    ))}
                  </div>
                </div>
                
                <!-- Footer Button - Fixed at Bottom -->
                <div class="flex-shrink-0 mt-auto">
                  <a 
                    href={`/zh/resources/category/${category}`}
                    class="block w-full text-center bg-purple-600 text-white py-3 px-4 rounded-lg hover:bg-purple-700 transition-colors text-sm font-medium"
                  >
                    查看全部
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-gradient-to-r from-purple-600 to-blue-600 py-16">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        将知识转化为实际生产
      </h2>
      <p class="text-xl text-blue-100 mb-8">
        获取透明报价，体验专家制造服务
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/zh/create-quote"
          class="bg-white text-purple-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          上传文件获取报价
        </a>
        <a 
          href="/zh/contact"
          class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-purple-600 transition-colors"
        >
          💬 咨询专家
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>