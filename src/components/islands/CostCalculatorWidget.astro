---
// CostCalculator Island组件 - 成本计算核心逻辑
// 使用client:idle指令按需加载，优化首屏性能

interface Props {
  className?: string;
  initialValues?: {
    projectName?: string;
    quantity?: number;
    length?: number;
    width?: number;
    thickness?: number;
  };
}

const { className = "", initialValues = {} } = Astro.props;
---

<div id="cost-calculator-widget" class={`cost-calculator-container ${className}`}>
  <!-- 计算器表单UI -->
  <form id="cost-calculator-form" class="space-y-6">
    <!-- 项目基本信息 -->
    <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
        📐 项目信息
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label for="project-name" class="block text-sm font-semibold text-gray-700 mb-2">
            项目名称
          </label>
          <input 
            type="text" 
            id="project-name" 
            value={initialValues.projectName || ""}
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300"
            placeholder="请输入项目名称"
          >
        </div>
        
        <div>
          <label for="quantity" class="block text-sm font-semibold text-gray-700 mb-2">
            数量
          </label>
          <input 
            type="number" 
            id="quantity" 
            value={initialValues.quantity || 1}
            min="1"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300"
            placeholder="1"
          >
        </div>
      </div>
    </div>

    <!-- 尺寸信息 -->
    <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-2xl p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
        📏 零件尺寸 (mm)
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="length" class="block text-sm font-semibold text-gray-700 mb-2">
            长度 (L)
          </label>
          <input 
            type="number" 
            id="length" 
            value={initialValues.length || 100}
            step="0.1"
            min="0.1"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-300"
            placeholder="100"
          >
        </div>
        
        <div>
          <label for="width" class="block text-sm font-semibold text-gray-700 mb-2">
            宽度 (W)
          </label>
          <input 
            type="number" 
            id="width" 
            value={initialValues.width || 50}
            step="0.1"
            min="0.1"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-300"
            placeholder="50"
          >
        </div>
        
        <div>
          <label for="thickness" class="block text-sm font-semibold text-gray-700 mb-2">
            厚度 (T)
          </label>
          <input 
            type="number" 
            id="thickness" 
            value={initialValues.thickness || 10}
            step="0.1"
            min="0.1"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-300"
            placeholder="10"
          >
        </div>
      </div>
    </div>

    <!-- 材料选择 -->
    <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
        🔧 材料规格
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="material-type" class="block text-sm font-semibold text-gray-700 mb-2">
            材料类型
          </label>
          <select 
            id="material-type"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300"
          >
            <option value="aluminum">铝合金</option>
            <option value="steel">不锈钢</option>
            <option value="titanium">钛合金</option>
            <option value="brass">黄铜</option>
            <option value="plastic">工程塑料</option>
          </select>
        </div>
        
        <div>
          <label for="material-grade" class="block text-sm font-semibold text-gray-700 mb-2">
            牌号规格
          </label>
          <select 
            id="material-grade"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300"
          >
            <option value="6061-t6">6061-T6</option>
            <option value="7075-t6">7075-T6</option>
            <option value="2024-t3">2024-T3</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 加工要求 -->
    <div class="bg-gradient-to-r from-orange-50 to-red-50 rounded-2xl p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
        ⚙️ 加工要求
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="tolerance-level" class="block text-sm font-semibold text-gray-700 mb-2">
            公差等级
          </label>
          <select 
            id="tolerance-level"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300"
          >
            <option value="standard">Standard (General tolerance requirements)</option>
            <option value="high">Precision (Project-customized precision)</option>
            <option value="ultra">Ultra-precision (Strict tolerance standards)</option>
            <option value="extreme">Extreme (Maximum precision standards)</option>
          </select>
        </div>
        
        <div>
          <label for="complexity" class="block text-sm font-semibold text-gray-700 mb-2">
            复杂程度
          </label>
          <select 
            id="complexity"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300"
          >
            <option value="simple">简单 (基础几何)</option>
            <option value="medium">中等 (多特征)</option>
            <option value="complex">复杂 (精密特征)</option>
            <option value="very-complex">极复杂 (超精密)</option>
          </select>
        </div>
        
        <div>
          <label for="surface-finish" class="block text-sm font-semibold text-gray-700 mb-2">
            表面处理
          </label>
          <select 
            id="surface-finish"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300"
          >
            <option value="none">无需处理</option>
            <option value="anodizing">阳极氧化</option>
            <option value="powder-coating">喷粉涂装</option>
            <option value="plating">电镀处理</option>
            <option value="polishing">抛光处理</option>
          </select>
        </div>
        
        <div>
          <label for="delivery-time" class="block text-sm font-semibold text-gray-700 mb-2">
            交付要求
          </label>
          <select 
            id="delivery-time"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300"
          >
            <option value="standard">标准交付 (7-10天)</option>
            <option value="fast">快速交付 (3-5天)</option>
            <option value="express">加急交付 (1-2天)</option>
            <option value="immediate">极速交付 (工作时间)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 质量认证 -->
    <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
        📜 质量认证
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <label class="flex items-center space-x-3 p-3 border border-gray-200 rounded-lg hover:bg-indigo-50 transition-colors cursor-pointer">
          <input type="checkbox" id="iso9001" class="form-checkbox text-indigo-600">
          <span class="text-sm font-medium text-gray-700">ISO 9001 质量管理</span>
        </label>
        
        <label class="flex items-center space-x-3 p-3 border border-gray-200 rounded-lg hover:bg-indigo-50 transition-colors cursor-pointer">
          <input type="checkbox" id="as9100" class="form-checkbox text-indigo-600">
          <span class="text-sm font-medium text-gray-700">AS 9100 航空航天</span>
        </label>
        
        <label class="flex items-center space-x-3 p-3 border border-gray-200 rounded-lg hover:bg-indigo-50 transition-colors cursor-pointer">
          <input type="checkbox" id="quality_certifications" class="form-checkbox text-indigo-600">
          <span class="text-sm font-medium text-gray-700">quality certifications 医疗器械</span>
        </label>
      </div>
    </div>

    <!-- 计算按钮 -->
    <div class="flex justify-center">
      <button 
        type="button" 
        id="calculate-cost"
        class="px-12 py-4 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-bold rounded-2xl hover:from-purple-700 hover:to-blue-700 transform hover:scale-105 transition-all duration-300 shadow-2xl"
      >
        🧮 智能成本分析
      </button>
    </div>
  </form>

  <!-- 计算结果显示区域 -->
  <div id="calculation-results" class="hidden mt-8">
    <!-- 结果内容将通过JavaScript动态生成 -->
  </div>

  <!-- 错误提示 -->
  <div id="error-message" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
    <div class="flex items-center">
      <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <span id="error-text" class="text-red-700 font-medium"></span>
    </div>
  </div>
</div>

<script type="module" is:inline>
  import initCostCalculatorWidget from "../../scripts/cost-calculator"

  initCostCalculatorWidget()
</script>

<style>
  .cost-calculator-container {
    max-width: 100%;
  }
  
  /* 自定义滚动条样式 */
  .cost-calculator-container::-webkit-scrollbar {
    width: 8px;
  }
  
  .cost-calculator-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }
  
  .cost-calculator-container::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #7c3aed, #3b82f6);
    border-radius: 10px;
  }
  
  .cost-calculator-container::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #6d28d9, #2563eb);
  }

  /* 表单聚焦样式增强 */
  .cost-calculator-container input:focus,
  .cost-calculator-container select:focus {
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
  }

  /* 结果动画 */
  #calculation-results {
    animation: fadeInUp 0.5s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
