---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout 
  title="Customer Success Stories | Manufacturing Case Studies | CNC Examples | Geppetto"
  description="Real customer success stories: 85% cost reduction, 98% satisfaction rate. Discover how 100+ companies achieved manufacturing breakthroughs with Geppetto's flexible factory solutions."
  keywords={['manufacturing case studies', 'customer success stories', 'CNC success examples', 'precision manufacturing results', 'flexible manufacturing case studies', 'cost reduction examples', 'manufacturing testimonials', 'robotics manufacturing examples', 'electronics manufacturing success', 'startup manufacturing stories', 'rapid prototyping case studies', 'manufacturing innovation examples']}
  ogImage="/images/og-case-studies.jpg"
  structuredData={{
    type: 'webpage',
    data: {
      '@type': 'CollectionPage',
      'name': 'Customer Success Stories',
      'description': 'Real customer success stories and case studies showcasing precision manufacturing results and cost savings.',
      'provider': {
        '@type': 'Organization',
        'name': 'Geppetto Technologies'
      },
      'mainEntity': {
        '@type': 'ItemList',
        'name': 'Manufacturing Success Stories',
        'numberOfItems': 3
      }
    }
  }}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-purple-600 to-blue-500 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">
        Customer Success Stories
      </h1>
      <p class="text-xl md:text-2xl max-w-3xl mx-auto opacity-90">
        Real projects, real results, real customers who trust Geppetto for precision manufacturing
      </p>
    </div>
  </section>

  <!-- Success Metrics Overview -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Proven Results Across Industries
        </h2>
        <p class="text-xl text-gray-600">
          Real metrics from 100+ successful manufacturing partnerships
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
        <div class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-2xl p-6">
          <div class="text-4xl font-bold text-purple-600 mb-2">100+</div>
          <div class="text-gray-700 font-medium">Companies Served</div>
          <div class="text-sm text-gray-500 mt-1">Across 15 industries</div>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-2xl p-6">
          <div class="text-4xl font-bold text-green-600 mb-2">85%</div>
          <div class="text-gray-700 font-medium">Average Cost Reduction</div>
          <div class="text-sm text-gray-500 mt-1">vs traditional suppliers</div>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl p-6">
          <div class="text-4xl font-bold text-blue-600 mb-2">24h</div>
          <div class="text-gray-700 font-medium">Average Delivery</div>
          <div class="text-sm text-gray-500 mt-1">vs 2-3 weeks traditional</div>
        </div>
        <div class="bg-gradient-to-br from-orange-50 to-yellow-50 rounded-2xl p-6">
          <div class="text-4xl font-bold text-orange-600 mb-2">98%</div>
          <div class="text-gray-700 font-medium">Customer Satisfaction</div>
          <div class="text-sm text-gray-500 mt-1">Would recommend us</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          🌟 Featured Success Stories
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          How our flexible manufacturing transformed their business outcomes
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Humanoid Robotics Case Study -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="h-48 bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
            <span class="text-white text-6xl">🤖</span>
          </div>
          <div class="p-6">
            <div class="flex items-center mb-3">
              <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">Robotics</span>
              <span class="text-gray-500 text-sm ml-2">• 48h delivery</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Humanoid Robotics Startup
            </h3>
            <p class="text-gray-600 mb-4">
              Advanced joint components for next-gen robots requiring project-specific precision with rapid prototyping support.
            </p>
            <div class="space-y-2 text-sm text-gray-600 mb-4">
              <div><strong>Challenge:</strong> Complex geometries, 10 iterations needed</div>
              <div><strong>Solution:</strong> Single-piece production capability</div>
              <div><strong>Precision:</strong> project-specific achieved</div>
              <div><strong>Cost Reduction:</strong> 70% vs traditional</div>
            </div>
            <div class="bg-green-50 p-3 rounded-lg mb-4">
              <div class="text-green-800 font-medium text-sm">Result:</div>
              <div class="text-green-700 text-sm">Saved 6 months development time, enabled rapid R&D iterations</div>
            </div>
            <a href="#robotics-details" class="text-purple-600 hover:text-purple-800 font-medium text-sm">
              Read Full Case Study →
            </a>
          </div>
        </div>

        <!-- Electronics Startup Case Study -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="h-48 bg-gradient-to-br from-green-500 to-blue-600 flex items-center justify-center">
            <span class="text-white text-6xl">⚡</span>
          </div>
          <div class="p-6">
            <div class="flex items-center mb-3">
              <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded">Electronics</span>
              <span class="text-gray-500 text-sm ml-2">• Transparent pricing</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              IoT Electronics Startup
            </h3>
            <p class="text-gray-600 mb-4">
              Custom heat sinks with transparent pricing vs traditional suppliers' confusing quotes.
            </p>
            <div class="space-y-2 text-sm text-gray-600 mb-4">
              <div><strong>Challenge:</strong> Traditional quote $15,500 vs SolidWorks $180</div>
              <div><strong>Our Quote:</strong> $5,750 with detailed breakdown</div>
              <div><strong>Final Cost:</strong> $5,680 (under quote by $70)</div>
              <div><strong>Savings:</strong> $9,820 (63% cost reduction)</div>
            </div>
            <div class="bg-green-50 p-3 rounded-lg mb-4">
              <div class="text-green-800 font-medium text-sm">Result:</div>
              <div class="text-green-700 text-sm">Complete transparency, enabled extra prototype iteration</div>
            </div>
            <a href="#electronics-details" class="text-purple-600 hover:text-purple-800 font-medium text-sm">
              Read Full Case Study →
            </a>
          </div>
        </div>

        <!-- Medical Device Case Study -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="h-48 bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center">
            <span class="text-white text-6xl">🏥</span>
          </div>
          <div class="p-6">
            <div class="flex items-center mb-3">
              <span class="bg-purple-100 text-purple-800 text-xs font-semibold px-2.5 py-0.5 rounded">Medical</span>
              <span class="text-gray-500 text-sm ml-2">• Expert guidance</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Medical Device Startup
            </h3>
            <p class="text-gray-600 mb-4">
              Surgical instrument prototypes with medical-grade titanium and expert DFM guidance.
            </p>
            <div class="space-y-2 text-sm text-gray-600 mb-4">
              <div><strong>Material:</strong> Ti-6Al-4V Medical Grade</div>
              <div><strong>Precision:</strong> project-specific for surgical applications</div>
              <div><strong>Guidance:</strong> Free DFM consultation included</div>
              <div><strong>Savings:</strong> $50K development costs, 3 months time</div>
            </div>
            <div class="bg-green-50 p-3 rounded-lg mb-4">
              <div class="text-green-800 font-medium text-sm">Result:</div>
              <div class="text-green-700 text-sm">Design optimization before production, FDA compliance support</div>
            </div>
            <a href="#medical-details" class="text-purple-600 hover:text-purple-800 font-medium text-sm">
              Read Full Case Study →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Case Studies -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Detailed Success Analysis -->
      <div class="mb-16">
        <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">📊 Detailed Success Analysis</h3>
        
        <!-- Robotics Case Analysis -->
        <div id="robotics-details" class="mb-12">
          <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-3xl p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-4">🤖 Humanoid Robotics Challenge</h4>
                <div class="space-y-4 text-gray-700">
                  <p>
                    <strong>Customer:</strong> Next-generation robotics startup<br>
                    <strong>Challenge:</strong> Complex joint geometries requiring project-specific precision with rapid prototyping needs (5-10 iterations).
                  </p>
                  <p>
                    <strong>Traditional Barrier:</strong> Suppliers demanded 100+ piece MOQ with 3-week lead times, killing innovation momentum.
                  </p>
                  <p>
                    <strong>Our Solution:</strong> Digital twin simulation enabled single-piece production with 48-hour delivery cycles.
                  </p>
                </div>
              </div>
              <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h5 class="font-bold text-gray-900 mb-4">Impact Metrics</h5>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span>Precision Achieved:</span>
                    <span class="font-medium text-blue-600">project-specific</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Development Time Saved:</span>
                    <span class="font-medium text-green-600">6 months</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Cost Reduction:</span>
                    <span class="font-medium text-purple-600">70%</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Prototype Iterations:</span>
                    <span class="font-medium text-orange-600">10 successful</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Electronics Case Analysis -->
        <div id="electronics-details" class="mb-12">
          <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-3xl p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-4">⚡ Electronics Pricing Crisis</h4>
                <div class="space-y-4 text-gray-700">
                  <p>
                    <strong>Customer:</strong> IoT hardware startup<br>
                    <strong>Problem:</strong> SolidWorks estimated $180 per part, traditional supplier quoted $15,500 total (86x difference!).
                  </p>
                  <p>
                    <strong>Hidden Costs:</strong> Setup fees, tooling charges, rush fees, and "miscellaneous" costs with no transparency.
                  </p>
                  <p>
                    <strong>Our Solution:</strong> Complete cost breakdown with digital twin pricing analysis and zero hidden fees guarantee.
                  </p>
                </div>
              </div>
              <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h5 class="font-bold text-gray-900 mb-4">Cost Transparency</h5>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between border-b pb-1">
                    <span>Traditional Quote:</span>
                    <span class="text-red-600 font-medium">$15,500</span>
                  </div>
                  <div class="flex justify-between border-b pb-1">
                    <span>Our Transparent Quote:</span>
                    <span class="text-green-600 font-medium">$5,750</span>
                  </div>
                  <div class="flex justify-between border-b pb-1">
                    <span>Final Actual Cost:</span>
                    <span class="text-green-600 font-medium">$5,680</span>
                  </div>
                  <div class="flex justify-between font-bold pt-2">
                    <span>Total Savings:</span>
                    <span class="text-green-600">$9,820 (63%)</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Medical Case Analysis -->
        <div id="medical-details">
          <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-4">🏥 Medical Device Excellence</h4>
                <div class="space-y-4 text-gray-700">
                  <p>
                    <strong>Customer:</strong> Medical device startup<br>
                    <strong>Requirements:</strong> Medical-grade titanium, project-specific precision, FDA compliance documentation.
                  </p>
                  <p>
                    <strong>Value Add:</strong> Free DFM consultation optimized design before production, preventing costly iterations.
                  </p>
                  <p>
                    <strong>Expert Guidance:</strong> Material selection, FDA compliance preparation, and quality documentation support.
                  </p>
                </div>
              </div>
              <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h5 class="font-bold text-gray-900 mb-4">Development Impact</h5>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span>Development Savings:</span>
                    <span class="font-medium text-green-600">$50K</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Time to Market:</span>
                    <span class="font-medium text-blue-600">3 months faster</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Precision Achieved:</span>
                    <span class="font-medium text-purple-600">project-specific</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Material Grade:</span>
                    <span class="font-medium text-orange-600">Ti-6Al-4V</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Customer Testimonials -->
      <div class="bg-gradient-to-br from-gray-50 to-blue-50 p-8 rounded-3xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">💬 What Our Customers Say</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                <span class="text-lg">🚀</span>
              </div>
              <div>
                <div class="font-bold text-gray-900">Sarah Chen, CTO</div>
                <div class="text-sm text-gray-600">AI Robotics Startup</div>
              </div>
            </div>
            <p class="text-gray-700 italic mb-4">
              "Geppetto's flexible factory approach saved us 6 months and $200K in development costs. 
              They understood our startup constraints and delivered exactly what we needed."
            </p>
            <div class="text-xs text-gray-500">
              Industry: Robotics • Order: 12 precision components • Savings: $200K
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mr-3">
                <span class="text-lg">⚡</span>
              </div>
              <div>
                <div class="font-bold text-gray-900">Engineering Manager</div>
                <div class="text-sm text-gray-600">Robotics Company</div>
              </div>
            </div>
            <p class="text-gray-700 italic mb-4">
              "We were amazed by Geppetto's quote - they exceeded our precision requirements when we only needed standard tolerances, 
              and the price was 60% lower than our previous supplier."
            </p>
            <div class="text-xs text-gray-500">
              Industry: Robotics • Precision: Project-specific • Savings: 60%
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mr-3">
                <span class="text-lg">🏥</span>
              </div>
              <div>
                <div class="font-bold text-gray-900">Dr. Sarah Kim</div>
                <div class="text-sm text-gray-600">Medical Device Startup</div>
              </div>
            </div>
            <p class="text-gray-700 italic mb-4">
              "The expert guidance helped optimize our design before production. 
              This saved us $50K in development costs and 3 months of iteration time."
            </p>
            <div class="text-xs text-gray-500">
              Industry: Medical Devices • Material: Ti-6Al-4V • Savings: $50K, 3 months
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-3">
                <span class="text-lg">💎</span>
              </div>
              <div>
                <div class="font-bold text-gray-900">Mike Chen</div>
                <div class="text-sm text-gray-600">Hardware Startup</div>
              </div>
            </div>
            <p class="text-gray-700 italic mb-4">
              "For the first time, I understood exactly what I was paying for. 
              The transparency and savings let us fund another prototype iteration."
            </p>
            <div class="text-xs text-gray-500">
              Industry: Electronics • Transparency: 100% • Cost Reduction: 63%
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-blue-600 to-purple-700 text-white">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">
        Ready to Join Our Success Stories?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Experience the same breakthrough results with our flexible manufacturing approach
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/en/create-quote" 
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors duration-200 shadow-lg"
        >
          🚀 Start Your Success Story
        </a>
        <a 
          href="/en/contact" 
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-purple-600 transition-colors duration-200"
        >
          💬 Discuss Your Project
        </a>
      </div>
      
      <div class="mt-8 text-purple-100 text-sm">
        🏆 Join 100+ Successful Companies • 💫 Risk-Free Trial • 📊 Transparent Pricing
      </div>
    </div>
  </section>
</BaseLayout>