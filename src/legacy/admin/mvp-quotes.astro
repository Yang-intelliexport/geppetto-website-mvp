---
import BaseLayout from '../../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;
const adminDisabledMessage = 'MVP quote management is available in development environments only.';
---

<BaseLayout 
  title="MVP报价管理 - 管理后台 | Geppetto智能制造"
  description="MVP版本报价管理系统，处理客户报价申请，跟踪状态，管理订单流程"
>
  {isDev ? (
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">MVP报价管理</h1>
            <p class="text-gray-600">手动驱动型报价系统管理后台</p>
          </div>
          <div class="flex items-center space-x-4">
            <button onclick="refreshQuotes()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
刷新数据
            </button>
            <button onclick="exportData()" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
导出数据
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Statistics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-sm p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 2L3 7v11a1 1 0 001 1h3v-8h6v8h3a1 1 0 001-1V7l-7-5z"></path>
                </svg>
              </div>
            </div>
            <div class="ml-5">
              <p class="text-sm font-medium text-gray-500">待处理</p>
              <p class="text-2xl font-semibold text-gray-900" id="pending-count">-</p>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-lg shadow-sm p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
            <div class="ml-5">
              <p class="text-sm font-medium text-gray-500">审核中</p>
              <p class="text-2xl font-semibold text-gray-900" id="reviewing-count">-</p>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-lg shadow-sm p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
            </div>
            <div class="ml-5">
              <p class="text-sm font-medium text-gray-500">已报价</p>
              <p class="text-2xl font-semibold text-gray-900" id="quoted-count">-</p>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-lg shadow-sm p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                </svg>
              </div>
            </div>
            <div class="ml-5">
              <p class="text-sm font-medium text-gray-500">今日新增</p>
              <p class="text-2xl font-semibold text-gray-900" id="today-count">-</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters and Search -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
        <div class="flex flex-wrap gap-4 items-center">
          <div>
            <select id="status-filter" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="">全部状态</option>
              <option value="pending">待处理</option>
              <option value="reviewing">审核中</option>
              <option value="quoted">已报价</option>
              <option value="ordered">已下单</option>
              <option value="archived">已归档</option>
            </select>
          </div>
          
          <div>
            <select id="priority-filter" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="">全部优先级</option>
              <option value="5">紧急</option>
              <option value="4">高</option>
              <option value="3">中等</option>
              <option value="2">正常</option>
              <option value="1">低</option>
            </select>
          </div>
          
          <div>
            <select id="material-filter" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="">全部材料</option>
              <option value="aluminum-6061">6061铝合金</option>
              <option value="aluminum-7075">7075铝合金</option>
              <option value="stainless-304">304不锈钢</option>
              <option value="stainless-316">316不锈钢</option>
              <option value="brass">黄铜</option>
              <option value="copper">紫铜</option>
              <option value="titanium">钛合金</option>
            </select>
          </div>
          
          <div class="flex-1 min-w-64">
            <input 
              type="text" 
              id="search-input"
              placeholder="搜索客户邮箱或公司名称..." 
              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            >
          </div>
          
          <button onclick="applyFilters()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            🔍 搜索
          </button>
          
          <button onclick="resetFilters()" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600">
            🔄 重置
          </button>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
        <p class="text-gray-600 mt-2">加载中...</p>
      </div>

      <!-- Quotes Table -->
      <div id="quotes-container" class="bg-white rounded-lg shadow-sm overflow-hidden hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  客户信息
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  产品规格
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  状态/优先级
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  提交时间
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  报价信息
                </th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                  操作
                </th>
              </tr>
            </thead>
            <tbody id="quotes-list" class="bg-white divide-y divide-gray-200">
              <!-- 动态加载内容 -->
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
          <div class="flex-1 flex justify-between sm:hidden">
            <button onclick="previousPage()" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              上一页
            </button>
            <button onclick="nextPage()" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              下一页
            </button>
          </div>
          <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-gray-700">
                显示第 <span id="page-start" class="font-medium">1</span> 到 <span id="page-end" class="font-medium">10</span> 条，
                共 <span id="total-count" class="font-medium">0</span> 条记录
              </p>
            </div>
            <div>
              <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" id="pagination-controls">
                <!-- 动态生成分页控件 -->
              </nav>
            </div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="bg-white rounded-lg shadow-sm p-12 text-center hidden">
        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
          <path d="M34 40h10v-4a6 6 0 00-10.712-3.714M34 40H14m20 0v-4a9.971 9.971 0 00-.712-3.714M14 40H4v-4a6 6 0 0110.713-3.714M14 40v-4c0-1.313.253-2.566.713-3.714m0 0A9.971 9.971 0 0124 24c4.004 0 7.625 2.349 9.287 6m-9.287-6c-4.004 0-7.625 2.349-9.287 6m0 0A9.971 9.971 0 0014 32.286" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无报价数据</h3>
        <p class="mt-1 text-sm text-gray-500">当客户提交报价申请时，数据将显示在这里。</p>
      </div>
    </div>
  </div>

  <!-- Quote Detail Modal -->
  <div id="quote-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 hidden">
    <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-4xl shadow-lg rounded-md bg-white">
      <div class="mt-3" id="modal-content">
        <!-- 动态加载内容 -->
      </div>
    </div>
  </div>

  <script>
    // Global variables
    let currentPage = 1;
    let pageSize = 10;
    let totalQuotes = 0;
    let allQuotes = [];
    let filteredQuotes = [];

    // Initialize page
    document.addEventListener('DOMContentLoaded', function() {
      loadQuotes();
      setupEventListeners();
    });

    function setupEventListeners() {
      // Filter change events
      ['status-filter', 'priority-filter', 'material-filter'].forEach(id => {
        document.getElementById(id).addEventListener('change', applyFilters);
      });

      // Search input
      document.getElementById('search-input').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          applyFilters();
        }
      });

      // Modal close
      document.getElementById('quote-modal').addEventListener('click', function(e) {
        if (e.target === this) {
          closeModal();
        }
      });
    }

    // Load quotes data (Mock implementation)
    async function loadQuotes() {
      try {
        showLoading(true);
        
        // TODO: 实际从Supabase加载数据
        // const response = await fetch('/api/admin/get-quotes');
        // const data = await response.json();
        
        // Mock数据用于演示
        const mockQuotes = generateMockQuotes();
        allQuotes = mockQuotes;
        filteredQuotes = [...allQuotes];
        
        updateStatistics();
        renderQuotes();
        showLoading(false);
        
      } catch (error) {
        console.error('Failed to load quotes:', error);
        showLoading(false);
        showEmptyState();
      }
    }

    function showLoading(show) {
      document.getElementById('loading-state').classList.toggle('hidden', !show);
      document.getElementById('quotes-container').classList.toggle('hidden', show);
      document.getElementById('empty-state').classList.add('hidden');
    }

    function showEmptyState() {
      document.getElementById('loading-state').classList.add('hidden');
      document.getElementById('quotes-container').classList.add('hidden');
      document.getElementById('empty-state').classList.remove('hidden');
    }

    function updateStatistics() {
      const stats = {
        pending: filteredQuotes.filter(q => q.status === 'pending').length,
        reviewing: filteredQuotes.filter(q => q.status === 'reviewing').length,
        quoted: filteredQuotes.filter(q => q.status === 'quoted').length,
        today: filteredQuotes.filter(q => isToday(new Date(q.created_at))).length
      };

      document.getElementById('pending-count').textContent = stats.pending;
      document.getElementById('reviewing-count').textContent = stats.reviewing;
      document.getElementById('quoted-count').textContent = stats.quoted;
      document.getElementById('today-count').textContent = stats.today;
    }

    function isToday(date) {
      const today = new Date();
      return date.toDateString() === today.toDateString();
    }

    function renderQuotes() {
      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = startIndex + pageSize;
      const pageQuotes = filteredQuotes.slice(startIndex, endIndex);

      const tbody = document.getElementById('quotes-list');
      tbody.innerHTML = '';

      if (pageQuotes.length === 0) {
        showEmptyState();
        return;
      }

      document.getElementById('quotes-container').classList.remove('hidden');

      pageQuotes.forEach(quote => {
        const row = createQuoteRow(quote);
        tbody.appendChild(row);
      });

      updatePagination();
    }

    function createQuoteRow(quote) {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-gray-50';

      tr.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-medium text-gray-900">${quote.customer_email}</div>
          ${quote.customer_name ? `<div class="text-sm text-gray-500">${quote.customer_name}</div>` : ''}
          ${quote.company_name ? `<div class="text-sm text-gray-500">${quote.company_name}</div>` : ''}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm text-gray-900">${getMaterialLabel(quote.material)}</div>
          <div class="text-sm text-gray-500">数量: ${quote.quantity} 件</div>
          ${quote.file_size ? `<div class="text-sm text-gray-500">文件: ${formatFileSize(quote.file_size)}</div>` : ''}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          ${getStatusBadge(quote.status)}
          ${getPriorityBadge(quote.priority_level)}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
          ${formatDateTime(quote.created_at)}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          ${quote.quote_total ? 
            `<div class="text-sm font-medium text-gray-900">$${quote.quote_total}</div>` : 
            `<div class="text-sm text-gray-500">待报价</div>`
          }
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <button onclick="viewQuote('${quote.id}')" class="text-blue-600 hover:text-blue-900 mr-2">查看</button>
          <button onclick="editQuote('${quote.id}')" class="text-green-600 hover:text-green-900 mr-2">编辑</button>
          <button onclick="downloadFile('${quote.original_file_url}')" class="text-purple-600 hover:text-purple-900">下载</button>
        </td>
      `;

      return tr;
    }

    // Utility functions
    function getMaterialLabel(material) {
      const labels = {
        'aluminum-6061': '6061铝合金',
        'aluminum-7075': '7075铝合金',
        'stainless-304': '304不锈钢',
        'stainless-316': '316不锈钢',
        'brass': '黄铜',
        'copper': '紫铜',
        'titanium': '钛合金'
      };
      return labels[material] || material;
    }

    function getStatusBadge(status) {
      const badges = {
        'pending': '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">待处理</span>',
        'reviewing': '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">审核中</span>',
        'quoted': '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">已报价</span>',
        'ordered': '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">已下单</span>',
        'archived': '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">已归档</span>'
      };
      return badges[status] || '';
    }

    function getPriorityBadge(priority) {
      const badges = {
        5: '<span class="ml-1 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">紧急</span>',
        4: '<span class="ml-1 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">高</span>',
        3: '<span class="ml-1 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">中等</span>',
        2: '',
        1: ''
      };
      return badges[priority] || '';
    }

    function formatDateTime(dateString) {
      const date = new Date(dateString);
      return date.toLocaleString('zh-CN');
    }

    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Filter and search functions
    function applyFilters() {
      const statusFilter = document.getElementById('status-filter').value;
      const priorityFilter = document.getElementById('priority-filter').value;
      const materialFilter = document.getElementById('material-filter').value;
      const searchQuery = document.getElementById('search-input').value.toLowerCase();

      filteredQuotes = allQuotes.filter(quote => {
        const matchesStatus = !statusFilter || quote.status === statusFilter;
        const matchesPriority = !priorityFilter || quote.priority_level == priorityFilter;
        const matchesMaterial = !materialFilter || quote.material === materialFilter;
        const matchesSearch = !searchQuery || 
          quote.customer_email.toLowerCase().includes(searchQuery) ||
          (quote.customer_name && quote.customer_name.toLowerCase().includes(searchQuery)) ||
          (quote.company_name && quote.company_name.toLowerCase().includes(searchQuery));

        return matchesStatus && matchesPriority && matchesMaterial && matchesSearch;
      });

      currentPage = 1;
      updateStatistics();
      renderQuotes();
    }

    function resetFilters() {
      document.getElementById('status-filter').value = '';
      document.getElementById('priority-filter').value = '';
      document.getElementById('material-filter').value = '';
      document.getElementById('search-input').value = '';
      
      filteredQuotes = [...allQuotes];
      currentPage = 1;
      updateStatistics();
      renderQuotes();
    }

    // Pagination functions
    function updatePagination() {
      const totalPages = Math.ceil(filteredQuotes.length / pageSize);
      const startItem = (currentPage - 1) * pageSize + 1;
      const endItem = Math.min(currentPage * pageSize, filteredQuotes.length);

      document.getElementById('page-start').textContent = startItem;
      document.getElementById('page-end').textContent = endItem;
      document.getElementById('total-count').textContent = filteredQuotes.length;

      // Generate pagination controls (simplified)
      const paginationControls = document.getElementById('pagination-controls');
      paginationControls.innerHTML = '';

      for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
        const button = document.createElement('button');
        button.className = i === currentPage 
          ? 'z-10 bg-blue-50 border-blue-500 text-blue-600 relative inline-flex items-center px-4 py-2 border text-sm font-medium'
          : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium';
        button.textContent = i;
        button.onclick = () => goToPage(i);
        paginationControls.appendChild(button);
      }
    }

    function goToPage(page) {
      currentPage = page;
      renderQuotes();
    }

    function previousPage() {
      if (currentPage > 1) {
        currentPage--;
        renderQuotes();
      }
    }

    function nextPage() {
      const totalPages = Math.ceil(filteredQuotes.length / pageSize);
      if (currentPage < totalPages) {
        currentPage++;
        renderQuotes();
      }
    }

    // Action functions
    function viewQuote(quoteId) {
      const quote = allQuotes.find(q => q.id === quoteId);
      if (quote) {
        showQuoteModal(quote);
      }
    }

    function editQuote(quoteId) {
      // TODO: 实现编辑功能
      alert(`编辑报价 ${quoteId}`);
    }

    function downloadFile(fileUrl) {
      window.open(fileUrl, '_blank');
    }

    function showQuoteModal(quote) {
      const modal = document.getElementById('quote-modal');
      const content = document.getElementById('modal-content');
      
      content.innerHTML = `
        <div class="flex justify-between items-start mb-4">
          <h3 class="text-lg font-medium text-gray-900">报价详情 #${quote.id.substring(0, 8)}</h3>
          <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-medium text-gray-900 mb-3">客户信息</h4>
            <div class="space-y-2 text-sm">
              <div><strong>邮箱:</strong> ${quote.customer_email}</div>
              ${quote.customer_name ? `<div><strong>姓名:</strong> ${quote.customer_name}</div>` : ''}
              ${quote.company_name ? `<div><strong>公司:</strong> ${quote.company_name}</div>` : ''}
              ${quote.phone ? `<div><strong>电话:</strong> ${quote.phone}</div>` : ''}
            </div>
          </div>
          <div>
            <h4 class="font-medium text-gray-900 mb-3">产品信息</h4>
            <div class="space-y-2 text-sm">
              <div><strong>材料:</strong> ${getMaterialLabel(quote.material)}</div>
              <div><strong>数量:</strong> ${quote.quantity} 件</div>
              <div><strong>文件:</strong> <a href="${quote.original_file_url}" target="_blank" class="text-blue-600 hover:text-blue-800">下载CAD文件</a></div>
            </div>
          </div>
        </div>
        ${quote.customer_notes ? `
          <div class="mt-6">
            <h4 class="font-medium text-gray-900 mb-3">特殊要求</h4>
            <div class="bg-gray-50 p-3 rounded text-sm">${quote.customer_notes}</div>
          </div>
        ` : ''}
        <div class="mt-6 flex justify-end space-x-3">
          <button onclick="closeModal()" class="bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400">
            关闭
          </button>
          <button onclick="editQuote('${quote.id}')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            编辑报价
          </button>
        </div>
      `;
      
      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('quote-modal').classList.add('hidden');
    }

    // Other functions
    function refreshQuotes() {
      loadQuotes();
    }

    function exportData() {
      // TODO: 实现数据导出
      alert('导出功能开发中...');
    }

    // Generate mock data for demonstration
    function generateMockQuotes() {
      const materials = ['aluminum-6061', 'aluminum-7075', 'stainless-304', 'stainless-316', 'brass', 'copper', 'titanium'];
      const statuses = ['pending', 'reviewing', 'quoted', 'ordered', 'archived'];
      const mockQuotes = [];

      for (let i = 0; i < 25; i++) {
        const createdDate = new Date();
        createdDate.setDate(createdDate.getDate() - Math.floor(Math.random() * 30));
        
        mockQuotes.push({
          id: `mock-quote-${i + 1}`,
          customer_email: `customer${i + 1}@example.com`,
          customer_name: Math.random() > 0.5 ? `客户${i + 1}` : null,
          company_name: Math.random() > 0.7 ? `公司${i + 1}` : null,
          phone: Math.random() > 0.6 ? `138${String(Math.floor(Math.random() * 100000000)).padStart(8, '0')}` : null,
          material: materials[Math.floor(Math.random() * materials.length)],
          quantity: Math.floor(Math.random() * 100) + 1,
          customer_notes: Math.random() > 0.7 ? '这是一些特殊要求的示例文本' : null,
          status: statuses[Math.floor(Math.random() * statuses.length)],
          priority_level: Math.floor(Math.random() * 5) + 1,
          file_size: Math.floor(Math.random() * 10000000) + 1000000,
          original_file_url: '#',
          quote_total: Math.random() > 0.6 ? Math.floor(Math.random() * 5000) + 500 : null,
          created_at: createdDate.toISOString()
        });
      }

      return mockQuotes.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
    }
  </script>
  ) : (
  <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <p class="text-gray-500 text-center text-lg">{adminDisabledMessage}</p>
  </div>
  )}
</BaseLayout>
