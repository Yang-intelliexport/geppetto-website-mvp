---
import '../styles/global.css'
import '../styles/mobile.css'
import LanguageSwitcher from '../components/ui/LanguageSwitcher.astro'
import UserMenu from '../components/ui/UserMenu.tsx'
import StructuredData from '../components/seo/StructuredData.astro'
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro'
import CookieConsent from '../components/analytics/CookieConsent.astro'
import GlobalModal from '../components/modals/GlobalModal.astro'
import GlobalToast from '../components/modals/GlobalToast.astro'
import AuthManager from '../components/AuthManager.tsx'
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import { t, type Language } from '../utils/i18n'
import { createClient as createServerSupabaseClient } from '../lib/supabase/astro'

type StructuredDataType = 'organization' | 'service' | 'article' | 'faq' | 'product' | 'breadcrumb' | 'webpage' | 'caseStudy' | 'collection';

export interface Props {
  title: string
  description?: string
  keywords?: string[]
  ogImage?: string
  structuredData?: { type: StructuredDataType; data: Record<string, any> }
  canonicalURL?: string
  language?: string
  currentLang?: string
  noIndex?: boolean
}

const currentLang = (Astro.currentLocale ?? 'en') as Language

const { 
  title,
  description,
  keywords = [],
  ogImage = '/images/manufacturing/machining-process-1.jpg',
  structuredData,
  canonicalURL,
  noIndex = false
} = Astro.props

// Set language-specific defaults if not provided
const defaultTitle = currentLang === 'zh' 
  ? 'Geppetto - 透明制造 · 8小时专家报价'
  : 'Geppetto | Transparent Manufacturing & 8-Hour Expert Quotes'

const defaultDescription = currentLang === 'zh'
  ? 'AI预审+专家复核，8小时交付透明报价；标准件72小时生产+运输，零MOQ，服务初创与中小批量团队。'
  : 'AI pre-check plus expert validation deliver detailed quotes in 8 hours, with standard parts produced and shipped within 72 hours and no MOQ for startup teams.'

const finalTitle = title || defaultTitle
const finalDescription = description || defaultDescription
const normalizedPath = Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/'
const relativePath = normalizedPath === '/' ? '' : normalizedPath.replace(/^\/+/, '')
const canonicalHref = canonicalURL ?? getAbsoluteLocaleUrl(currentLang, relativePath)
const alternateEn = getAbsoluteLocaleUrl('en', relativePath)
const alternateZh = getAbsoluteLocaleUrl('zh', relativePath)
const currentPathWithQuery = `${Astro.url.pathname}${Astro.url.search}`

let initialUserEmail: string | null = null
try {
  // 详细调试服务器端认证状态检查
  console.debug('[BaseLayout] 🔍 Checking server-side auth state:', {
    url: Astro.url.toString(),
    cookies: Astro.request.headers.get('cookie') ? 'present' : 'none',
    cookieHeader: Astro.request.headers.get('cookie')?.substring(0, 100) + '...' || 'none',
    timestamp: new Date().toISOString()
  })
  
  const supabaseServerClient = createServerSupabaseClient(Astro)
  const { data, error } = await supabaseServerClient.auth.getSession()
  
  console.debug('[BaseLayout] 📊 Server session check result:', {
    hasSession: !!data.session,
    hasUser: !!data.session?.user,
    userEmail: data.session?.user?.email || 'none',
    userId: data.session?.user?.id || 'none',
    expiresAt: data.session?.expires_at || 'none',
    error: error ? error.message : 'none',
    timestamp: new Date().toISOString()
  })
  
  initialUserEmail = data.session?.user?.email ?? null
} catch (err: any) {
  console.error('❌ [BaseLayout] Failed to fetch session:', {
    error: err?.message,
    stack: err?.stack,
    timestamp: new Date().toISOString()
  })
  initialUserEmail = null
}
---

<!DOCTYPE html>
<html lang={currentLang === 'zh' ? 'zh-CN' : 'en-US'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- SEO Meta Tags -->
  <title>{finalTitle}</title>
  <meta name="description" content={finalDescription} />
  <meta name="keywords" content={keywords.join(', ')} />
  {canonicalHref && <link rel="canonical" href={canonicalHref} />}
  {noIndex && <meta name="robots" content="noindex,nofollow" />}
  
  <!-- Language alternates -->
  <link rel="alternate" hreflang="en" href={alternateEn} />
  <link rel="alternate" hreflang="zh" href={alternateZh} />
  <link rel="alternate" hreflang="x-default" href={alternateEn} />
  
  <!-- Open Graph -->
  <meta property="og:title" content={finalTitle} />
  <meta property="og:description" content={finalDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  {canonicalHref && <meta property="og:url" content={canonicalHref} />}
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={finalTitle} />
  <meta name="twitter:description" content={finalDescription} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Styles import -->
  
  <!-- Preload critical fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Structured Data -->
  {structuredData && (
    <StructuredData type={structuredData.type} data={structuredData.data} />
  )}
  
  <!-- Default Organization Structured Data -->
  {!structuredData && (
    <StructuredData 
      type="organization" 
      data={{}} 
    />
  )}
  
  <script is:inline define:vars={{ initialUserEmail }}>
    if (typeof window !== 'undefined') {
      console.debug('[BaseLayout] initialUserEmail:', initialUserEmail || null);
      
      // Global modalStore implementation
      window.modalStore = {
        showToast: function(message, type = 'info', duration = 3000) {
          console.log(`🍞 Toast: [${type}] ${message}`);
        },
        clearAllToasts: function() {
          console.log('🧹 Clearing all toasts');
        },
        showSuccess: function(title, message, options = {}) {
          alert(`✅ ${title}\n\n${message}`);
          if (options.onConfirm) options.onConfirm();
        },
        showError: function(title, message, options = {}) {
          alert(`❌ ${title}\n\n${message}`);
          if (options.onConfirm) options.onConfirm();
        },
        closeModal: function() {
          console.log('🚪 Modal closed');
        }
      };
    }
  </script>
  
  <!-- Google Analytics -->
  <GoogleAnalytics />
</head>

<body class="font-inter bg-white text-gray-900 antialiased">
  <!-- 全局认证管理器 -->
  <AuthManager client:load />
  
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <!-- Logo -->
        <div class="flex items-center">
          <a href={`/${currentLang}`} class="flex items-center space-x-2">
            <img 
              src="/images/geppetto-logo.png" 
              alt="Geppetto Logo" 
              class="w-8 h-8 object-contain"
              loading="eager"
            />
            <span class="text-xl font-bold text-[#111827]">Geppetto</span>
          </a>
        </div>
        
        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-6">
          <a href={`/${currentLang}/services`} class="text-[#111827] hover:text-[#7F00FF] transition-colors">{t('nav.services', currentLang)}</a>
          <a href={`/${currentLang}/why-geppetto`} class="text-[#111827] hover:text-[#7F00FF] transition-colors">{t('nav.about', currentLang)}</a>
          <a href={`/${currentLang}/track-order`} class="text-[#111827] hover:text-[#7F00FF] transition-colors">{currentLang === 'zh' ? '订单追踪' : 'Track Order'}</a>
          <a href={`/${currentLang}/contact`} class="text-[#111827] hover:text-[#7F00FF] transition-colors">{t('nav.contact', currentLang)}</a>
          <a href={`/${currentLang}/resources`} class="text-[#111827] hover:text-[#7F00FF] transition-colors">{currentLang === 'zh' ? '资源' : 'Resources'}</a>
          <LanguageSwitcher />
          <UserMenu currentLang={currentLang} currentPath={currentPathWithQuery} initialUserEmail={initialUserEmail} client:load />
          <a href={`/${currentLang}/create-quote`} class="bg-[#7F00FF] text-white px-6 py-3 rounded-lg hover:bg-[#6B00CC] transition-colors font-semibold">
            {t('nav.quote', currentLang)}
          </a>
        </div>
        
        <!-- Mobile menu button -->
        <div class="md:hidden flex items-center space-x-2">
          <LanguageSwitcher />
          <UserMenu currentLang={currentLang} currentPath={currentPathWithQuery} client:load />
          <button 
            type="button" 
            class="text-gray-600 hover:text-gray-900 p-2 rounded-lg hover:bg-gray-100 transition-colors" 
            id="mobile-menu-button"
            aria-label="Toggle mobile menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Mobile Navigation -->
      <div class="md:hidden hidden" id="mobile-menu">
        <div class="px-2 pt-2 pb-6 space-y-1 bg-white border-t border-gray-100 shadow-lg">
          <a href={`/${currentLang}/services`} class="block px-4 py-3 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors font-medium">
            {t('nav.services', currentLang)}
          </a>
          <a href={`/${currentLang}/why-geppetto`} class="block px-4 py-3 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors font-medium">
            {t('nav.about', currentLang)}
          </a>
          <a href={`/${currentLang}/track-order`} class="block px-4 py-3 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors font-medium">
            {currentLang === 'zh' ? '订单追踪' : 'Track Order'}
          </a>
          <a href={`/${currentLang}/contact`} class="block px-4 py-3 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors font-medium">
            {t('nav.contact', currentLang)}
          </a>
          <a href={`/${currentLang}/resources`} class="block px-4 py-3 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors font-medium">
            {currentLang === 'zh' ? '资源' : 'Resources'}
          </a>
          <div class="px-4 pt-2">
            <UserMenu currentLang={currentLang} currentPath={currentPathWithQuery} initialUserEmail={initialUserEmail} client:load />
          </div>
          <div class="px-2 pt-4">
            <a href={`/${currentLang}/create-quote`} class="block bg-gradient-to-r from-[#7F00FF] to-[#00BFFF] text-white px-6 py-3 rounded-xl text-center font-semibold text-lg shadow-lg hover:shadow-xl transition-all duration-200">
              {t('nav.quote', currentLang)}
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>
  
  <!-- Main Content -->
  <main>
    <slot />
  </main>
  
  <!-- Footer -->
  <footer class="bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Company Info -->
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center space-x-2 mb-4">
            <img 
              src="/images/geppetto-logo.png" 
              alt="Geppetto Logo" 
              class="w-8 h-8 object-contain"
            />
            <span class="text-xl font-bold">Geppetto</span>
          </div>
          <p class="text-gray-300 mb-4 max-w-md">
            {currentLang === 'zh' ? 
              '奇塑科技 - AI驱动的精密制造服务商。提供专家审核报价、72小时生产+运输、按需定制精度的革命性制造体验。' :
              'Geppetto Tech - AI-powered precision manufacturing service provider. Delivering intelligent quotes, 72H production + shipping, and revolutionary manufacturing experience with custom precision.'
            }
          </p>
          <div class="flex space-x-4">
            <a href="tel:+8613511091304" class="text-[#7F00FF] hover:text-[#00BFFF]">+86 13511091304</a>
            <a href="mailto:hello@geppetto.studio" class="text-[#7F00FF] hover:text-[#00BFFF]">hello@geppetto.studio</a>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div>
          <h3 class="text-lg font-semibold mb-4">{currentLang === 'zh' ? '快速链接' : 'Quick Links'}</h3>
          <ul class="space-y-2">
            <li><a href={`/${currentLang}/why-geppetto`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '为何选择Geppetto' : 'Why Geppetto'}</a></li>
            <li><a href={`/${currentLang}/services`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '服务能力' : 'Services'}</a></li>
            <li><a href={`/${currentLang}/track-order`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '订单追踪' : 'Track Order'}</a></li>
            <li><a href={`/${currentLang}/no-moq`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '无MOQ制造' : 'No MOQ Manufacturing'}</a></li>
            <li><a href={`/${currentLang}/create-quote`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '获取报价' : 'Get Quote'}</a></li>
          </ul>
        </div>
        
        <!-- Resources -->
        <div>
          <h3 class="text-lg font-semibold mb-4">{currentLang === 'zh' ? '更多信息' : 'More Information'}</h3>
          <ul class="space-y-2">
            <li><a href={`/${currentLang}/case-studies`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '客户案例' : 'Case Studies'}</a></li>
            <li><a href={`/${currentLang}/about`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '关于我们' : 'About Us'}</a></li>
            <li><a href={`/${currentLang}/faq`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '常见问题' : 'FAQ'}</a></li>
            <li><a href={`/${currentLang}/contact`} class="text-gray-300 hover:text-white">{currentLang === 'zh' ? '联系我们' : 'Contact Us'}</a></li>
          </ul>
        </div>
      </div>
      
      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
        <p>
          {currentLang === 'zh' ? 
            '&copy; 2024 奇塑科技(深圳)有限公司. 保留所有权利.' : 
            '&copy; 2024 Geppetto Technologies Ltd. All rights reserved.'
          } | 
          <a href={`/${currentLang}/privacy`} class="hover:text-white">{currentLang === 'zh' ? '隐私政策' : 'Privacy Policy'}</a> | 
          <a href={`/${currentLang}/terms`} class="hover:text-white">{currentLang === 'zh' ? '服务条款' : 'Terms of Service'}</a>
        </p>
      </div>
    </div>
  </footer>
  
  <!-- Cookie Consent Banner -->
  <CookieConsent />
  
  <!-- 全局模态框和Toast -->
  <GlobalModal />
  <GlobalToast />
  
  <!-- Enhanced Mobile Menu Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const menuButton = document.getElementById('mobile-menu-button')
      const mobileMenu = document.getElementById('mobile-menu')
      
      menuButton?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden')
        mobileMenu?.classList.toggle('hidden')
        
        // Update button aria-expanded for accessibility
        menuButton.setAttribute('aria-expanded', (!isHidden).toString())
      })
      
      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!menuButton?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
          mobileMenu?.classList.add('hidden')
          menuButton?.setAttribute('aria-expanded', 'false')
        }
      })
      
      // Close mobile menu on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
          mobileMenu?.classList.add('hidden')
          menuButton?.setAttribute('aria-expanded', 'false')
          menuButton?.focus()
        }
      })
    })
  </script>
</body>
</html>
