---
import { getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import HeroSection from '../../components/marketing/HeroSection.astro'
import AdvantagesGrid from '../../components/marketing/AdvantagesGrid.astro'
import TestimonialSection from '../../components/marketing/TestimonialSection.astro'
import CompactCostCalculator from '../../components/islands/CompactCostCalculator.astro'
import { t } from '../../utils/i18n'

const currentLang = 'zh'

// Chinese market optimized content
const data = {
  seo: {
    title: '柔性智能工厂 | 透明制造专家 | 72小时快速交付 | 零起订量CNC加工 | Geppetto',
    description: '柔性智能工厂响应您的创新节奏：智能分析+专家验证、标准精度±0.1mm、72小时生产周期、零起订量。专为创业公司打造的透明制造解决方案。',
    keywords: ['柔性智能工厂', '透明制造', '智能制造', '数字化制造', '智能工厂', 'CNC精密加工', '快速原型制造', '微精加工', 'CNC自动化', '制造创新', '柔性工厂', '数字孪生制造', '机器人制造', '电子制造', '精密制造']
  },
  hero: {
    title: '柔性智能工厂，响应您的创新节奏',
    subtitle: '透明制造专家，终结制造报价混乱',
    description: '智能分析+专家验证 • 透明定价体系 • 72小时快速交付\n标准精度±0.1mm • 零起订量生产 • 无隐藏费用承诺',
    cta: {
      primary: {
        text: '立即获取报价',
        href: '/zh/create-quote'
      },
      secondary: {
        text: '看我们的不同之处',
        href: '/zh/why-geppetto'
      }
    }
  },
  advantages: [
    {
      id: 'pricing-transparency',
      title: '智能验证体系',
      description: '终结制造报价混乱。智能分析+专家技术审核=透明报价体系，专家主导确保服务质量，完全价值结构可见。',
      icon: '',
      stats: '智能验证 • 无隐藏费用',
      color: 'purple'
    },
    {
      id: 'startup-friendly-manufacturing',
      title: '柔性制造响应',
      description: '1件起做，72小时生产完成。柔性智能工厂响应您的创新节奏，无MOQ限制，现金流友好。',
      icon: '',
      stats: '1件起做 • 72小时生产+运输 • 无MOQ',
      color: 'blue'
    },
    {
      id: 'precision-guarantee',
      title: '项目定制精度保证',
      description: '满足工业制造、电子设备等行业精度要求。项目定制精度标准，质量体系完善，相关认证获取中。',
      icon: '',
      stats: '根据需求定制 • 100%符合性 • 质量保证',
      color: 'green'
    },
    {
      id: 'transparent-communication',
      title: '全程透明沟通',
      description: '8小时专家审核报价，实时生产进度更新。没有模糊承诺，只有清晰时间节点和可靠交付。',
      icon: '',
      stats: '8小时报价 • 实时进度 • 清晰时间节点',
      color: 'orange'
    }
  ],
  testimonials: [
    {
      name: '张工程师',
      company: '某具身智能初创公司',
      content: '制造报价一直让我们很困惑，传统供应商报价差异巨大。Geppetto的双重验证体系详细分解了成本构成，最终价格合理透明，精度完全符合项目要求。现在我们所有原型都找他们做。',
      stats: {
        precision: '按需定制',
        transparency: '100%透明',
        delivery_time: '72小时生产',
        satisfaction: '初创首选'
      }
    }
  ],
  features: [
    {
      title: '透明制造专家',
      description: '终结制造报价混乱，为初创企业提供清晰可靠的制造服务',
      icon: '✓'
    },
    {
      title: '127+初创企业',
      description: '专门服务初创企业，理解小批量、快节奏、成本敏感的需求',
      icon: '✓'
    },
    {
      title: '8小时专家报价',
      description: '专业工程师审核，提供详细服务分解和技术建议',
      icon: '✓'
    }
  ]
}

const structuredData = {
  type: 'organization',
  data: {
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      "name": "AI智能制造服务",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "AI辅助分析，专家报价服务",
            "description": "AI辅助分析CAD文件，专家8小时内提供详细报价"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "CNY",
            "price": "0",
            "description": "免费AI辅助分析服务，专家审核报价"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service", 
            "name": "Industry Standards精密CNC加工",
            "description": "超高精度按需定制"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "72小时快速生产交付",
            "description": "专门产能配置，72小时内完成生产+物流"
          }
        }
      ]
    }
  }
}
---

<BaseLayout 
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  structuredData={structuredData}
>
  <!-- Hero Section with transition animation -->
  <div transition:name="hero-section" transition:animate="slide">
    <HeroSection hero={data.hero} features={data.features} language="zh" />
  </div>

  <!-- Compact Cost Calculator Section -->
  <section class="py-16 bg-white" transition:name="calculator-section" transition:animate="fade">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          成本预估参考
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          输入基本参数获得大概成本范围。仅供参考，精准报价需要AI辅助分析CAD文件，专家8小时内审核确认。
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto">
        <CompactCostCalculator language="zh" className="shadow-xl" />
      </div>
      
      <div class="mt-8 text-center text-sm text-gray-500">
        注意：此为粗略估算，AI辅助初步分析，专家8小时内审核提供详细报价 | 零隐藏费用保证
      </div>
    </div>
  </section>

  <!-- Four Core Advantages with stagger animation -->
  <div transition:name="advantages-section" transition:animate="fade">
    <AdvantagesGrid advantages={data.advantages} language="zh" />
  </div>

  <!-- Customer Success Story with morph transition -->
  <div transition:name="testimonials-section" transition:animate="slide">
    <TestimonialSection testimonials={data.testimonials} language="zh" />
  </div>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-purple-600 to-blue-500" transition:name="cta-section" transition:animate="fade">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        准备体验Geppetto透明制造承诺？
      </h2>
      <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
        上传您的图纸，AI辅助分析后，专家8小时内完成技术审核与价值分解，提供详细报价
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/zh/create-quote" 
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors duration-200 shadow-lg"
        >
          立即获取专业服务报价
        </a>
        <a 
          href="tel:+86 13511091304" 
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-purple-600 transition-colors duration-200"
        >
           技术专家咨询
        </a>
      </div>
      
      <div class="mt-8 text-purple-100 text-sm">
        无风险试用 • 质量承诺 • 工作时间技术支持
      </div>
    </div>
  </section>

  <!-- 中国市场特色优势 -->
  <section class="py-16 bg-gray-50" transition:name="china-advantages" transition:animate="slide">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          专为中国市场打造的制造优势
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          深度理解中国制造业需求，提供最适合的智能制造解决方案
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-4xl mb-4 text-center"></div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 text-center">深圳总部优势</h3>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>本土化服务团队</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>粤港澳大湾区制造网络</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>中文技术支持</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>国内物流配送</li>
          </ul>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-4xl mb-4 text-center"></div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 text-center">成本控制优势</h3>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>AI+学徒制降本模式</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>无汇率风险</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>人民币计价结算</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>本地化供应链</li>
          </ul>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-4xl mb-4 text-center"></div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 text-center">服务响应优势</h3>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>同时区实时沟通</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>现场技术支持</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>定制化解决方案</li>
            <li class="flex items-center"><span class="text-green-500 mr-2">✓</span>快速迭代优化</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>