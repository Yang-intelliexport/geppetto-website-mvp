---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TransparentPromise from '../../components/sections/TransparentPromise.astro';
import { servicesContent, type Locale } from '../../data/i18n/services';
import { contactContent } from '../../data/i18n/contact';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = servicesContent[locale];
const contact = contactContent[locale];
const serviceStructuredData = {
  type: 'service',
  data: {
    name: locale === 'zh' ? 'Geppetto透明制造服务' : 'Geppetto Transparent Manufacturing Services',
    description: content.metaDescription,
    serviceType: 'CNC Manufacturing',
    provider: {
      name: 'Geppetto',
      url: import.meta.env.PUBLIC_SITE_URL || 'https://www.geppetto.studio'
    },
    areaServed: ['Global', 'China', 'USA', 'Europe'],
    offers: content.coreServices.cards.map((card) => ({
      "@type": 'Offer',
      "name": card.title,
      "description": card.description
    })),
    category: ['CNC machining', '3D printing', 'Surface finishing'],
    audience: ['Startups', 'Robotics teams', 'Medical device companies', 'Aerospace innovators'],
    availableLanguage: ['zh-CN', 'en']
  }
} as const;
const contactStructuredData = {
  "@type": 'ContactPoint',
  telephone: contact.quickContacts[0]?.value ?? '+86 13511091304',
  email: contact.quickContacts[1]?.value ?? 'hello@geppetto.studio',
  contactType: 'customer service',
  availableLanguage: ['zh-CN', 'en']
} as const;
---

<BaseLayout 
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.metaKeywords}
  structuredData={{
    type: 'service',
    data: {
      ...serviceStructuredData.data,
      provider: {
        ...serviceStructuredData.data.provider,
        contactPoint: contactStructuredData
      }
    }
  }}
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto text-center">
          <h1 class="text-5xl font-bold mb-6">{content.hero.title}</h1>
          <p class="text-2xl text-blue-100 mb-8">{content.hero.subtitle}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-12">
            {content.hero.stats.map((stat) => (
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">{stat.value}</div>
                <div class="text-lg">{stat.label}</div>
                <div class="text-sm text-blue-200">{stat.description}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
  </section>

  {content.heroIntro && (
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">{content.heroIntro.title}</h2>
          <div class="space-y-4 text-lg text-gray-600">
            {content.heroIntro.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <TransparentPromise language={locale} />

    <!-- Core Services -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.coreServices.title}
            </h2>
            <p class="text-xl text-gray-600">
              {content.coreServices.description}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {content.coreServices.cards.map((card) => (
              <div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300">
                <div class="flex items-center mb-6">
                  <div class="text-4xl mr-4">{card.icon}</div>
                  <div>
                    <h3 class="text-2xl font-bold text-gray-800">{card.title}</h3>
                    <p class="text-blue-600">{card.description}</p>
                  </div>
                </div>
                
                {card.image && (
                  <div class="mb-6 rounded-xl overflow-hidden">
                    <img 
                      src={card.image.src}
                      alt={card.image.alt}
                      class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                )}

                <div class="grid md:grid-cols-2 gap-6">
                  {card.columns.map((column) => (
                    <div>
                      <h4 class="font-bold text-gray-700 mb-3">{column.title}</h4>
                      <ul class="space-y-2 text-sm text-gray-600">
                        {column.items.map((item) => (
                          <li>• {item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                {card.cta && (
                  <div class="mt-6">
                    <a href={card.cta.href} class="inline-flex items-center px-5 py-3 rounded-xl text-sm font-semibold bg-purple-600 text-white hover:bg-purple-700 transition">
                      {card.cta.text}
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {content.linkBlocks?.length > 0 && (
      <section class="py-16 bg-white">
        <div class="container mx-auto px-6">
          <div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-3">
            {content.linkBlocks.map((block) => (
              <div class="border border-gray-100 rounded-3xl p-6 shadow-sm hover:shadow-lg transition flex flex-col">
                <h3 class="text-xl font-semibold text-gray-900 mb-3">{block.title}</h3>
                <p class="text-sm text-gray-600 flex-1">{block.description}</p>
                <a href={block.href} class="inline-flex items-center text-sm font-semibold text-purple-600 hover:text-purple-800 mt-4">
                  {block.cta}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Advantages -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.advantages.title}
            </h2>
            <p class="text-xl text-gray-600">
              {content.advantages.description}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {content.advantages.cards.map((card) => (
              <div class={`bg-gradient-to-br rounded-3xl p-8 border hover:shadow-lg transition-all duration-300 ${
                card.accent === 'purple' ? 'from-blue-50 to-purple-50 border-blue-200'
                : card.accent === 'blue' ? 'from-green-50 to-blue-50 border-green-200'
                : 'from-orange-50 to-red-50 border-orange-200'
              }`}>
                <div class="text-center">
                  <div class={`w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl text-white ${
                    card.accent === 'purple'
                      ? 'bg-gradient-to-r from-blue-500 to-purple-600'
                      : card.accent === 'blue'
                      ? 'bg-gradient-to-r from-green-500 to-blue-600'
                      : 'bg-gradient-to-r from-orange-500 to-red-600'
                  }`}>
                    {card.icon}
                  </div>
                  <h3 class="text-2xl font-bold text-gray-800 mb-4">{card.title}</h3>
                  <p class="text-gray-600 mb-6">{card.description}</p>
                  <div class="space-y-2 text-left">
                    {card.bullets.map((bullet) => (
                      <div class="flex items-center space-x-3">
                        <div class="w-2 h-2 rounded-full bg-purple-500"></div>
                        <span class="text-gray-700 text-sm">{bullet}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section class="py-20 bg-gradient-to-br from-purple-50 to-blue-50">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.comparison.title}
            </h2>
            <p class="text-xl text-gray-600">
              {content.comparison.description}
            </p>
          </div>

          <div class="bg-white rounded-3xl shadow-xl p-8 mb-12">
            <div class="grid md:grid-cols-2 gap-8">
              {content.comparison.lists.map((list) => (
                <div class={`rounded-xl p-6 border-l-4 ${
                  list.accent === 'red' ? 'bg-red-50 border-red-500' : 'bg-green-50 border-green-500'
                }`}>
                  <h4 class={`text-lg font-bold mb-4 ${list.accent === 'red' ? 'text-red-700' : 'text-green-700'}`}>
                    {list.title}
                  </h4>
                  <ul class={`space-y-2 text-sm ${list.accent === 'red' ? 'text-red-600' : 'text-green-600'}`}>
                    {list.items.map((item) => (
                      <li>• {item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <div class="grid md:grid-cols-3 gap-8 mb-12">
            {content.pillars.cards.map((card) => (
              <div class={`bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 ${
                card.accent === 'purple'
                  ? 'border-purple-500'
                  : card.accent === 'blue'
                  ? 'border-blue-500'
                  : 'border-green-500'
              }`}>
                <div class={`w-16 h-16 ${
                  card.accent === 'purple'
                    ? 'bg-purple-100 text-purple-600'
                    : card.accent === 'blue'
                    ? 'bg-blue-100 text-blue-600'
                    : 'bg-green-100 text-green-600'
                } rounded-full flex items-center justify-center mx-auto mb-4 text-2xl`}>
                  {card.icon}
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-3">{card.title}</h3>
                <p class="text-gray-600 text-sm mb-4">{card.description}</p>
                <div class={`rounded-lg p-3 text-sm ${
                  card.accent === 'purple'
                    ? 'bg-purple-50 text-purple-900'
                    : card.accent === 'blue'
                    ? 'bg-blue-50 text-blue-900'
                    : 'bg-green-50 text-green-900'
                }`}>
                  <h4 class="font-semibold mb-1">{card.highlightTitle}</h4>
                  <p class="text-xs">{card.highlights}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="bg-gradient-to-r from-purple-600 to-blue-600 rounded-3xl text-white p-8 text-center">
            <h3 class="text-2xl font-bold mb-8">{content.metrics.title}</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
              {content.metrics.items.map((metric) => (
                <div>
                  <div class="text-3xl font-bold text-yellow-300">{metric.value}</div>
                  <div class="text-sm">{metric.label}</div>
                  <div class="text-xs text-blue-200 whitespace-pre-line">{metric.note}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Industries -->
    <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.industries.title}
            </h2>
            <p class="text-xl text-gray-600">
              {content.industries.description}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {content.industries.cards.map((card) => (
              <div class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-2xl transition-all duration-300">
                <div class="text-center">
                  <div class="text-4xl mb-4">{card.icon}</div>
                  <h3 class="text-xl font-bold text-gray-800 mb-3">{card.title}</h3>
                  <p class="text-gray-600 text-sm mb-4">{card.description}</p>
                  <div class="space-y-2 text-sm text-gray-600">
                    {card.items.map((item) => (
                      <div>• {item}</div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Global Excellence -->
    <section class="py-16 bg-gradient-to-br from-blue-50 to-purple-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {content.global.title}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {content.global.description}
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {content.global.cards.map((card) => (
            <div class="bg-white rounded-xl p-6 shadow-lg text-center">
              <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                {card.icon}
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{card.title}</h3>
              <p class="text-sm text-gray-600">{card.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Spotlight -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <div class="bg-gradient-to-r from-purple-600 to-blue-600 rounded-3xl p-12 text-white">
          <div class="text-center mb-8">
            <h3 class="text-3xl font-bold mb-4">{content.spotlight.title}</h3>
            <p class="text-xl text-blue-100">{content.spotlight.subtitle}</p>
          </div>

          <div class="relative mb-8 rounded-2xl overflow-hidden">
            <img 
              src={content.spotlight.image.src}
              alt={content.spotlight.image.alt}
              class="w-full h-64 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            {content.spotlight.highlights.map((highlight) => (
              <div class="text-center">
                <div class="text-4xl mb-3">{highlight.icon}</div>
                <h4 class="font-bold text-yellow-300 mb-2">{highlight.title}</h4>
                <p class="text-blue-100 text-sm">{highlight.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-r from-purple-900 to-blue-900 text-white">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold mb-6">
          {content.cta.title}
        </h2>
        <p class="text-2xl text-blue-100 mb-12">
          {content.cta.subtitle}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
          {content.cta.highlights.map((highlight) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
              <div class="text-yellow-300 font-bold">{highlight.title}</div>
              <div class="text-blue-200 text-sm">{highlight.description}</div>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
          <a href={content.cta.primary.href} class="bg-gradient-to-r from-green-400 to-blue-500 text-white px-12 py-4 rounded-full text-xl font-bold hover:from-green-300 hover:to-blue-400 transform hover:scale-105 transition-all duration-300 shadow-2xl">
            {content.cta.primary.text}
          </a>
          
          <a href={content.cta.secondary.href} class="border-2 border-white text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-purple-900 transition-all duration-300">
            {content.cta.secondary.text}
          </a>
        </div>

        <div class="mt-8 text-blue-100">
          <p class="text-lg">
            {content.cta.disclaimer}
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
