---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';
import type { Language } from '../../utils/i18n';

const currentLang = (Astro.currentLocale ?? 'en') as Language;

const content = {
  en: {
    title: "CNC Cost Estimator | Instant Manufacturing Price Calculator | Geppetto",
    description: "Get instant CNC machining cost estimates. Our AI-powered calculator provides accurate pricing for precision manufacturing services.",
    pageTitle: "AI-Powered CNC Cost Estimator",
    subtitle: "⚡ Our instant AI calculator is upgrading",
    upgradeNotice: "Submit manual request now to get 10% off",
    formTitle: "Get Professional Quote with 10% Discount",
    lengthLabel: "Length (mm)",
    widthLabel: "Width (mm)", 
    thicknessLabel: "Thickness (mm)",
    materialLabel: "Material *",
    quantityLabel: "Quantity *",
    specialReqLabel: "Special Requirements (Optional)",
    submitBtn: "Get 10% Off Quote Now",
    benefits: [
      "✅ Professional engineer review",
      "✅ Transparent cost breakdown", 
      "✅ 8-hour response guarantee",
      "✅ 10% discount applied automatically"
    ],
    placeholders: {
      length: "Enter length",
      width: "Enter width", 
      thickness: "Enter thickness",
      specialReq: "Describe precision requirements, surface treatments, etc..."
    }
  },
  zh: {
    title: "CNC成本计算器 | 智能制造报价工具 | Geppetto",
    description: "获取即时CNC加工成本估算。我们的AI智能计算器为精密制造服务提供准确定价。",
    pageTitle: "AI智能CNC成本计算器",
    subtitle: "⚡ AI智能计算器升级中",
    upgradeNotice: "人工提交立减10%",
    formTitle: "获取专业报价享10%优惠",
    lengthLabel: "长度 (mm)",
    widthLabel: "宽度 (mm)",
    thicknessLabel: "厚度 (mm)", 
    materialLabel: "材料 *",
    quantityLabel: "数量 *",
    specialReqLabel: "特殊要求（可选）",
    submitBtn: "立即获取10%优惠报价",
    benefits: [
      "✅ 专业工程师审核",
      "✅ 透明成本分解",
      "✅ 8小时回复保证", 
      "✅ 10%折扣自动应用"
    ],
    placeholders: {
      length: "输入长度",
      width: "输入宽度",
      thickness: "输入厚度", 
      specialReq: "请描述精度要求、表面处理等..."
    }
  }
};

const pageContent = content[currentLang];
---

<BaseLayout
  title={pageContent.title}
  description={pageContent.description}
  keywords={["cnc calculator", "machining cost", "manufacturing quote", "price estimator"]}
>
  <div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          {pageContent.pageTitle}
        </h1>
        
        <!-- Upgrade Notice -->
        <div class="bg-gradient-to-r from-purple-500 to-blue-500 text-white rounded-lg p-6 mb-8 shadow-lg">
          <div class="text-xl font-semibold mb-2">{pageContent.subtitle}</div>
          <div class="text-lg">{pageContent.upgradeNotice}</div>
          <div class="text-sm opacity-90 mt-2">
            {currentLang === 'zh' ? '⏰ 限时优惠，专家人工审核' : '⏰ Limited time offer, expert manual review'}
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Form Section -->
        <div class="bg-white rounded-2xl shadow-xl p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">{pageContent.formTitle}</h2>
          
          <form action="/api/functions/submit-quote" method="POST" class="space-y-6">
            <!-- Dimensions -->
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  {pageContent.lengthLabel}
                </label>
                <input 
                  type="number" 
                  name="length"
                  placeholder={pageContent.placeholders.length}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  {pageContent.widthLabel}
                </label>
                <input 
                  type="number" 
                  name="width"
                  placeholder={pageContent.placeholders.width}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  {pageContent.thicknessLabel}
                </label>
                <input 
                  type="number" 
                  name="thickness"
                  placeholder={pageContent.placeholders.thickness}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                  required
                />
              </div>
            </div>

            <!-- Material -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {pageContent.materialLabel}
              </label>
              <select 
                name="material"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                required
              >
                <option value="">
                  {currentLang === 'zh' ? '请选择材料' : 'Select material'}
                </option>
                <option value="aluminum-6061">
                  {currentLang === 'zh' ? '6061铝合金（最常用）' : 'Aluminum 6061 (Most Common)'}
                </option>
                <option value="aluminum-7075">
                  {currentLang === 'zh' ? '7075铝合金（高强度）' : 'Aluminum 7075 (High Strength)'}
                </option>
                <option value="stainless-304">
                  {currentLang === 'zh' ? '304不锈钢（耐腐蚀）' : 'Stainless 304 (Corrosion Resistant)'}
                </option>
                <option value="stainless-316">
                  {currentLang === 'zh' ? '316不锈钢（医疗级）' : 'Stainless 316 (Medical Grade)'}
                </option>
              </select>
            </div>

            <!-- Quantity -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {pageContent.quantityLabel}
              </label>
              <input 
                type="number" 
                name="quantity"
                min="1"
                value="1"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                required
              />
            </div>

            <!-- Special Requirements -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {pageContent.specialReqLabel}
              </label>
              <textarea 
                name="specialRequirements"
                rows="3"
                placeholder={pageContent.placeholders.specialReq}
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none"
              ></textarea>
            </div>

            <!-- Hidden fields for tracking -->
            <input type="hidden" name="source" value="cost-estimator" />
            <input type="hidden" name="discount" value="10%" />
            <input type="hidden" name="language" value={currentLang} />

            <!-- Submit Button -->
            <button 
              type="submit"
              class="w-full bg-gradient-to-r from-purple-500 to-blue-500 text-white font-semibold py-4 px-6 rounded-lg hover:from-purple-600 hover:to-blue-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
            >
              🎯 {pageContent.submitBtn}
            </button>
          </form>
        </div>

        <!-- Benefits Section -->
        <div class="space-y-6">
          <div class="bg-white rounded-2xl shadow-xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              {currentLang === 'zh' ? '🎁 限时优惠包含' : '🎁 Limited Time Offer Includes'}
            </h3>
            <div class="space-y-3">
              {pageContent.benefits.map(benefit => (
                <div class="text-gray-700">{benefit}</div>
              ))}
            </div>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-2xl p-6 border border-green-200">
            <h4 class="font-semibold text-green-800 mb-2">
              {currentLang === 'zh' ? '⚡ 为什么选择人工审核？' : '⚡ Why Choose Manual Review?'}
            </h4>
            <p class="text-green-700 text-sm">
              {currentLang === 'zh' 
                ? '我们的专家工程师将根据您的具体需求提供更精确的报价和制造建议，确保最优的成本效益。'
                : 'Our expert engineers provide more accurate quotes and manufacturing advice based on your specific requirements, ensuring optimal cost-effectiveness.'
              }
            </p>
          </div>

          <div class="bg-gray-50 rounded-2xl p-6">
            <h4 class="font-semibold text-gray-800 mb-2">
              📞 {currentLang === 'zh' ? '需要立即咨询？' : 'Need Immediate Consultation?'}
            </h4>
            <div class="space-y-2 text-sm text-gray-600">
              <div>📧 hello@geppetto.studio</div>
              <div>📱 +86 13511091304</div>
              <div class="text-xs text-gray-500">
                {currentLang === 'zh' ? '工作时间: 周一至周五 9:00-18:00' : 'Business Hours: Mon-Fri 9:00-18:00 CST'}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Custom focus styles for better UX */
  input:focus, select:focus, textarea:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(139, 69, 255, 0.1);
  }
</style>