---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CheckoutOrderPayment from '../../../../components/order/CheckoutOrderPayment.tsx';

// 获取URL参数
const { id } = Astro.params;

if (!id) {
  return new Response('Invalid order ID', { status: 400 });
}
---

<BaseLayout 
  title="订单支付 - 安全便捷的支付处理 | Geppetto智能制造"
  description="为您的CNC制造订单提供安全的支付处理。支持多种支付方式，采用行业标准安全保护。"
>
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
            <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">💳 订单支付</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          您的报价已确认，请完成支付以开始生产流程
        </p>
      </div>

      <!-- Order Payment Component -->
      <CheckoutOrderPayment client:load orderId={id} language="zh" />
      
      <!-- Security Notice -->
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mt-8">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-blue-600 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-blue-900 mb-2">🔒 安全保障</h3>
            <div class="text-blue-800 space-y-2 text-sm">
              <p>• 采用SSL加密技术保护您的支付信息</p>
              <p>• 支持多种安全支付方式：微信支付、支付宝、银行卡</p>
              <p>• 支付完成后立即开始生产流程</p>
              <p>• 如有问题，请联系客服：<a href="mailto:hello@geppetto.studio" class="font-medium underline">hello@geppetto.studio</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>