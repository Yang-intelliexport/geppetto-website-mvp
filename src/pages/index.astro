---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/marketing/HeroSection.astro';
import AdvantagesGrid from '../components/marketing/AdvantagesGrid.astro';
import TestimonialSection from '../components/marketing/TestimonialSection.astro';
import CompactCostCalculator from '../components/islands/CompactCostCalculator.astro';
import TransparentPromise from '../components/sections/TransparentPromise.astro';
import TrustIndicators from '../components/sections/TrustIndicators.astro';
import { homeContent } from '../data/i18n/home';
import type { Locale } from '../data/i18n/home';

// 默认使用英文内容
const locale: Locale = 'en';
const content = homeContent[locale];
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  keywords={content.seo.keywords}
  structuredData={{ type: 'organization', data: content.structuredData }}
>
  <HeroSection hero={content.hero} features={content.hero.features} language={locale} />

  <AdvantagesGrid advantages={content.advantages} language={locale} />

  <TestimonialSection testimonials={content.testimonials} language={locale} />

  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl shadow-xl p-8 lg:p-12 flex flex-col lg:flex-row items-center gap-10">
        <div class="flex-1 space-y-4">
          <h2 class="text-3xl font-bold text-gray-900">
            Upload CAD files, get instant manufacturability insights
          </h2>
          <p class="text-gray-600 text-lg">
            AI pre-analysis plus expert review deliver transparent quotes and process suggestions within one business day.
          </p>
        </div>
        <div class="flex-1 w-full">
          <CompactCostCalculator client:load language={locale} />
        </div>
      </div>
    </div>
  </section>

  <TransparentPromise language={locale} />
  <TrustIndicators language={locale} />
</BaseLayout>