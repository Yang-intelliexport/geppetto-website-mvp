---
interface Props {
  language?: 'zh' | 'en'
}

const { language = 'en' } = Astro.props

const text = {
  zh: {
    trustBadges: {
      title: '🏆 权威认证与合作伙伴',
      subtitle: '国际标准认证，全球物流网络，安全支付保障'
    }
  },
  en: {
    trustBadges: {
      title: '🏆 Certified & Trusted Partners',
      subtitle: 'International standards, global logistics, secure payments'
    }
  }
}

const currentText = text[language]
---

<section class="py-16 bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
        Technical Excellence & Proven Results
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Advanced technology and manufacturing capabilities that deliver superior precision and speed
      </p>
    </div>
    
    <!-- Technical Capabilities Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- AI Technology -->
      <div class="text-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg hover:shadow-lg transition-shadow duration-200">
        <div class="w-16 h-16 bg-purple-600 text-white rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-2xl">🤖</span>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">智能弹性 Analysis</h3>
        <p class="text-sm text-gray-600">Rapid CAD recognition & optimization</p>
      </div>
      
      <!-- Precision -->
      <div class="text-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg hover:shadow-lg transition-shadow duration-200">
        <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-sm font-bold">Pro</span>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Ultra Precision</h3>
        <p class="text-sm text-gray-600">project-specific guaranteed accuracy</p>
      </div>
      
      <!-- Speed -->
      <div class="text-center p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-lg hover:shadow-lg transition-shadow duration-200">
        <div class="w-16 h-16 bg-green-600 text-white rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-lg font-bold">72H+</span>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Lightning Fast</h3>
        <p class="text-sm text-gray-600">72H production + shipping</p>
      </div>
      
      <!-- No MOQ -->
      <div class="text-center p-6 bg-gradient-to-br from-orange-50 to-orange-100 rounded-lg hover:shadow-lg transition-shadow duration-200">
        <div class="w-16 h-16 bg-orange-600 text-white rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-lg font-bold">1pc</span>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">No MOQ</h3>
        <p class="text-sm text-gray-600">Single piece manufacturing</p>
      </div>
    </div>
    
    <!-- Technical Excellence -->
    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="font-bold text-gray-900 mb-4 flex items-center">
          <span class="text-2xl mr-2">🧠</span>
          AI Technology Stack
        </h3>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Computer Vision CAD Analysis</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Machine Learning Optimization</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Predictive Quality Control</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Automated Process Planning</li>
        </ul>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="font-bold text-gray-900 mb-4 flex items-center">
          <span class="text-2xl mr-2">⚙️</span>
          Manufacturing Excellence
        </h3>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> 5-Axis CNC Machining</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Swiss Turning Capabilities</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Advanced Surface Finishing</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Multi-Material Processing</li>
        </ul>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="font-bold text-gray-900 mb-4 flex items-center">
          <span class="text-2xl mr-2">🎯</span>
          Quality Excellence
        </h3>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> 100% Dimensional Inspection</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Real-Time Quality Monitoring</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Advanced Metrology Equipment</li>
          <li class="flex items-center"><span class="text-green-500 mr-2">✓</span> Statistical Process Control</li>
        </ul>
      </div>
    </div>
    
    <!-- Social Trust & Credibility -->
    <div class="mb-12">
      <h3 class="text-xl font-bold text-gray-900 text-center mb-8">🏆 Trusted by Industry Leaders</h3>
      
      <!-- Industry Recognition -->
      <div class="grid md:grid-cols-3 gap-6 mb-8">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">🎓</div>
          <h4 class="font-bold text-gray-900 mb-2">Academic Excellence</h4>
          <p class="text-sm text-gray-600">Founded by Zhejiang University team with deep manufacturing research background</p>
        </div>
        
        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">🏭</div>
          <h4 class="font-bold text-gray-900 mb-2">Quality Systems</h4>
          <p class="text-sm text-gray-600">Established quality control processes, working towards industry certifications</p>
        </div>
        
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">🤝</div>
          <h4 class="font-bold text-gray-900 mb-2">Partner Network</h4>
          <p class="text-sm text-gray-600">Strategic partnerships with material suppliers and logistics providers</p>
        </div>
      </div>
      
      <!-- Customer Trust Metrics -->
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 text-white">
        <div class="grid md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-yellow-300 mb-2">100+</div>
            <div class="text-lg mb-1">Satisfied Customers</div>
            <div class="text-sm text-blue-200">Startups to Mid-Size Companies</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-300 mb-2">98%</div>
            <div class="text-lg mb-1">Customer Satisfaction</div>
            <div class="text-sm text-blue-200">Would recommend us</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-300 mb-2">4-8h</div>
            <div class="text-lg mb-1">Average Response</div>
            <div class="text-sm text-blue-200">vs industry 2-3 weeks</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-300 mb-2">85%</div>
            <div class="text-lg mb-1">Cost Reduction</div>
            <div class="text-sm text-blue-200">vs traditional suppliers</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Customer Testimonials Preview -->
    <div class="mt-12">
      <h3 class="text-xl font-bold text-gray-900 text-center mb-8">💬 What Our Customers Say</h3>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-lg">🚀</span>
            </div>
            <div class="ml-4">
              <div class="font-semibold text-gray-900">Sarah Chen, CTO</div>
              <div class="text-sm text-gray-600">AI Robotics Startup</div>
            </div>
          </div>
          <p class="text-gray-600 italic">"Geppetto's flexible factory approach saved us 6 months and $200K in development costs. They understood our startup constraints perfectly."</p>
          <div class="mt-4 flex items-center justify-between">
            <div class="text-yellow-500">★★★★★</div>
            <div class="text-xs text-gray-500">Savings: $200K • Industry: Robotics</div>
          </div>
        </div>
        
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
              <span class="text-lg">⚡</span>
            </div>
            <div class="ml-4">
              <div class="font-semibold text-gray-900">Engineering Manager</div>
              <div class="text-sm text-gray-600">Robotics Company</div>
            </div>
          </div>
          <p class="text-gray-600 italic">"We were amazed - they exceeded our precision requirements significantly, and the price was 60% lower than our previous supplier."</p>
          <div class="mt-4 flex items-center justify-between">
            <div class="text-yellow-500">★★★★★</div>
            <div class="text-xs text-gray-500">Precision: Project-specific • Savings: 60%</div>
          </div>
        </div>
      </div>
      
      <div class="mt-6 text-center">
        <a 
          href={`/${language}/case-studies`}
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors duration-200"
        >
          📊 {language === 'zh' ? '查看所有成功案例' : 'View All Success Stories'}
        </a>
      </div>
    </div>

    <!-- 🏆 Trust Badges Section -->
    <div class="mt-16 border-t border-gray-200 pt-12">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-gray-900 mb-2">{currentText.trustBadges.title}</h3>
        <p class="text-gray-600">{currentText.trustBadges.subtitle}</p>
      </div>

      <!-- Trust Badges Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6 items-center justify-items-center opacity-70 hover:opacity-100 transition-opacity duration-300">
        
        <!-- ISO 9001 Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832L14 10.202a1 1 0 000-1.732L9.555 7.168z"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">ISO 9001</div>
            <div class="text-xs text-gray-500">Quality</div>
          </div>
        </div>

        <!-- DHL Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-yellow-100 text-yellow-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1z"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">DHL</div>
            <div class="text-xs text-gray-500">Express</div>
          </div>
        </div>

        <!-- FedEx Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M5 5a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H7a2 2 0 01-2-2V5zM5 13a2 2 0 012-2h6a2 2 0 012 2v2a2 2 0 01-2 2H7a2 2 0 01-2-2v-2z"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">FedEx</div>
            <div class="text-xs text-gray-500">Global</div>
          </div>
        </div>

        <!-- PayPal Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zM14 6a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2h6zM4 14a2 2 0 002 2h8a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2z"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">PayPal</div>
            <div class="text-xs text-gray-500">Secure</div>
          </div>
        </div>

        <!-- Stripe Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 15.324 3.744a1 1 0 011.838.512L16.002 8l1.16 3.744a1 1 0 01-1.838.512L14.146 8.8l-1.179 3.456a1 1 0 01-1.838-.512L12.288 8l-1.16-3.744A1 1 0 0112 2z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">Stripe</div>
            <div class="text-xs text-gray-500">Payment</div>
          </div>
        </div>

        <!-- SSL Badge -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-2">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="text-xs font-semibold text-gray-700">256-bit</div>
            <div class="text-xs text-gray-500">SSL</div>
          </div>
        </div>
      </div>

      <!-- Additional Trust Elements -->
      <div class="mt-8 text-center text-sm text-gray-500">
        <div class="inline-flex items-center space-x-6">
          <span>🛡️ Enterprise Security</span>
          <span>•</span>
          <span>🌍 Global Shipping</span>
          <span>•</span> 
          <span>💳 Secure Payments</span>
          <span>•</span>
          <span>📞 24/7 Support</span>
        </div>
      </div>
    </div>
  </div>
</section>
