---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { noMoqContent, type Locale } from '../../data/i18n/noMoq';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = noMoqContent[locale];
const productStructuredData = {
  type: 'product',
  data: {
    name: locale === 'zh' ? '无MOQ制造服务' : 'No MOQ Manufacturing Service',
    description: content.metaDescription,
    category: 'CNC manufacturing',
    offers: {
      priceCurrency: locale === 'zh' ? 'CNY' : 'USD',
      price: '0',
      url: `/${locale}/create-quote`
    },
    additionalProperty: content.process.map((step) => ({
      "@type": "PropertyValue",
      "name": step.label,
      "value": step.detail
    }))
  }
} as const;
---

<BaseLayout 
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.metaKeywords}
  structuredData={productStructuredData}
>
  <main class="min-h-screen bg-white">
    <section class="bg-gradient-to-br from-blue-900 via-purple-900 to-gray-900 text-white py-20">
      <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <div class="inline-flex items-center space-x-3 px-4 py-2 bg-white/10 rounded-full text-sm font-semibold uppercase tracking-wide">
            <span>⚙️ {content.hero.badge}</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mt-6 leading-tight">{content.hero.title}</h1>
          <p class="text-xl text-blue-100 mt-6 leading-relaxed">{content.hero.subtitle}</p>
          <div class="grid grid-cols-2 gap-4 mt-8">
            {content.hero.stats.map((stat) => (
              <div class="bg-white/10 rounded-xl p-4 text-center border border-white/10">
                <div class="text-2xl font-bold text-yellow-300">{stat.value}</div>
                <div class="text-sm text-blue-100">{stat.label}</div>
              </div>
            ))}
          </div>
          <div class="flex flex-col sm:flex-row gap-4 mt-10">
            <a href={content.hero.primaryLink.href} class="bg-white text-purple-900 px-8 py-4 rounded-xl text-lg font-bold text-center hover:bg-purple-100 transition-colors">
              {content.hero.primaryLink.text}
            </a>
            <a href={content.hero.secondaryLink.href} class="border-2 border-white px-8 py-4 rounded-xl text-lg font-semibold text-center hover:bg-white hover:text-purple-900 transition-colors">
              {content.hero.secondaryLink.text}
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 border border-white/20">
          <h2 class="text-2xl font-semibold mb-6 text-center">
            {locale === 'zh' ? '为何需要无MOQ模式' : 'Why founders drop MOQ constraints'}
          </h2>
          <div class="space-y-6">
            {content.proofPoints.map((point) => (
              <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
                <h3 class="text-lg font-semibold text-white mb-2">{point.title}</h3>
                <p class="text-sm text-blue-100 leading-relaxed">{point.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold text-purple-600 uppercase tracking-widest mb-3">
            {locale === 'zh' ? '服务行业' : 'Industries we support'}
          </p>
          <h2 class="text-3xl font-bold text-gray-900">
            {locale === 'zh' ? '无MOQ模式最能创造价值的场景' : 'Where no-MOQ manufacturing matters most'}
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {content.industries.map((industry) => (
            <div class="border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="text-lg font-semibold text-gray-900 mb-2">{industry.name}</div>
              <p class="text-sm text-gray-600">{industry.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {content.useCases?.length > 0 && (
      <section class="py-16 bg-gradient-to-b from-white to-gray-50">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <p class="text-sm uppercase tracking-[0.3em] text-purple-500 mb-3">
              {locale === 'zh' ? '典型场景' : 'Typical Scenarios'}
            </p>
            <h2 class="text-3xl font-bold text-gray-900">
              {locale === 'zh' ? '把预算用在刀刃上' : 'Make every unit count'}
            </h2>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {content.useCases.map((useCase) => (
              <div class="border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition flex flex-col">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">{useCase.title}</h3>
                <p class="text-sm text-gray-600 flex-1">{useCase.description}</p>
                <a href={useCase.href} class="inline-flex items-center text-sm font-semibold text-purple-600 hover:text-purple-800 mt-4">
                  {useCase.cta}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm uppercase font-semibold tracking-widest text-purple-600 mb-3">
            {locale === 'zh' ? '执行节奏' : 'Execution timeline'}
          </p>
          <h2 class="text-3xl font-bold text-gray-900">
            {locale === 'zh' ? '从上传到出货的透明流程' : 'From CAD upload to shipment'}
          </h2>
          <p class="text-gray-600 mt-4 text-lg">
            {locale === 'zh'
              ? '每个节点都有时间戳，硬件冲刺不再依赖“口头承诺”。'
              : 'Every stage is timestamped so your hardware roadmap stays predictable.'}
          </p>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          {content.process.map((stage, index) => (
            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
              <div class="w-10 h-10 rounded-full bg-purple-600/10 text-purple-600 flex items-center justify-center font-semibold mb-4">
                {index + 1}
              </div>
              <div class="text-sm font-bold text-gray-900 mb-2">{stage.label}</div>
              <p class="text-sm text-gray-600">{stage.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-r from-purple-600 to-blue-500 text-white text-center">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-4">{content.cta.title}</h2>
        <p class="text-xl text-purple-100 mb-8">
          {content.cta.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={content.cta.primary.href} class="bg-white text-purple-700 px-10 py-4 rounded-xl font-semibold hover:bg-purple-100 transition-colors">
            {content.cta.primary.text}
          </a>
          <a href={content.cta.secondary.href} class="border-2 border-white px-10 py-4 rounded-xl font-semibold hover:bg-white hover:text-purple-700 transition-colors">
            {content.cta.secondary.text}
          </a>
        </div>
        <p class="mt-6 text-sm text-purple-100">{content.cta.note}</p>
      </div>
    </section>
  </main>
</BaseLayout>
