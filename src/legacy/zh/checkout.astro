    "银行转账", "PayPal支付", "国际电汇", "分期付款"
  ]}
  ogImage="/images/og-checkout-zh.jpg"
  structuredData={{
    type: 'webpage',
    data: {
      '@type': 'CheckoutPage',
      'name': '订单确认页面',
      'description': '确认CNC制造订单，选择物流和支付方式',
      'provider': {
        '@type': 'Organization',
        'name': 'Geppetto智能制造'
