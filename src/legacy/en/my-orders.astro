---
// English my orders page - Requires email verification
import BaseLayout from '../../layouts/BaseLayout.astro';
import MyOrdersList from '../../components/MyOrdersList.tsx';
import { handleAuthCallback } from '../../utils/authUtils.js';

// Check for authentication callback
const urlParams = new URLSearchParams(Astro.url.searchParams);
const authResult = await handleAuthCallback(urlParams);

// Get email from URL parameters (if available)
const emailFromUrl = urlParams.get('email') || '';
---

<BaseLayout 
  title="My Orders - Geppetto CNC Manufacturing"
  description="View your CNC machining order status, progress, and detailed information"
  currentLang="en"
>
  <div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Title -->
      <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">My Orders</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          View your CNC machining order status, production progress, and delivery information
        </p>
      </div>

      <!-- Authentication success notification -->
      {authResult?.success && (
        <div class="mb-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Login successful! Loading your orders...</span>
          </div>
        </div>
      )}

      <!-- Authentication error notification -->
      {authResult?.error && (
        <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Login failed: {authResult.error}</span>
          </div>
        </div>
      )}

      <!-- Orders list component -->
      <MyOrdersList 
        client:load 
        initialEmail={emailFromUrl}
        authResult={authResult ? JSON.stringify(authResult) : null}
        currentLang="en"
      />
      
      <!-- Help information -->
      <div class="mt-12 bg-blue-50 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-blue-900 mb-4">Need Help?</h3>
        <div class="grid md:grid-cols-2 gap-4 text-sm text-blue-800">
          <div>
            <h4 class="font-medium mb-2">Can't find your order?</h4>
            <p>Please make sure to log in with the same email address used when submitting your quote, or contact our customer service team.</p>
          </div>
          <div>
            <h4 class="font-medium mb-2">Order Status Explanation</h4>
            <ul class="space-y-1">
              <li>• <span class="font-medium">Quoting</span> - We're preparing a detailed quote for you</li>
              <li>• <span class="font-medium">In Production</span> - Your order is being CNC machined</li>
              <li>• <span class="font-medium">Shipped</span> - Order has been dispatched, check tracking info</li>
            </ul>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-blue-200">
          <a 
            href="/en/contact" 
            class="inline-flex items-center text-blue-700 hover:text-blue-900 font-medium"
          >
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            Contact Customer Service
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>