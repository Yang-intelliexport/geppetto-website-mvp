---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { faqCollectionByLocale, faqPageContent, type Locale } from '../../data/i18n/faq';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = faqPageContent[locale];
const collectionName = faqCollectionByLocale[locale];

type FaqEntry = CollectionEntry<'faqs'> | CollectionEntry<'faqs-en'>;
type Category = (typeof content)['categories'][number];
type ContactCard = (typeof content)['contactCards'][number];

const allFAQs = (await getCollection(collectionName as 'faqs' | 'faqs-en')) as FaqEntry[];
const faqs = [...allFAQs].sort((a, b) => a.data.order - b.data.order);
const featuredFAQs = faqs.filter((faq) => faq.data.featured);
const categoryMap = new Map<string, Category>(content.categories.map((category) => [category.label, category]));
const sanitizeAnswer = (value: string) =>
  value
    .replace(/<[^>]+>/g, '')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const faqStructuredData = {
  type: 'faq',
  data: {
    title: content.heroTitle,
    faqs: faqs.slice(0, 20).map((faq) => ({
      question: faq.data.question,
      answer: sanitizeAnswer(faq.body ?? '')
    }))
  }
} as const;
---

<BaseLayout title={content.metaTitle} description={content.metaDescription} structuredData={faqStructuredData}>
  <main class="min-h-screen">
    <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-bold mb-6">
            {content.heroTitle}
          </h1>
          <p class="text-2xl text-blue-100 mb-8">
            {content.heroSubtitle}
          </p>

          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.quickNavTitle}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {featuredFAQs.map((faq: FaqEntry) => (
              <a
                href={`#faq-${faq.slug}`}
                  class="bg-white/10 rounded-xl p-3 hover:bg-white/20 transition-colors duration-300 text-left"
                >
                  <div class="text-sm font-medium line-clamp-2">{faq.data.question}</div>
                </a>
              ))}
            </div>
          </div>

          <div class="max-w-2xl mx-auto">
            <div class="relative">
              <input
                type="text"
                id="faq-search"
                placeholder={content.searchPlaceholder}
                class="w-full px-6 py-4 pr-12 rounded-2xl text-gray-800 text-lg focus:outline-none focus:ring-4 focus:ring-yellow-300"
              />
              <svg
                class="w-6 h-6 absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.featuredTitle}
            </h2>
            <p class="text-xl text-gray-600">
              {content.featuredSubtitle}
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {await Promise.all(
              featuredFAQs.map(async (faq: FaqEntry) => {
                const { Content } = await faq.render();
                const category = categoryMap.get(faq.data.category);
                return (
                  <div id={`faq-${faq.slug}`} class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300">
                    <div class="flex items-start space-x-4 mb-6">
                      <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-blue-500 rounded-xl flex items-center justify-center flex-shrink-0">
                        <span class="text-white font-bold">Q</span>
                      </div>
                      <div class="flex-1">
                        {category && (
                          <span class={`text-xs font-medium px-3 py-1 rounded-full mb-3 inline-block ${category.badgeClasses}`}>
                            {category.icon} {category.label}
                          </span>
                        )}
                        <h3 class="text-xl font-bold text-gray-800 mb-4">{faq.data.question}</h3>
                      </div>
                    </div>

                    <div class="prose prose-gray max-w-none ml-16">
                      <Content />
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-800 mb-6">
              {content.categoriesTitle}
            </h2>
            <p class="text-xl text-gray-600">
              {content.categoriesSubtitle}
            </p>
          </div>

          <div class="flex flex-wrap justify-center gap-4 mb-12">
            <button
              class="category-filter bg-purple-100 text-purple-700 px-6 py-3 rounded-full font-semibold hover:bg-purple-200 transition-colors duration-300 active"
              data-category="all"
            >
              {content.categoriesAllLabel}
            </button>
            {content.categories.map((category: Category) => (
              <button
                class={`category-filter px-6 py-3 rounded-full font-semibold transition-colors duration-300 ${category.filterClasses}`}
                data-category={category.label}
              >
                {category.icon} {category.label}
              </button>
            ))}
          </div>

          <div class="space-y-4" id="faq-list">
            {await Promise.all(
              faqs.map(async (faq: FaqEntry, index) => {
                const { Content } = await faq.render();
                const category = categoryMap.get(faq.data.category);
                return (
                  <div
                    class="faq-item bg-white border border-gray-200 rounded-xl hover:shadow-lg transition-all duration-300"
                    data-category={faq.data.category}
                  >
                    <button
                      class="faq-toggle w-full px-8 py-6 text-left flex items-center justify-between hover:bg-gray-50 rounded-xl transition-colors duration-300"
                      type="button"
                    >
                      <div class="flex items-center space-x-4 flex-1">
                        <div class="w-8 h-8 bg-gradient-to-r from-purple-100 to-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                          <span class="text-purple-600 font-bold text-sm">Q</span>
                        </div>
                        <div class="flex-1">
                          {category && (
                            <span class={`text-xs font-medium px-2 py-1 rounded-full mr-3 ${category.badgeClasses}`}>
                              {category.label}
                            </span>
                          )}
                          <h3 class="text-lg font-semibold text-gray-800">{faq.data.question}</h3>
                          {faq.data.featured && (
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2 py-1 rounded-full ml-2">
                              {content.popularBadgeLabel}
                            </span>
                          )}
                        </div>
                      </div>
                      <svg
                        class={`w-5 h-5 text-gray-400 transform transition-transform duration-300 faq-icon-${index}`}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>

                    <div id={`faq-content-${index}`} class="faq-content hidden px-8 pb-6">
                      <div class="ml-12 prose prose-gray max-w-none">
                        <Content />
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gradient-to-r from-purple-900 to-blue-900 text-white">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold mb-6">
          {content.contactTitle}
        </h2>
        <p class="text-2xl text-blue-100 mb-12">
          {content.contactSubtitle}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          {content.contactCards.map((card: ContactCard) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
              <div class="text-4xl mb-4">{card.icon}</div>
              <h3 class="text-xl font-semibold mb-2">{card.title}</h3>
              <p class="text-blue-100">{card.description}</p>
              <p class="text-sm text-blue-200">{card.note}</p>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
          <a
            href={content.contactPrimaryCTA.href}
            class="bg-gradient-to-r from-yellow-400 to-orange-500 text-purple-900 px-12 py-4 rounded-full text-xl font-bold hover:from-yellow-300 hover:to-orange-400 transform hover:scale-105 transition-all duration-300 shadow-2xl"
          >
            {content.contactPrimaryCTA.text}
          </a>

          <a
            href={content.contactSecondaryCTA.href}
            class="border-2 border-white text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-purple-900 transition-all duration-300"
          >
            {content.contactSecondaryCTA.text}
          </a>
        </div>

        <div class="mt-8 text-blue-100">
          <p class="text-lg">
            {content.contactNote}
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('faq-search');
    const faqItems = document.querySelectorAll('.faq-item');
    const categoryFilters = document.querySelectorAll('.category-filter');
    const toggleButtons = document.querySelectorAll('.faq-toggle');

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) {
          return;
        }
        const searchTerm = target.value.toLowerCase();

        faqItems.forEach((item) => {
          if (!(item instanceof HTMLElement)) {
            return;
          }
          const questionElement = item.querySelector('h3');
          const contentElement = item.querySelector('.faq-content');
          const questionText = questionElement?.textContent?.toLowerCase() ?? '';
          const contentText = contentElement?.textContent?.toLowerCase() ?? '';

          if (questionText.includes(searchTerm) || contentText.includes(searchTerm)) {
            item.style.display = 'block';
            item.classList.add('search-highlight');
          } else {
            item.style.display = 'none';
            item.classList.remove('search-highlight');
          }
        });
      });
    }

    categoryFilters.forEach((filter) => {
      if (!(filter instanceof HTMLElement)) {
        return;
      }

      filter.addEventListener('click', () => {
        const category = filter.getAttribute('data-category');
        if (!category) {
          return;
        }

        categoryFilters.forEach((btn) => {
          if (btn instanceof HTMLElement) {
            btn.classList.remove('active');
          }
        });
        filter.classList.add('active');

        faqItems.forEach((item) => {
          if (!(item instanceof HTMLElement)) {
            return;
          }
          const itemCategory = item.getAttribute('data-category');
          if (category === 'all' || itemCategory === category) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
          item.classList.remove('search-highlight');
        });

        if (searchInput instanceof HTMLInputElement) {
          searchInput.value = '';
        }
      });
    });

    toggleButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) {
        return;
      }

      button.addEventListener('click', () => {
        const faqItem = button.closest('.faq-item');
        const content = faqItem?.querySelector('.faq-content');

        if (!(content instanceof HTMLElement)) {
          return;
        }

        const willExpand = content.classList.contains('hidden');
        content.classList.toggle('hidden', !willExpand);
        if (willExpand) {
          content.classList.add('animate-fade-in');
        } else {
          content.classList.remove('animate-fade-in');
        }
        button.classList.toggle('faq-open', willExpand);
      });
    });
  });

  const style = document.createElement('style');
  style.textContent = `
    .animate-fade-in {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .search-highlight {
      background: linear-gradient(90deg, #fef3c7, #ffffff);
    }
    .category-filter.active {
      background: linear-gradient(90deg, #7c3aed, #3b82f6) !important;
      color: white !important;
    }
    .faq-toggle svg {
      transition: transform 0.3s ease;
    }
    .faq-toggle.faq-open svg {
      transform: rotate(180deg);
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  `;
  if (document.head) {
    document.head.appendChild(style);
  }
</script>
