---
interface Props {
  label: string;
  required?: boolean;
  error?: string;
  helpText?: string;
  className?: string;
}

const { 
  label, 
  required = false, 
  error, 
  helpText, 
  className = '' 
} = Astro.props;
---

<div class={`form-field ${className}`}>
  <label class="block text-sm font-medium text-gray-700 mb-1">
    {label}
    {required && <span class="text-red-500 ml-1">*</span>}
  </label>
  
  <div class="form-input-container">
    <slot />
  </div>
  
  {error && (
    <div class="text-red-600 text-sm mt-1">{error}</div>
  )}
  
  {helpText && !error && (
    <div class="text-gray-500 text-sm mt-1">{helpText}</div>
  )}
</div>

<style>
.form-field {
  @apply w-full;
}

.form-field :global(input),
.form-field :global(select),
.form-field :global(textarea) {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500;
}

.form-field :global(input:focus),
.form-field :global(select:focus),
.form-field :global(textarea:focus) {
  @apply ring-2 ring-indigo-500 ring-opacity-50;
}

.form-field :global(.border-red-500) {
  @apply border-red-500 focus:ring-red-500;
}
</style>