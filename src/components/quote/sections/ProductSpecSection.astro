---
interface Props {
  language?: 'zh' | 'en';
}

const { language = 'zh' } = Astro.props;

const text = {
  zh: {
    title: '产品规格',
    material: { 
      label: '材料选择', 
      placeholder: '请选择材料',
      options: [
        { value: '', label: '请选择材料' },
        { value: 'aluminum-6061', label: '6061铝合金（最常用）' },
        { value: 'aluminum-7075', label: '7075铝合金（高强度）' },
        { value: 'stainless-304', label: '304不锈钢（耐腐蚀）' },
        { value: 'stainless-316', label: '316不锈钢（医疗级）' },
        { value: 'brass', label: '黄铜（导电性好）' },
        { value: 'copper', label: '紫铜（导热性好）' },
        { value: 'carbon-steel', label: '碳钢（经济实用）' },
        { value: 'titanium', label: '钛合金（航空级）' },
        { value: 'other', label: '其他（请在备注中说明）' }
      ],
      required: true 
    },
    quantity: { label: '数量', placeholder: '请输入数量', unit: '件', required: true },
    notes: { label: '特殊要求（可选）', placeholder: '请描述特殊要求、公差精度、表面处理等...', required: false },
    validation: {
      materialRequired: '请选择材料',
      quantityRequired: '请输入数量',
      quantityInvalid: '数量必须为正整数',
      quantityMin: '数量至少为1',
      quantityMax: '数量不能超过10000',
      notesTooLong: '备注长度不能超过1000个字符'
    }
  },
  en: {
    title: 'Product Specifications',
    material: { 
      label: 'Material Selection', 
      placeholder: 'Select material',
      options: [
        { value: '', label: 'Select material' },
        { value: 'aluminum-6061', label: 'Aluminum 6061 (Most Common)' },
        { value: 'aluminum-7075', label: 'Aluminum 7075 (High Strength)' },
        { value: 'stainless-304', label: 'Stainless 304 (Corrosion Resistant)' },
        { value: 'stainless-316', label: 'Stainless 316 (Medical Grade)' },
        { value: 'brass', label: 'Brass (Good Conductivity)' },
        { value: 'copper', label: 'Copper (Good Thermal Conductivity)' },
        { value: 'carbon-steel', label: 'Carbon Steel (Economical)' },
        { value: 'titanium', label: 'Titanium (Aerospace Grade)' },
        { value: 'other', label: 'Other (Please specify in notes)' }
      ],
      required: true 
    },
    quantity: { label: 'Quantity', placeholder: 'Enter quantity', unit: 'pcs', required: true },
    notes: { label: 'Special Requirements (Optional)', placeholder: 'Describe special requirements, tolerances, surface treatments...', required: false },
    validation: {
      materialRequired: 'Please select a material',
      quantityRequired: 'Please enter quantity',
      quantityInvalid: 'Quantity must be a positive integer',
      quantityMin: 'Quantity must be at least 1',
      quantityMax: 'Quantity cannot exceed 10000',
      notesTooLong: 'Notes cannot exceed 1000 characters'
    }
  }
}

const t = text[language];
---

<div class="product-spec-section">
  <h3 class="text-lg font-medium text-gray-900 mb-4">{t.title}</h3>
  
  <div class="space-y-4">
    <!-- Material Selection (Required) -->
    <div class="form-field">
      <label for="material" class="block text-sm font-medium text-gray-700 mb-1">
        {t.material.label}
        <span class="text-red-500 ml-1">*</span>
      </label>
      <select
        id="material"
        name="material"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      >
        {t.material.options.map(option => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
      <div id="material-error" class="text-red-600 text-sm mt-1 hidden"></div>
    </div>

    <!-- Quantity (Required) -->
    <div class="form-field">
      <label for="quantity" class="block text-sm font-medium text-gray-700 mb-1">
        {t.quantity.label}
        <span class="text-red-500 ml-1">*</span>
      </label>
      <div class="relative">
        <input
          type="number"
          id="quantity"
          name="quantity"
          required
          min="1"
          max="10000"
          placeholder={t.quantity.placeholder}
          class="w-full px-3 py-2 pr-12 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
        />
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
          <span class="text-gray-500 text-sm">{t.quantity.unit}</span>
        </div>
      </div>
      <div id="quantity-error" class="text-red-600 text-sm mt-1 hidden"></div>
      
      <!-- Quantity Helper Info -->
      <div class="mt-1 flex items-center space-x-4 text-xs text-gray-500">
        <span>{language === 'zh' ? '最小起订量: 1件' : 'Minimum order: 1 pcs'}</span>
        <span>{language === 'zh' ? '建议批量: 10-100件' : 'Suggested batch: 10-100 pcs'}</span>
      </div>
    </div>

    <!-- Special Requirements/Notes (Optional) -->
    <div class="form-field">
      <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">
        {t.notes.label}
      </label>
      <textarea
        id="notes"
        name="notes"
        rows="4"
        maxlength="1000"
        placeholder={t.notes.placeholder}
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 resize-vertical"
      ></textarea>
      <div class="mt-1 flex justify-between items-center">
        <div id="notes-error" class="text-red-600 text-sm hidden"></div>
        <div class="text-xs text-gray-500">
          <span id="notes-count">0</span>/1000 {language === 'zh' ? '字符' : 'characters'}
        </div>
      </div>
      
      <!-- Notes Helper Info -->
      <div class="mt-2 p-3 bg-blue-50 rounded-md">
        <p class="text-sm text-blue-800">
          <strong>{language === 'zh' ? '建议包含:' : 'Please include:'}</strong>
        </p>
        <ul class="text-xs text-blue-700 mt-1 space-y-1">
          <li>• {language === 'zh' ? '精度要求 (如: ±0.1mm)' : 'Precision requirements (e.g., ±0.1mm)'}</li>
          <li>• {language === 'zh' ? '表面处理 (如: 阳极氧化)' : 'Surface treatment (e.g., anodizing)'}</li>
          <li>• {language === 'zh' ? '交货时间要求' : 'Delivery time requirements'}</li>
          <li>• {language === 'zh' ? '特殊工艺需求' : 'Special processing requirements'}</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ language }}>
class ProductSpecValidator {
  constructor() {
    this.language = language;
    this.text = {
      zh: {
        materialRequired: '请选择材料',
        quantityRequired: '请输入数量',
        quantityInvalid: '数量必须为正整数',
        quantityMin: '数量至少为1',
        quantityMax: '数量不能超过10000',
        notesTooLong: '备注长度不能超过1000个字符'
      },
      en: {
        materialRequired: 'Please select a material',
        quantityRequired: 'Please enter quantity',
        quantityInvalid: 'Quantity must be a positive integer',
        quantityMin: 'Quantity must be at least 1',
        quantityMax: 'Quantity cannot exceed 10000',
        notesTooLong: 'Notes cannot exceed 1000 characters'
      }
    };
    this.t = this.text[this.language];
    this.initializeValidation();
  }

  initializeValidation() {
    const materialSelect = document.getElementById('material');
    const quantityInput = document.getElementById('quantity');
    const notesTextarea = document.getElementById('notes');

    if (materialSelect) {
      materialSelect.addEventListener('change', () => this.validateMaterial());
      materialSelect.addEventListener('focus', () => this.clearError('material'));
    }

    if (quantityInput) {
      quantityInput.addEventListener('blur', () => this.validateQuantity());
      quantityInput.addEventListener('input', () => this.clearError('quantity'));
    }

    if (notesTextarea) {
      notesTextarea.addEventListener('input', () => {
        this.updateNotesCount();
        this.validateNotes();
      });
      notesTextarea.addEventListener('blur', () => this.validateNotes());
    }

    // Initialize notes counter
    this.updateNotesCount();
  }

  validateMaterial() {
    const materialSelect = document.getElementById('material');
    const material = materialSelect?.value || '';
    
    if (!material) {
      this.showError('material', this.t.materialRequired);
      return false;
    }

    this.clearError('material');
    return true;
  }

  validateQuantity() {
    const quantityInput = document.getElementById('quantity');
    const quantity = quantityInput?.value || '';
    
    if (!quantity) {
      this.showError('quantity', this.t.quantityRequired);
      return false;
    }

    const quantityNum = parseInt(quantity, 10);
    
    if (isNaN(quantityNum) || quantityNum !== parseFloat(quantity)) {
      this.showError('quantity', this.t.quantityInvalid);
      return false;
    }

    if (quantityNum < 1) {
      this.showError('quantity', this.t.quantityMin);
      return false;
    }

    if (quantityNum > 10000) {
      this.showError('quantity', this.t.quantityMax);
      return false;
    }

    this.clearError('quantity');
    return true;
  }

  validateNotes() {
    const notesTextarea = document.getElementById('notes');
    const notes = notesTextarea?.value || '';
    
    if (notes.length > 1000) {
      this.showError('notes', this.t.notesTooLong);
      return false;
    }

    this.clearError('notes');
    return true;
  }

  updateNotesCount() {
    const notesTextarea = document.getElementById('notes');
    const notesCountEl = document.getElementById('notes-count');
    
    if (notesTextarea && notesCountEl) {
      const count = notesTextarea.value.length;
      notesCountEl.textContent = count;
      
      // Change color as approaching limit
      if (count > 900) {
        notesCountEl.classList.add('text-red-500');
        notesCountEl.classList.remove('text-yellow-500', 'text-gray-500');
      } else if (count > 750) {
        notesCountEl.classList.add('text-yellow-500');
        notesCountEl.classList.remove('text-red-500', 'text-gray-500');
      } else {
        notesCountEl.classList.add('text-gray-500');
        notesCountEl.classList.remove('text-red-500', 'text-yellow-500');
      }
    }
  }

  validateAll() {
    const materialValid = this.validateMaterial();
    const quantityValid = this.validateQuantity();
    const notesValid = this.validateNotes();
    
    return materialValid && quantityValid && notesValid;
  }

  showError(fieldId, message) {
    const errorElement = document.getElementById(`${fieldId}-error`);
    const inputElement = document.getElementById(fieldId);
    
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
    
    if (inputElement) {
      inputElement.classList.add('border-red-500');
      inputElement.classList.remove('border-gray-300');
    }
  }

  clearError(fieldId) {
    const errorElement = document.getElementById(`${fieldId}-error`);
    const inputElement = document.getElementById(fieldId);
    
    if (errorElement) {
      errorElement.classList.add('hidden');
    }
    
    if (inputElement) {
      inputElement.classList.remove('border-red-500');
      inputElement.classList.add('border-gray-300');
    }
  }

  getProductData() {
    return {
      material: document.getElementById('material')?.value || '',
      quantity: parseInt(document.getElementById('quantity')?.value || '0', 10),
      notes: document.getElementById('notes')?.value.trim() || ''
    };
  }
}

// Initialize product spec validator when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  window.productSpecValidator = new ProductSpecValidator();
});
</script>

<style>
.product-spec-section {
  @apply w-full;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  @apply ring-2 ring-indigo-500 ring-opacity-50;
}

.form-field input.border-red-500:focus,
.form-field select.border-red-500:focus,
.form-field textarea.border-red-500:focus {
  @apply ring-red-500;
}

/* Custom number input styling */
input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

input[type="number"] {
  -moz-appearance: textfield;
}
</style>