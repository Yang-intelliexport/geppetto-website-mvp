---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { paymentSuccessContent } from '../../../data/i18n/payment';
import type { Locale } from '../../../data/i18n/createQuote';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = paymentSuccessContent[locale];

const localized = (path: string) => `/${locale}${path}`;
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div class="min-h-screen bg-gradient-to-br from-green-50 to-blue-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-6">
          <span class="text-4xl">✅</span>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{content.hero.title}</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">{content.hero.subtitle}</p>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="border-l-4 border-green-500 pl-6">
              <h2 class="text-2xl font-semibold text-gray-900 mb-3">{locale === 'zh' ? '订单进度' : 'Order Status'}</h2>
              <div class="space-y-2 text-gray-600">
                {content.highlights.map((item) => (
                  <p>• {item}</p>
                ))}
              </div>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <h3 class="text-lg font-semibold text-blue-900 mb-2">{content.infoBox.title}</h3>
              <div class="text-blue-800 text-sm space-y-1">
                {content.infoBox.items.map((item) => (
                  <p>{item}</p>
                ))}
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="border border-gray-200 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">{locale === 'zh' ? '下一步操作' : 'Next Actions'}</h3>
              <div class="space-y-4">
                <a href={localized(content.actions.primary.href)} class="flex items-center justify-between w-full bg-gradient-to-r from-purple-600 to-blue-500 text-white font-semibold py-3 px-4 rounded-lg hover:from-purple-700 hover:to-blue-600 transition-colors">
                  <span>{content.actions.primary.label}</span>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
                <a href={localized(content.actions.secondary.href)} class="flex items-center justify-between w-full border border-gray-300 text-gray-700 font-medium py-3 px-4 rounded-lg hover:bg-gray-50 transition-colors">
                  <span>{content.actions.secondary.label}</span>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                </a>
              </div>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
              <h4 class="font-semibold text-gray-900 mb-2">{locale === 'zh' ? '需要帮助？' : 'Need Help?'}</h4>
              <div class="text-gray-600 text-sm space-y-1">
                {content.support.map((item) => (
                  <p>{item}</p>
                ))}
              </div>
            </div>
          </div>
        </div>

        {content.notice && (
          <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-yellow-600 mt-0.5 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h4 class="text-yellow-800 font-semibold mb-1">{content.notice.title}</h4>
                <p class="text-yellow-700 text-sm">{content.notice.description}</p>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
