---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TransparentPromise from '../../components/sections/TransparentPromise.astro';
import { transparentPricingContent, type Locale } from '../../data/i18n/transparentPricing';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = transparentPricingContent[locale];
const faqStructuredData = content.faqs?.length
  ? ({
      type: 'faq',
      data: {
        title: content.heroTitle,
        faqs: content.faqs
      }
    }) as const
  : undefined;

const articleStructuredData = {
  type: 'article',
  data: {
    title: content.heroTitle,
    description: content.metaDescription,
    url: Astro.url.href,
    image: `${import.meta.env.PUBLIC_SITE_URL || 'https://www.geppetto.studio'}/images/og-transparency.jpg`
  }
} as const;
---

<BaseLayout 
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  structuredData={faqStructuredData ?? articleStructuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-green-600 to-blue-700 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">
        {content.heroTitle}
      </h1>
      <p class="text-xl md:text-2xl max-w-4xl mx-auto opacity-90">
        {content.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Digital Twin Cards -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        {content.heroCards.map((card) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 bg-gradient-to-br from-white to-blue-50 shadow-sm">
            <div class="w-20 h-20 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl text-white">
              {card.icon}
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3 text-center">{card.title}</h3>
            <p class="text-gray-600 text-sm">
              {card.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TransparentPromise language={locale} />

  <!-- Crisis Section -->
  <section class="py-16 bg-red-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {content.crisisTitle}
        </h2>
        <p class="text-xl text-gray-600">
          {content.crisisSubtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        {content.crisisItems.map((item) => (
          <div class="bg-white rounded-2xl p-6 shadow">
            <h3 class="text-lg font-bold text-red-700 mb-3">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 border-l-4 border-red-500">
        <div class="grid md:grid-cols-3 gap-6">
          {content.crisisExample.map((example) => (
            <div>
              <h4 class="font-semibold text-gray-900 mb-1">{example.label}</h4>
              <div class="text-2xl font-bold text-red-600">{example.value}</div>
              <div class="text-sm text-gray-600">{example.note}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {content.comparisonTitle}
        </h2>
        <p class="text-xl text-gray-600">
          {content.comparisonSubtitle}
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  {locale === 'zh' ? '痛点' : 'Problem'}
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-green-600 uppercase tracking-wider">
                  {locale === 'zh' ? 'Geppetto 方案' : 'Geppetto Solution'}
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  {locale === 'zh' ? '传统做法' : 'Traditional Suppliers'}
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {content.comparisonRows.map((row) => (
                <tr>
                  <td class="px-6 py-4 text-sm text-gray-900">{row.problem}</td>
                  <td class="px-6 py-4 text-sm text-green-700">{row.solution}</td>
                  <td class="px-6 py-4 text-sm text-gray-500">{row.traditional}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {content.benefitTitle}
        </h2>
        <p class="text-xl text-gray-600">
          {content.benefitSubtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {content.benefitCards.map((card) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm text-center">
            <div class="text-4xl mb-4">{card.icon}</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{card.title}</h3>
            <p class="text-sm text-gray-600">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {content.faqs?.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm uppercase tracking-[0.3em] text-purple-500 mb-3">
            {locale === 'zh' ? '常见问题' : 'Frequently Asked Questions'}
          </p>
          <h2 class="text-3xl font-bold text-gray-900">
            {locale === 'zh' ? '透明定价如何落地？' : 'How our transparent pricing works'}
          </h2>
        </div>
        <div class="space-y-4">
          {content.faqs.map((faq) => (
            <details class="group bg-gray-50 rounded-2xl p-6">
              <summary class="flex items-center justify-between cursor-pointer text-lg font-semibold text-gray-900">
                {faq.question}
                <span class="text-purple-600 transition group-open:rotate-180">⌄</span>
              </summary>
              <p class="mt-4 text-gray-700 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-r from-purple-600 to-blue-500 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">
        {content.ctaTitle}
      </h2>
      <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
        {content.ctaSubtitle}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={content.primaryCta.href}
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors duration-200 shadow-lg text-lg"
        >
          {content.primaryCta.text}
        </a>
        {content.secondaryCta && (
          <a 
            href={content.secondaryCta.href}
            class="inline-flex items-center justify-center px-8 py-4 border border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors duration-200 text-lg"
          >
            {content.secondaryCta.text}
          </a>
        )}
      </div>
      
      <div class="mt-8 text-purple-100 text-sm">
        ✅ {locale === 'zh' ? '零隐藏费用 • 项目定制精度 • 专家全程陪伴' : 'Zero hidden fees • Project-specific precision • Dedicated expert support'}
      </div>
    </div>
  </section>
</BaseLayout>
