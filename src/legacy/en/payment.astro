---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Payment | Secure Payment Processing | Geppetto Manufacturing"
  description="Secure and flexible payment options for your CNC manufacturing orders. Multiple payment methods accepted with industry-standard security."
>
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
            <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">💳 Secure Payment</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Complete your order with our secure payment processing. Multiple payment methods available.
        </p>
      </div>

      <!-- Payment Options -->
      <div class="bg-white rounded-2xl shadow-sm p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Payment Methods</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <!-- Credit Card -->
          <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-blue-500 transition-colors cursor-pointer">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Credit/Debit Card</h3>
                <p class="text-sm text-gray-600">Visa, Mastercard, American Express</p>
              </div>
            </div>
            <p class="text-sm text-gray-600">Secure SSL encrypted payment processing</p>
          </div>

          <!-- Bank Transfer -->
          <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-blue-500 transition-colors cursor-pointer">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5,6H23V18H5V6M14,9A3,3 0 0,1 17,12A3,3 0 0,1 14,15A3,3 0 0,1 11,12A3,3 0 0,1 14,9M9,8A2,2 0 0,1 7,10V14A2,2 0 0,1 9,16H19A2,2 0 0,1 21,14V10A2,2 0 0,1 19,8H9Z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Bank Transfer</h3>
                <p class="text-sm text-gray-600">Wire transfer for larger orders</p>
              </div>
            </div>
            <p class="text-sm text-gray-600">Direct bank-to-bank transfer</p>
          </div>

          <!-- PayPal -->
          <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-blue-500 transition-colors cursor-pointer">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <span class="text-blue-600 font-bold text-sm">PP</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">PayPal</h3>
                <p class="text-sm text-gray-600">Pay with your PayPal account</p>
              </div>
            </div>
            <p class="text-sm text-gray-600">Quick and secure PayPal checkout</p>
          </div>

          <!-- Terms Payment -->
          <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-blue-500 transition-colors cursor-pointer">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Net 30 Terms</h3>
                <p class="text-sm text-gray-600">For established customers</p>
              </div>
            </div>
            <p class="text-sm text-gray-600">Payment due within 30 days of invoice</p>
          </div>
        </div>
      </div>

      <!-- Security Information -->
      <div class="bg-blue-50 rounded-2xl p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 text-blue-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Security & Protection
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-start space-x-3">
            <div class="w-3 h-3 bg-blue-500 rounded-full mt-2"></div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">SSL Encryption</h3>
              <p class="text-sm text-gray-600">256-bit SSL encryption protects your payment data</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-3">
            <div class="w-3 h-3 bg-blue-500 rounded-full mt-2"></div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">PCI Compliance</h3>
              <p class="text-sm text-gray-600">PCI DSS compliant payment processing</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-3">
            <div class="w-3 h-3 bg-blue-500 rounded-full mt-2"></div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Fraud Protection</h3>
              <p class="text-sm text-gray-600">Advanced fraud detection and prevention</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-3">
            <div class="w-3 h-3 bg-blue-500 rounded-full mt-2"></div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Data Privacy</h3>
              <p class="text-sm text-gray-600">We never store your payment information</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Terms -->
      <div class="bg-white rounded-2xl shadow-sm p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Payment Terms & Conditions</h2>
        
        <div class="space-y-4 text-gray-700">
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Payment Schedule</h3>
            <ul class="space-y-2 text-sm">
              <li>• 50% deposit required to start production</li>
              <li>• Remaining 50% due upon completion before shipping</li>
              <li>• Rush orders require 100% payment upfront</li>
            </ul>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Currency</h3>
            <p class="text-sm">All prices are quoted in USD. International orders may be subject to currency conversion fees.</p>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Refund Policy</h3>
            <p class="text-sm">Deposits are refundable if we cannot meet agreed specifications. Completed work is non-refundable unless there are quality defects.</p>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Late Payments</h3>
            <p class="text-sm">Late payments may be subject to a 1.5% monthly service charge. Orders may be held pending payment resolution.</p>
          </div>
        </div>
      </div>

      <!-- Contact Support -->
      <div class="bg-gray-100 rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-semibold text-gray-900 mb-4">Need Help with Payment?</h2>
        <p class="text-gray-600 mb-6">
          Our payment specialists are here to assist you with any questions or special requirements.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/en/contact" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
            Contact Support
          </a>
          <a href="mailto:billing@geppetto.studio" class="border-2 border-blue-600 text-blue-600 px-6 py-3 rounded-lg hover:bg-blue-50 transition-colors">
            billing@geppetto.studio
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>