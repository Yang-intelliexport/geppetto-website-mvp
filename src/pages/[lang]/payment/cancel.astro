---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { paymentCancelContent } from '../../../data/i18n/payment';
import type { Locale } from '../../../data/i18n/createQuote';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = paymentCancelContent[locale];

const url = new URL(Astro.request.url);
const quoteId = url.searchParams.get('quote_id') || url.searchParams.get('session_id');
const retryHref = quoteId ? `/${locale}/order/${quoteId}/payment` : null;
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-orange-100 rounded-full mb-6">
          <span class="text-4xl">⏸️</span>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{content.hero.title}</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">{content.hero.subtitle}</p>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="border-l-4 border-orange-500 pl-6">
              <h2 class="text-2xl font-semibold text-gray-900 mb-3">{locale === 'zh' ? '当前状态' : 'Current Status'}</h2>
              <div class="space-y-2 text-gray-600">
                {content.highlights.map((item) => (
                  <p>• {item}</p>
                ))}
              </div>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <h3 class="text-lg font-semibold text-blue-900 mb-2">{content.infoBox.title}</h3>
              <div class="text-blue-800 text-sm space-y-1">
                {content.infoBox.items.map((item) => (
                  <p>{item}</p>
                ))}
              </div>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
              <h4 class="font-semibold text-gray-900 mb-2">{locale === 'zh' ? '需要帮助？' : 'Need Support?'}</h4>
              <div class="text-gray-600 text-sm space-y-1">
                {content.support.map((item) => (
                  <p>{item}</p>
                ))}
              </div>
            </div>
          </div>

          <div class="space-y-6">
            {retryHref && content.retryButtonLabel && (
              <a href={retryHref} class="flex items-center justify-between w/full bg-gradient-to-r from-purple-600 to-blue-500 text-white font-semibold py-3 px-4 rounded-lg hover:from-purple-700 hover:to-blue-600 transition-colors">
                <span>{content.retryButtonLabel}</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </a>
            )}

            {content.retryDescription && <p class="text-sm text-gray-600">{content.retryDescription}</p>}

            <div class="border border-gray-200 rounded-lg p-6 space-y-4">
              <a href={`/${locale}${content.actions.primary.href}`} class="flex items-center justify-between w-full border border-purple-300 text-purple-700 font-medium py-3 px-4 rounded-lg hover:bg-purple-50 transition-colors">
                <span>{content.actions.primary.label}</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
              <a href={`/${locale}${content.actions.secondary.href}`} class="flex items-center justify-between w-full border border-gray-300 text-gray-700 font-medium py-3 px-4 rounded-lg hover:bg-gray-50 transition-colors">
                <span>{content.actions.secondary.label}</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
