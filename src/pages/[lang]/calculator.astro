---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostCalculatorWidget from '../../components/islands/CostCalculatorWidget.astro';
import { calculatorContent, type Locale } from '../../data/i18n/calculator';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = calculatorContent[locale];
---

<BaseLayout 
  title={content.metaTitle}
  description={content.metaDescription}
>
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-bold mb-6">
            {content.heroTitle}
          </h1>
          <p class="text-2xl text-blue-100 mb-8">
            {content.heroSubtitle}
          </p>
          
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {content.heroStats.map((stat) => (
                <div class="text-center">
                  <div class="text-3xl font-bold text-yellow-300 mb-2">{stat.value}</div>
                  <div class="text-sm text-blue-200">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Calculator -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="max-w-7xl mx-auto">
          <CostCalculatorWidget />
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            {locale === 'zh' ? '为什么选择我们的成本计算器？' : 'Why Use Our Calculator?'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {locale === 'zh'
              ? '智能算法提供准确预估，支持多种材料和工艺'
              : 'Use the calculator for quick estimates, then upgrade to precise AI quotes.'}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {content.features.map((feature) => (
            <div class="text-center p-6">
              <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                {feature.icon}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            {locale === 'zh' ? '常见问题' : 'Frequently Asked Questions'}
          </h2>
        </div>
        
        <div class="space-y-6">
          {content.faq.map((item) => (
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{item.question}</h3>
              <p class="text-gray-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-r from-purple-600 to-blue-500 text-white" transition:name="cta-section" transition:animate="slide">
      <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-6">
          {content.cta.title}
        </h2>
        <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
          {content.cta.subtitle}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href={content.cta.primary.href} 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors duration-200 shadow-lg"
          >
            {content.cta.primary.text}
          </a>
          <a 
            href={content.cta.secondary.href} 
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text白 font-semibold rounded-lg hover:bg白 hover:text-purple-600 transition-colors duration-200"
          >
            {content.cta.secondary.text}
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
