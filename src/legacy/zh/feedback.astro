---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="客户反馈 - 帮助我们改进服务 | Geppetto智能制造"
  description="您的宝贵意见是我们改进服务的动力。请分享您对我们CNC制造和报价服务的使用体验。"
  keywords={[
    "客户反馈", "服务改进", "用户体验", "CNC制造反馈",
    "报价服务评价", "制造质量评价", "客户满意度", "建议意见"
  ]}
  ogImage="/images/og-feedback-zh.jpg"
>
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
            <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">💬 分享您的宝贵意见</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          您的反馈是我们持续改进服务的重要动力。请花几分钟时间告诉我们您的使用体验。
        </p>
      </div>

      <!-- Feedback Form -->
      <div class="bg-white rounded-2xl shadow-sm p-8">
        <form id="feedback-form" class="space-y-8">
          <!-- Service Rating -->
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 mb-6">📊 整体评价</h2>
            
            <div class="space-y-6">
              <!-- Overall Satisfaction -->
              <div>
                <label class="block text-lg font-medium text-gray-700 mb-4">整体满意度</label>
                <div class="flex items-center space-x-2" id="overall-rating">
                  <span class="text-sm text-gray-600 mr-2">非常不满意</span>
                  <div class="flex space-x-1">
                    <button type="button" class="rating-star text-2xl text-gray-300 hover:text-yellow-400" data-rating="1">⭐</button>
                    <button type="button" class="rating-star text-2xl text-gray-300 hover:text-yellow-400" data-rating="2">⭐</button>
                    <button type="button" class="rating-star text-2xl text-gray-300 hover:text-yellow-400" data-rating="3">⭐</button>
                    <button type="button" class="rating-star text-2xl text-gray-300 hover:text-yellow-400" data-rating="4">⭐</button>
                    <button type="button" class="rating-star text-2xl text-gray-300 hover:text-yellow-400" data-rating="5">⭐</button>
                  </div>
                  <span class="text-sm text-gray-600 ml-2">非常满意</span>
                </div>
                <input type="hidden" name="overall_rating" id="overall_rating_value" value="">
              </div>

              <!-- Service Aspects -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block font-medium text-gray-700 mb-2">报价速度</label>
                  <select name="quote_speed" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                    <option value="">请选择</option>
                    <option value="5">非常快</option>
                    <option value="4">较快</option>
                    <option value="3">一般</option>
                    <option value="2">较慢</option>
                    <option value="1">很慢</option>
                  </select>
                </div>

                <div>
                  <label class="block font-medium text-gray-700 mb-2">价格合理性</label>
                  <select name="price_reasonableness" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                    <option value="">请选择</option>
                    <option value="5">非常合理</option>
                    <option value="4">较合理</option>
                    <option value="3">一般</option>
                    <option value="2">偏高</option>
                    <option value="1">很高</option>
                  </select>
                </div>

                <div>
                  <label class="block font-medium text-gray-700 mb-2">专业程度</label>
                  <select name="professionalism" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                    <option value="">请选择</option>
                    <option value="5">非常专业</option>
                    <option value="4">较专业</option>
                    <option value="3">一般</option>
                    <option value="2">不够专业</option>
                    <option value="1">很不专业</option>
                  </select>
                </div>

                <div>
                  <label class="block font-medium text-gray-700 mb-2">沟通响应</label>
                  <select name="communication" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                    <option value="">请选择</option>
                    <option value="5">非常及时</option>
                    <option value="4">较及时</option>
                    <option value="3">一般</option>
                    <option value="2">较慢</option>
                    <option value="1">很慢</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Service Used -->
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 mb-4">🔧 您使用的服务</h2>
            <div class="space-y-3">
              <label class="flex items-center">
                <input type="checkbox" name="services" value="instant_quote" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                <span class="ml-3 text-gray-700">8小时详细报价服务</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="services" value="optimized_quote" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                <span class="ml-3 text-gray-700">专家优化报价</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="services" value="cnc_manufacturing" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                <span class="ml-3 text-gray-700">CNC制造服务</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="services" value="customer_support" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                <span class="ml-3 text-gray-700">客户支持服务</span>
              </label>
            </div>
          </div>

          <!-- Comments -->
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 mb-4">💭 详细反馈</h2>
            <div class="space-y-4">
              <div>
                <label class="block font-medium text-gray-700 mb-2">最满意的方面</label>
                <textarea 
                  name="most_satisfied"
                  rows="3" 
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="请告诉我们您最满意的服务方面..."
                ></textarea>
              </div>

              <div>
                <label class="block font-medium text-gray-700 mb-2">需要改进的方面</label>
                <textarea 
                  name="needs_improvement"
                  rows="3" 
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="请告诉我们需要改进的地方..."
                ></textarea>
              </div>

              <div>
                <label class="block font-medium text-gray-700 mb-2">其他建议</label>
                <textarea 
                  name="additional_comments"
                  rows="4" 
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="任何其他建议或意见..."
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Contact Info (Optional) -->
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 mb-4">📧 联系信息（可选）</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-gray-700 mb-2">您的姓名</label>
                <input 
                  type="text" 
                  name="customer_name"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="可选填写"
                >
              </div>
              <div>
                <label class="block font-medium text-gray-700 mb-2">邮箱地址</label>
                <input 
                  type="email" 
                  name="customer_email"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                  placeholder="可选填写"
                >
              </div>
            </div>
            <div class="mt-2">
              <label class="flex items-center">
                <input type="checkbox" name="allow_follow_up" value="yes" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                <span class="ml-3 text-sm text-gray-600">允许我们就您的反馈进行后续沟通</span>
              </label>
            </div>
          </div>

          <!-- Recommendation -->
          <div>
            <h2 class="text-2xl font-semibold text-gray-900 mb-4">👥 推荐意愿</h2>
            <div class="bg-blue-50 p-4 rounded-lg">
              <p class="text-gray-700 mb-3">您是否愿意向朋友或同事推荐我们的服务？</p>
              <div class="space-y-2">
                <label class="flex items-center">
                  <input type="radio" name="recommendation" value="definitely" class="h-4 w-4 text-purple-600 border-gray-300 focus:ring-purple-500">
                  <span class="ml-3 text-gray-700">非常愿意</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="recommendation" value="probably" class="h-4 w-4 text-purple-600 border-gray-300 focus:ring-purple-500">
                  <span class="ml-3 text-gray-700">可能会</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="recommendation" value="neutral" class="h-4 w-4 text-purple-600 border-gray-300 focus:ring-purple-500">
                  <span class="ml-3 text-gray-700">不确定</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="recommendation" value="unlikely" class="h-4 w-4 text-purple-600 border-gray-300 focus:ring-purple-500">
                  <span class="ml-3 text-gray-700">不太可能</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="recommendation" value="never" class="h-4 w-4 text-purple-600 border-gray-300 focus:ring-purple-500">
                  <span class="ml-3 text-gray-700">绝对不会</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="text-center pt-6">
            <button 
              type="submit" 
              class="bg-purple-600 text-white py-3 px-8 rounded-lg hover:bg-purple-700 font-semibold text-lg transition-colors disabled:opacity-50"
              id="submit-btn"
            >
              🚀 提交反馈
            </button>
          </div>
        </form>
      </div>

      <!-- Thank You Message (Hidden initially) -->
      <div id="thank-you-message" class="bg-green-50 border border-green-200 rounded-lg p-8 text-center hidden">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-green-900 mb-2">🎉 感谢您的反馈！</h2>
        <p class="text-green-800 mb-4">
          您的宝贵意见已经收到。我们会认真考虑每一条建议，持续改进我们的服务。
        </p>
        <div class="bg-white p-4 rounded-lg border border-green-200">
          <p class="text-sm text-gray-600">
            如果您允许后续沟通，我们的客服团队可能会在48小时内与您联系，进一步了解您的需求。
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Rating system
    document.addEventListener('DOMContentLoaded', function() {
      const ratingStars = document.querySelectorAll('.rating-star');
      const ratingInput = document.getElementById('overall_rating_value');
      
      ratingStars.forEach(star => {
        star.addEventListener('click', function(e) {
          e.preventDefault();
          const rating = this.dataset.rating;
          ratingInput.value = rating;
          
          // Update visual feedback
          ratingStars.forEach((s, index) => {
            if (index < rating) {
              s.classList.remove('text-gray-300');
              s.classList.add('text-yellow-400');
            } else {
              s.classList.remove('text-yellow-400');
              s.classList.add('text-gray-300');
            }
          });
        });
      });
    });
    
    // Form submission
    document.getElementById('feedback-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const submitBtn = document.getElementById('submit-btn');
      const originalText = submitBtn.textContent;
      
      // Show loading state
      submitBtn.disabled = true;
      submitBtn.textContent = '⏳ 提交中...';
      
      try {
        // Collect form data
        const formData = new FormData(this);
        const feedbackData = {};
        
        // Convert FormData to object
        for (let [key, value] of formData.entries()) {
          if (feedbackData[key]) {
            // Handle multiple values (like checkboxes)
            if (Array.isArray(feedbackData[key])) {
              feedbackData[key].push(value);
            } else {
              feedbackData[key] = [feedbackData[key], value];
            }
          } else {
            feedbackData[key] = value;
          }
        }
        
        // Add timestamp
        feedbackData.submitted_at = new Date().toISOString();
        feedbackData.language = 'zh';
        
        // Submit feedback
        const response = await fetch('/api/customer-feedback', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(feedbackData)
        });
        
        if (response.ok) {
          // Show success message
          document.querySelector('.bg-white.rounded-2xl').style.display = 'none';
          document.getElementById('thank-you-message').classList.remove('hidden');
          
          // Scroll to thank you message
          document.getElementById('thank-you-message').scrollIntoView({
            behavior: 'smooth'
          });
        } else {
          throw new Error('提交失败');
        }
        
      } catch (error) {
        alert('提交失败，请稍后重试：' + error.message);
        console.error('Feedback submission error:', error);
      } finally {
        // Restore button state
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  </script>
</BaseLayout>