---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustIndicators from '../../components/sections/TrustIndicators.astro';
import TransparentPromise from '../../components/sections/TransparentPromise.astro';
import { whyGeppettoContent, type Locale } from '../../data/i18n/whyGeppetto';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const content = whyGeppettoContent[locale];
---

<BaseLayout 
  title={content.metaTitle}
  description={content.metaDescription}
>
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800 text-white py-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-bold mb-6">{content.heroTitle}</h1>
          <p class="text-2xl text-blue-100 mb-8">{content.heroSubtitle}</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
            {content.heroStats.map((stat) => (
              <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                <div class="text-3xl font-bold text-yellow-300 mb-2">{stat.value}</div>
                <div class="text-lg">{stat.label}</div>
                <div class="text-sm text-blue-200 whitespace-pre-line">{stat.description}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <TransparentPromise language={locale} />

    <!-- Advantages -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">
            {locale === 'zh' ? '核心竞争优势' : 'Our Competitive Advantages'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {locale === 'zh'
              ? 'Geppetto 如何在关键指标全面超越传统制造供应商'
              : 'See how Geppetto outperforms traditional suppliers across every metric'}
          </p>
        </div>
        
        <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
          <div>
            <h3 class="text-3xl font-bold text-gray-900 mb-6">
              {locale === 'zh' ? 'AI驱动速度革命' : '🚀 Smart Flexible Speed Revolution'}
            </h3>
            <div class="space-y-6">
              {content.advantages.map((advantage) => (
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center font-bold flex-shrink-0 text-xs">
                    {advantage.badge}
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-gray-900 mb-2">{advantage.title}</h4>
                    <p class="text-gray-600">{advantage.description}</p>
                    <ul class="mt-2 space-y-1 text-sm text-gray-600">
                      {advantage.bullets.map((bullet) => (
                        <li>• {bullet}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-2xl p-8">
            <h4 class="text-2xl font-bold text-gray-900 mb-6 text-center">
              {locale === 'zh' ? '速度与效率对比' : 'Speed Comparison'}
            </h4>
            <div class="space-y-4">
              {content.costComparison.map((row) => (
                <div class="flex justify-between items-center py-3 border-b border-gray-200">
                  <span class="font-medium text-gray-700">{row.metric}</span>
                  <div class="flex items-center space-x-4">
                    <span class="text-green-600 font-bold">{row.ours}</span>
                    <span class="text-gray-400">vs</span>
                    <span class="text-red-600">{row.traditional}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <TrustIndicators />

    <!-- Flow -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-6">
            {locale === 'zh' ? '透明制造流程' : 'Our Transparent Manufacturing Flow'}
          </h2>
          <p class="text-xl text-gray-600">
            {locale === 'zh'
              ? '每一步皆可追溯、可验证、可承诺'
              : 'Every step is traceable, verifiable, and accountable'}
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-6">
          {content.flowSteps.map((step, index) => (
            <div class="bg-white rounded-2xl p-6 shadow-md text-center">
              <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                {step.icon}
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-gray-600 text-sm">{step.description}</p>
              <div class="mt-4 text-xs text-gray-400">
                {locale === 'zh' ? `步骤 ${index + 1}` : `Step ${index + 1}`}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-r from-purple-900 to-blue-900 text-white">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold mb-6">
          {content.cta.title}
        </h2>
        <p class="text-xl text-blue-100 mb-8">
          {content.cta.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
          <a href={content.cta.primary.href} class="bg-gradient-to-r from-green-400 to-blue-500 text-white px-10 py-4 rounded-full text-xl font-bold hover:from-green-300 hover:to-blue-400 transform hover:scale-105 transition-all duration-300 shadow-2xl">
            {content.cta.primary.text}
          </a>
          <a href={content.cta.secondary.href} class="border-2 border-white text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-purple-900 transition-all duration-300">
            {content.cta.secondary.text}
          </a>
        </div>
        <div class="mt-8 text-blue-100 text-sm">
          {content.cta.highlights.join(' • ')}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
