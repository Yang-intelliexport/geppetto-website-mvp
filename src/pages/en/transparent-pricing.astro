---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout 
  title="Transparent CNC Pricing | Digital Twin Analysis | Zero Hidden Fees | Geppetto"
  description="Professional manufacturing service packages: comprehensive value assessment, real-time digital twin analysis, zero hidden fees. Complete service transparency with expert validation."
  keywords={['transparent manufacturing pricing', 'transparent CNC pricing', 'digital twin costing', 'manufacturing cost breakdown', 'zero hidden fees', 'real-time pricing', 'accurate CNC quotes', 'manufacturing transparency', 'cost analysis', 'precision pricing', 'detailed quote breakdown', 'manufacturing cost visibility']}
  ogImage="/images/og-transparent-pricing.jpg"
  structuredData={{
    type: 'service',
    data: {
      '@type': 'Service',
      'name': 'Professional Manufacturing Service',
      'description': 'Professional manufacturing service packages with digital twin analysis and zero hidden fees.',
      'provider': {
        '@type': 'Organization',
        'name': 'Geppetto Technologies'
      },
      'serviceType': 'Manufacturing',
      'areaServed': 'Global',
      'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Transparent Pricing Services',
        'itemListElement': [
          {
            '@type': 'Offer',
            'itemOffered': {
              '@type': 'Service',
              'name': 'Digital Twin Cost Analysis'
            }
          },
          {
            '@type': 'Offer',
            'itemOffered': {
              '@type': 'Service',
              'name': 'Real-Time Production Dashboard'
            }
          },
          {
            '@type': 'Offer',
            'itemOffered': {
              '@type': 'Service',
              'name': 'Detailed Cost Breakdown'
            }
          }
        ]
      }
    }
  }}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-green-600 to-blue-700 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          🔍 Transparent Manufacturing Through Digital Intelligence
        </h1>
        <p class="text-xl md:text-2xl max-w-4xl mx-auto opacity-90">
          Our flexible factory's digital foundation enables unprecedented transparency
        </p>
      </div>
      
      <!-- Transparency Promise -->
      <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 mb-8 max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-center mb-8">
          How Our Digital Twin Creates Pricing Transparency
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-white">🧠</span>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3 text-white">AI Analysis</h4>
            <p class="text-gray-300 text-sm">
              Digital twin simulates your part manufacturing in virtual environment, 
              calculating precise material usage, machining time, and tool wear.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-white">📊</span>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3 text-white">Real-Time Costing</h4>
            <p class="text-gray-300 text-sm">
              Live connection to material prices, machine rates, and process optimization 
              provides accurate costs without guesswork or padding.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-20 h-20 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-white">📱</span>
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3 text-white">Live Dashboard</h4>
            <p class="text-gray-300 text-sm">
              Track your part's progress in real-time through our flexible factory. 
              See exactly where your project stands at any moment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Pricing Problem -->
  <section class="py-16 bg-red-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          🚨 The Manufacturing Pricing Crisis
        </h2>
        <p class="text-xl text-gray-600">
          Why traditional manufacturing quotes leave customers confused and frustrated
        </p>
      </div>

      <!-- Real Problem Example -->
      <div class="bg-white rounded-3xl shadow-xl p-8 mb-12 border-l-4 border-red-500">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-2xl font-bold text-red-700 mb-4">Real Customer Experience</h3>
            <div class="space-y-4">
              <div class="flex items-start">
                <span class="text-red-500 text-lg mr-3">📐</span>
                <div>
                  <h4 class="font-semibold text-gray-900">SolidWorks Costing Estimate</h4>
                  <p class="text-gray-600 text-sm">Simple aluminum bracket: $180</p>
                </div>
              </div>
              <div class="flex items-start">
                <span class="text-red-500 text-lg mr-3">😱</span>
                <div>
                  <h4 class="font-semibold text-gray-900">Actual Manufacturing Quote</h4>
                  <p class="text-gray-600 text-sm">Same part from traditional supplier: $3,500</p>
                </div>
              </div>
              <div class="flex items-start">
                <span class="text-red-500 text-lg mr-3">❓</span>
                <div>
                  <h4 class="font-semibold text-gray-900">The Gap</h4>
                  <p class="text-red-600 font-bold">19x price difference with no explanation</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-red-100 rounded-2xl p-6">
            <h4 class="text-lg font-bold text-red-700 mb-4">Common Hidden Costs</h4>
            <ul class="space-y-2 text-red-600 text-sm">
              <li>• Setup fees: $200-500</li>
              <li>• Tooling charges: $300-800</li>
              <li>• Rush fees: 25-50% markup</li>
              <li>• Engineering time: $150/hour</li>
              <li>• Material handling: 15-20%</li>
              <li>• Quality inspection: $50-200</li>
              <li>• "Miscellaneous" fees: $100-300</li>
            </ul>
            <div class="mt-4 p-3 bg-white rounded-lg border-l-2 border-red-500">
              <p class="text-xs text-gray-700 font-medium">
                Result: Total project cost can be 5-20x higher than expected
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Transparent Solution -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          ✨ Our Transparent Factory Solution
        </h2>
        <p class="text-xl text-gray-600">
          Digital twin technology delivers unprecedented cost transparency
        </p>
      </div>

      <!-- Transparent vs Traditional Comparison -->
      <div class="bg-white rounded-2xl shadow-xl p-8 mb-12">
        <h3 class="text-2xl font-bold text-center text-gray-900 mb-8">
          Traditional "Black Box" vs Our Transparent Factory
        </h3>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-red-50 rounded-xl p-6 border-l-4 border-red-500">
            <h4 class="text-lg font-bold text-red-700 mb-4">❌ Traditional Manufacturing</h4>
            <ul class="space-y-2 text-red-600 text-sm">
              <li>• "We'll get back to you in 3-7 days"</li>
              <li>• Quote ranges from $180 to $3,500</li>
              <li>• Hidden fees discovered during production</li>
              <li>• No visibility into progress</li>
              <li>• Manual estimation with large margins</li>
              <li>• "Trust us, this is the market price"</li>
              <li>• Last-minute cost surprises</li>
            </ul>
          </div>
          
          <div class="bg-green-50 rounded-xl p-6 border-l-4 border-green-500">
            <h4 class="text-lg font-bold text-green-700 mb-4">✅ Our Flexible Factory</h4>
            <ul class="space-y-2 text-green-600 text-sm">
              <li>• Detailed quote within 8 hours with expert review</li>
              <li>• Precise cost breakdown: $247.50 (see itemization)</li>
              <li>• Zero hidden fees guarantee</li>
              <li>• Real-time production dashboard</li>
              <li>• Digital twin simulation accuracy 95%+</li>
              <li>• Complete cost transparency</li>
              <li>• Price locked until production completion</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Detailed Cost Breakdown Example -->
      <div class="bg-gradient-to-br from-blue-50 to-green-50 rounded-3xl p-8">
        <h3 class="text-2xl font-bold text-center text-gray-900 mb-8">
          📋 Sample Transparent Quote Breakdown
        </h3>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <h4 class="text-lg font-bold text-gray-900 mb-4">Part: Aluminum Mounting Bracket</h4>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">Material (6061-T6 Aluminum)</span>
                <span class="font-medium">$45.20</span>
              </div>
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">CNC Machining (2.3 hours)</span>
                <span class="font-medium">$138.00</span>
              </div>
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">Surface Treatment (Anodizing)</span>
                <span class="font-medium">$25.80</span>
              </div>
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">Quality Inspection</span>
                <span class="font-medium">$18.50</span>
              </div>
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">Packaging & Handling</span>
                <span class="font-medium">$12.00</span>
              </div>
              <div class="flex justify-between border-b pb-2">
                <span class="text-gray-600">Shipping (Standard)</span>
                <span class="font-medium">$8.00</span>
              </div>
              <div class="flex justify-between text-lg font-bold text-green-600 pt-2">
                <span>Total</span>
                <span>$247.50</span>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="bg-white rounded-xl p-4 shadow">
              <h5 class="font-bold text-gray-900 mb-2">🎯 Transparency Benefits</h5>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• No surprise costs</li>
                <li>• Understand value for money</li>
                <li>• Budget with confidence</li>
                <li>• Compare options clearly</li>
              </ul>
            </div>

            <div class="bg-white rounded-xl p-4 shadow">
              <h5 class="font-bold text-gray-900 mb-2">⚡ Speed Benefits</h5>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• 8-hour expert review</li>
                <li>• Digital twin accuracy</li>
                <li>• Real-time price updates</li>
                <li>• Instant design modifications</li>
              </ul>
            </div>

            <div class="bg-white rounded-xl p-4 shadow">
              <h5 class="font-bold text-gray-900 mb-2">🔒 Guarantee</h5>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• Price locked once confirmed</li>
                <li>• Zero hidden fees policy</li>
                <li>• Quality guarantee included</li>
                <li>• Real-time progress tracking</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Transparency Dashboard -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          📱 Real-Time Production Dashboard
        </h2>
        <p class="text-xl text-gray-600">
          Track your part's journey through our flexible factory
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8">
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">📊</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Live Cost Tracking</h3>
            <p class="text-gray-600 text-sm">
              Monitor actual vs. quoted costs in real-time. Any changes explained instantly.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">⏱️</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Production Progress</h3>
            <p class="text-gray-600 text-sm">
              See exactly which station your part is at and estimated completion time.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">✅</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Quality Checkpoints</h3>
            <p class="text-gray-600 text-sm">
              Real-time quality measurements and inspection results at each stage.
            </p>
          </div>
        </div>

        <!-- Mock Dashboard -->
        <div class="bg-gray-50 rounded-2xl p-6">
          <h4 class="text-lg font-bold text-gray-900 mb-4">Sample Production Dashboard</h4>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h5 class="font-medium text-gray-900 mb-3">Production Status</h5>
              <div class="space-y-2">
                <div class="flex items-center">
                  <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                  <span class="text-sm text-gray-600">Material Preparation - Complete</span>
                </div>
                <div class="flex items-center">
                  <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                  <span class="text-sm text-gray-600">CNC Machining - Complete</span>
                </div>
                <div class="flex items-center">
                  <span class="w-3 h-3 bg-blue-500 rounded-full mr-2 animate-pulse"></span>
                  <span class="text-sm text-gray-900 font-medium">Surface Treatment - In Progress (2h remaining)</span>
                </div>
                <div class="flex items-center">
                  <span class="w-3 h-3 bg-gray-300 rounded-full mr-2"></span>
                  <span class="text-sm text-gray-400">Quality Inspection - Pending</span>
                </div>
              </div>
            </div>

            <div>
              <h5 class="font-medium text-gray-900 mb-3">Cost Tracking</h5>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Quoted Total:</span>
                  <span class="font-medium">$247.50</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Actual Current:</span>
                  <span class="font-medium text-green-600">$245.20</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Variance:</span>
                  <span class="font-medium text-green-600">-$2.30 (0.9%)</span>
                </div>
                <div class="text-xs text-gray-500 mt-2">
                  *Savings due to optimized machining time
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Success with Transparency -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          🎯 Transparency Success Stories
        </h2>
        <p class="text-xl text-gray-600">
          How clear pricing transformed our customers' experience
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Case Study 1 -->
        <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Electronics Startup Saves $10K</h3>
          <div class="space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Traditional Quote:</span>
              <span class="font-medium">$15,500 (range: $12K-18K)</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Our Transparent Quote:</span>
              <span class="font-medium text-green-600">$5,750 (detailed breakdown)</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Actual Final Cost:</span>
              <span class="font-medium text-green-600">$5,680 (-$70)</span>
            </div>
            <div class="flex justify-between text-sm font-bold">
              <span class="text-gray-900">Total Savings:</span>
              <span class="text-green-600">$9,820 (63%)</span>
            </div>
          </div>
          <div class="mt-4 p-3 bg-white rounded-lg">
            <p class="text-xs text-gray-700 italic">
              "For the first time, I understood exactly what I was paying for. 
              The savings let us fund another prototype iteration."
            </p>
            <p class="text-xs text-gray-500 mt-1">- Mike Chen, Hardware Startup</p>
          </div>
        </div>

        <!-- Case Study 2 -->
        <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Robotics Company Eliminates Surprises</h3>
          <div class="space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Previous Experience:</span>
              <span class="font-medium">3 surprise cost increases</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Final vs. Initial Quote:</span>
              <span class="font-medium text-red-600">+142% over budget</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">With Our System:</span>
              <span class="font-medium text-green-600">Zero cost surprises</span>
            </div>
            <div class="flex justify-between text-sm font-bold">
              <span class="text-gray-900">Final Variance:</span>
              <span class="text-green-600">-2.1% (under budget)</span>
            </div>
          </div>
          <div class="mt-4 p-3 bg-white rounded-lg">
            <p class="text-xs text-gray-700 italic">
              "Budget confidence changed everything. We could plan multiple iterations 
              knowing exactly what each would cost."
            </p>
            <p class="text-xs text-gray-500 mt-1">- Dr. Sarah Kim, Robotics Engineer</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-green-600 to-blue-700 text-white">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">
        Experience True Manufacturing Transparency
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Get detailed cost breakdown within 8 hours. Zero hidden fees guaranteed.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/en/create-quote" 
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-green-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors duration-200 shadow-lg"
        >
          💎 Get Transparent Quote
        </a>
        <a 
          href="/en/contact" 
          class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-green-600 transition-colors duration-200"
        >
          📊 See Sample Breakdown
        </a>
      </div>
      
      <div class="mt-8 text-green-100 text-sm">
        🔒 Price Locked Once Confirmed • 📊 Detailed Cost Breakdown • 📱 Real-Time Dashboard
      </div>
    </div>
  </section>
</BaseLayout>