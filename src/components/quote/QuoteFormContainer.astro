---
// 重构后的报价表单主容器
// 拆分为模块化组件，提高可维护性

import FileUploadSection from './sections/FileUploadSection.astro';
import ContactInfoSection from './sections/ContactInfoSection.astro';
import ProductSpecSection from './sections/ProductSpecSection.astro';
import AlertMessage from './ui/AlertMessage.astro';

interface Props {
  language?: 'zh' | 'en';
}

const { language = 'zh' } = Astro.props;

const text = {
  zh: {
    title: '获取专业报价',
    subtitle: '上传您的CAD文件，我们将在8小时内回复专业报价',
    submitButton: '提交报价申请',
    loadingButton: '提交中...',
    guarantee: {
      title: '服务承诺',
      items: [
        '8小时专家审核回复',
        '价格透明无隐藏费用', 
        '质量保证',
        '免费技术咨询'
      ]
    },
    modal: {
      title: '🎉 提交成功！',
      message: '您的报价申请已成功提交！我们将在8小时内通过邮件回复您专业报价。',
      quoteId: '申请编号',
      closeBtn: '✅ 好的',
      submitAgainBtn: '📋 再次提交',
      contactText: '如有紧急需求，请联系: '
    },
    loginRequired: '请先登录，我们已经保存了您填写的内容，登录完成后会自动恢复。',
    draft: {
      title: '已为你恢复上次填写的草稿',
      description: '为了保证文件安全，系统只自动保存文字信息，请重新上传 CAD 文件后再提交即可。',
      filesLabel: '上次选择的文件（需重新上传）：',
      noFiles: '上次未选择任何文件',
      dismiss: '知道了'
    },
    validation: {
      generalError: '请检查表单中的错误信息',
      submitError: '提交失败，请稍后重试或联系客服'
    }
  },
  en: {
    title: 'Get Professional Quote',
    subtitle: 'Upload your CAD files and get professional quote within 8 hours',
    submitButton: 'Submit Quote Request',
    loadingButton: 'Submitting...',
    guarantee: {
      title: 'Our Promise',
      items: [
        '8-hour expert review',
        'Transparent pricing', 
        'Quality guarantee',
        'Free technical consultation'
      ]
    },
    modal: {
      title: '🎉 Success!',
      message: 'Your quote request has been submitted successfully! We will reply via email within 8 hours.',
      quoteId: 'Quote ID',
      closeBtn: '✅ OK',
      submitAgainBtn: '📋 Submit Again',
      contactText: 'For urgent needs, contact: '
    },
    loginRequired: 'Please sign in first. Your inputs are saved and will auto-restore after login.',
    draft: {
      title: 'We restored your last draft',
      description: 'For security reasons we only keep text fields. Please re-upload the CAD files before submitting.',
      filesLabel: 'Previously selected files (need re-upload):',
      noFiles: 'No files were selected last time.',
      dismiss: 'Got it'
    },
    validation: {
      generalError: 'Please check the errors in the form',
      submitError: 'Submission failed, please try again or contact support'
    }
  }
};

const t = text[language];
---

<div class="quote-form-container max-w-4xl mx-auto p-6 bg-white rounded-lg shadow-lg">
  <!-- Header -->
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-2">{t.title}</h2>
    <p class="text-gray-600">{t.subtitle}</p>
  </div>

  <div id="draft-restore-banner" class="hidden mb-6 rounded-xl border border-amber-200 bg-amber-50 text-amber-900">
    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between md:gap-6 px-5 py-4">
      <div class="flex-1">
        <p id="draft-banner-title" class="text-base font-semibold"></p>
        <p id="draft-banner-description" class="mt-1 text-sm"></p>
        <ul id="draft-banner-files" class="mt-3 space-y-1 text-xs text-amber-800"></ul>
      </div>
      <button
        type="button"
        id="draft-banner-dismiss"
        class="self-start text-sm font-semibold text-amber-600 hover:text-amber-800 transition-colors"
        aria-label="Dismiss draft restore banner"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Form -->
  <form id="create-quote-form" class="space-y-8">
    <!-- File Upload Section -->
    <div class="form-section">
      <FileUploadSection language={language} required={true} />
    </div>

    <!-- Contact Info Section -->
    <div class="form-section">
      <ContactInfoSection language={language} />
    </div>

    <!-- Product Spec Section -->
    <div class="form-section">
      <ProductSpecSection language={language} />
    </div>

    <!-- Submit Button -->
    <div class="text-center">
      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto px-8 py-3 bg-indigo-600 text-white font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="submit-text">{t.submitButton}</span>
        <svg id="submit-spinner" class="hidden animate-spin ml-2 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="m12 2a10 10 0 0 1 10 10h-4a6 6 0 0 0-6-6v-4z"></path>
        </svg>
      </button>
    </div>

    <!-- Form Messages -->
    <div id="form-messages" class="space-y-4">
      <!-- Success Message (Hidden by default) -->
      <div id="success-message" class="hidden">
        <AlertMessage 
          type="success"
          title={t.modal.title}
          message=""
          id="success-alert"
          dismissible={false}
        />
      </div>

      <!-- Error Message (Hidden by default) -->
      <div id="error-message" class="hidden">
        <AlertMessage 
          type="error"
          title="提交失败"
          message=""
          id="error-alert"
          dismissible={true}
        />
      </div>
    </div>
  </form>

  <!-- Service Guarantee -->
  <div class="mt-8 p-6 bg-gray-50 rounded-lg">
    <h3 class="text-lg font-medium text-gray-900 mb-4">{t.guarantee.title}</h3>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {t.guarantee.items.map(item => (
        <div class="flex items-center space-x-2">
          <svg class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="text-sm text-gray-700">{item}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- Success Modal -->
<div id="success-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white rounded-lg max-w-md w-full p-6">
      <div class="text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
          <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2" id="modal-title">{t.modal.title}</h3>
        <p class="text-gray-500 mb-4" id="modal-message">{t.modal.message}</p>
        <div class="bg-gray-50 rounded p-3 mb-4">
          <p class="text-sm text-gray-700">
            <strong>{t.modal.quoteId}:</strong> 
            <span id="modal-quote-id" class="font-mono"></span>
          </p>
        </div>
        <div class="flex space-x-3">
          <button
            type="button"
            id="modal-close-btn"
            class="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            {t.modal.closeBtn}
          </button>
          <button
            type="button"
            id="modal-submit-again-btn"
            class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500"
          >
            {t.modal.submitAgainBtn}
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-4">
          {t.modal.contactText} <span class="font-medium">service@geppetto.studio</span>
        </p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ language }}>
// Inline quote submission function
async function submitQuoteForm({ files, language, contactData, productData }) {
  const formData = new FormData();
  formData.append('language', language);
  formData.append('email', (contactData.email ?? '').toString());

  const appendOptional = (key, value) => {
    if (value === undefined || value === null || value === '') return;
    formData.append(key, typeof value === 'number' ? value.toString() : value);
  };

  appendOptional('name', contactData.name);
  appendOptional('company', contactData.company);
  appendOptional('phone', contactData.phone);
  appendOptional('country', contactData.country);

  formData.append('material', (productData.material ?? '').toString());
  appendOptional('quantity', Number(productData.quantity) || 1);
  appendOptional('notes', productData.notes || productData.requirements);

  files.forEach((file, index) => {
    formData.append(`file${index}`, file);
  });

  console.debug('🚀 [submitQuoteForm] Submitting to API:', {
    fileCount: files.length,
    email: contactData.email,
    material: productData.material,
    timestamp: new Date().toISOString()
  });

  const response = await fetch('/api/functions/create-quote', {
    method: 'POST',
    body: formData
  });

  const result = await response.json().catch(() => null);

  console.debug('📨 [submitQuoteForm] API Response:', {
    status: response.status,
    ok: response.ok,
    success: result?.success,
    hasData: !!result?.data,
    error: result?.error,
    timestamp: new Date().toISOString()
  });

  if (!response.ok || !result?.success || !result.data) {
    const errorMsg = result?.error || 'Quote submission failed.';
    console.error('❌ [submitQuoteForm] Submission failed:', errorMsg);
    throw new Error(errorMsg);
  }

  console.debug('✅ [submitQuoteForm] Submission successful:', result.data);
  return result.data;
}

// Inline Supabase client
function createSupabaseBrowserClient() {
  if (window.supabaseClient) {
    return window.supabaseClient;
  }

  // 兜底客户端：每次调用时都会尝试获取真实客户端
  return {
    auth: {
      getSession: async () => {
        if (window.supabaseClient?.auth?.getSession) {
          return window.supabaseClient.auth.getSession();
        }
        return { data: { session: null }, error: null };
      }
    }
  };
}

const STORAGE_PREFIX = `quoteFormDraft:${language}`;

class QuoteFormController {
  constructor() {
    this.language = language;
    this.isSubmitting = false;
    this.redirecting = false;
    this.storageKey = `${STORAGE_PREFIX}:data`;
    this.fileMetaKey = `${STORAGE_PREFIX}:files`;
    this.restoreFlagKey = `${STORAGE_PREFIX}:restore`;
    this.supabaseClient = createSupabaseBrowserClient();
    this.cachedSession = undefined;
    
    this.text = {
      zh: {
        submitButton: '提交报价申请',
        loadingButton: '提交中...',
        generalError: '请检查表单中的错误信息',
        submitError: '提交失败，请稍后重试或联系客服',
        submitSuccess: '您的报价申请已成功提交！',
        networkError: '网络连接失败，请检查网络后重试',
        loginRequired: '请先登录，我们已经保存了您填写的内容，登录后会自动恢复。',
        draftTitle: '已为你恢复上次填写的草稿',
        draftDescription: '系统已填充文字内容，请重新上传 CAD 文件后再提交。',
        draftFilesLabel: '需重新上传的文件：',
        draftNoFiles: '上次未选择任何文件。',
        draftDismiss: '知道了'
      },
      en: {
        submitButton: 'Submit Quote Request',
        loadingButton: 'Submitting...',
        generalError: 'Please check the errors in the form',
        submitError: 'Submission failed, please try again or contact support',
        submitSuccess: 'Your quote request has been submitted successfully!',
        networkError: 'Network connection failed, please check and retry',
        loginRequired: 'Please sign in first. Your inputs are saved and will auto-restore after login.',
        draftTitle: 'We restored your last draft',
        draftDescription: 'Text fields are back in place. Please re-upload the CAD files before submitting.',
        draftFilesLabel: 'Previously selected files (re-upload required):',
        draftNoFiles: 'No files were selected last time.',
        draftDismiss: 'Got it'
      }
    };
    
    this.t = this.text[this.language];
    this.initializeForm();
    this.restoreDraftIfAvailable();
  }

  initializeForm() {
    const form = document.getElementById('create-quote-form');

    if (form) {
      form.addEventListener('submit', (e) => this.handleSubmit(e));
    }

    const dismissBannerBtn = document.getElementById('draft-banner-dismiss');
    if (dismissBannerBtn) {
      dismissBannerBtn.addEventListener('click', () => this.hideDraftBanner());
    }

    // Modal event listeners
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalSubmitAgainBtn = document.getElementById('modal-submit-again-btn');

    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', () => this.closeModal());
    }

    if (modalSubmitAgainBtn) {
      modalSubmitAgainBtn.addEventListener('click', () => {
        this.closeModal();
        this.resetForm();
      });
    }
  }

  async handleSubmit(e) {
    e.preventDefault();
    
    if (this.isSubmitting) return;

    if (!this.validateForm()) {
      this.showError(this.t.generalError);
      return;
    }

    this.setSubmitting(true);
    
    try {
      const formData = this.collectFormData();
      this.saveDraft(formData);

      const isAuthenticated = await this.ensureAuthenticated();
      if (!isAuthenticated) {
        this.showError(this.t.loginRequired);
        this.markRestoreFlag();
        this.redirectToLogin();
        return;
      }

      const response = await this.submitQuote(formData);
      
      if (response.success) {
        this.showSuccessModal(response.data);
      } else {
        this.showError(response.message || this.t.submitError);
      }
    } catch (error) {
      console.error('Quote submission error:', error);
      this.showError(this.t.networkError);
    } finally {
      if (!this.redirecting) {
        this.setSubmitting(false);
      }
    }
  }

  validateForm() {
    let isValid = true;
    
    // Validate contact info
    if (window.contactInfoValidator && !window.contactInfoValidator.validateAll()) {
      isValid = false;
    }
    
    // Validate product specs
    if (window.productSpecValidator && !window.productSpecValidator.validateAll()) {
      isValid = false;
    }
    
    // Validate file upload
    if (window.fileUploadHandler && window.fileUploadHandler.selectedFiles.length === 0) {
      window.fileUploadHandler.showError(
        this.language === 'zh' ? '请上传至少一个CAD文件' : 'Please upload at least one CAD file'
      );
      isValid = false;
    }
    
    return isValid;
  }

  collectFormData() {
    const contactData = window.contactInfoValidator ? window.contactInfoValidator.getContactData() : {};
    const productData = window.productSpecValidator ? window.productSpecValidator.getProductData() : {};
    const files = window.fileUploadHandler ? window.fileUploadHandler.getFiles() : [];
    
    return {
      contact: contactData,
      product: productData,
      files
    };
  }

  async submitQuote(formData) {
    try {
      // 显示提交开始toast
      if (window.modalStore) {
        window.modalStore.showToast(
          this.language === 'zh' ? '正在提交报价申请...' : 'Submitting quote request...',
          'info',
          8000
        );
      }

      const quoteResult = await submitQuoteForm({
        files: formData.files || [],
        language: this.language,
        contactData: {
          email: formData.contact?.email,
          name: formData.contact?.name,
          company: formData.contact?.company,
          phone: formData.contact?.phone,
          country: formData.contact?.country
        },
        productData: {
          material: formData.product?.material,
          quantity: parseInt(formData.product?.quantity ?? 1, 10) || 1,
          notes: formData.product?.notes || null
        }
      });

      this.clearDraft();
      this.hideDraftBanner();

      // 显示成功toast和modal
      if (window.modalStore) {
        window.modalStore.clearAllToasts();
        window.modalStore.showToast(
          this.language === 'zh' 
            ? `✅ 报价申请提交成功！ID: #${quoteResult.id}`
            : `✅ Quote request submitted! ID: #${quoteResult.id}`,
          'success',
          6000
        );
        
        window.modalStore.showSuccess(
          this.language === 'zh' ? '🎉 提交成功！' : '🎉 Success!',
          this.language === 'zh' 
            ? `您的报价申请已成功提交！报价ID: #${quoteResult.id}\n我们将在8小时内通过邮件回复专业报价。`
            : `Your quote request has been submitted successfully! Quote ID: #${quoteResult.id}\nWe will reply via email within 8 hours.`,
          {
            confirmText: this.language === 'zh' ? '好的' : 'OK',
            onConfirm: () => window.modalStore?.closeModal()
          }
        );
      }

      return {
        success: true,
        data: {
          id: quoteResult.id,
          token: quoteResult.token || quoteResult.id,
          message: this.t.submitSuccess
        }
      };
    } catch (error) {
      console.error('❌ [QuoteFormController] 提交失败:', error);
      
      // 显示错误toast和modal
      if (window.modalStore) {
        window.modalStore.clearAllToasts();
        window.modalStore.showToast(
          this.language === 'zh' ? `❌ 提交失败: ${error.message}` : `❌ Failed: ${error.message}`,
          'error',
          8000
        );
        
        let errorMessage = error.message || 'Unknown error';
        if (errorMessage.includes('log in')) {
          errorMessage = this.language === 'zh' 
            ? '请先登录后再提交报价申请' 
            : 'Please log in before submitting quote';
        }
        
        window.modalStore.showError(
          this.language === 'zh' ? '❌ 提交失败' : '❌ Submission Failed',
          errorMessage,
          {
            confirmText: this.language === 'zh' ? '确定' : 'OK',
            onConfirm: () => window.modalStore?.closeModal()
          }
        );
      }
      
      throw error;
    }
  }

  async ensureAuthenticated() {
    try {
      if (typeof this.cachedSession === 'boolean') {
        return this.cachedSession;
      }

      if (window.supabaseClient && window.supabaseClient !== this.supabaseClient) {
        this.supabaseClient = window.supabaseClient;
      }

      if (!this.supabaseClient?.auth?.getSession) {
        this.cachedSession = false;
        return false;
      }

      const { data, error } = await this.supabaseClient.auth.getSession();
      if (error) {
        console.error('Supabase session error:', error);
        this.cachedSession = false;
        return false;
      }

      this.cachedSession = Boolean(data?.session);
      return this.cachedSession;
    } catch (err) {
      console.error('Failed to verify session:', err);
      this.cachedSession = false;
      return false;
    }
  }

  markRestoreFlag() {
    try {
      sessionStorage.setItem(this.restoreFlagKey, 'pending');
    } catch (err) {
      console.warn('Unable to set restore flag:', err);
    }
  }

  redirectToLogin() {
    this.redirecting = true;
    const target = `${window.location.pathname}${window.location.search}`;
    const loginPath = `/${this.language}/login?redirect=${encodeURIComponent(target)}`;
    window.location.href = loginPath;
  }

  setSubmitting(isSubmitting) {
    this.isSubmitting = isSubmitting;
    
    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');
    const submitSpinner = document.getElementById('submit-spinner');
    
    if (submitBtn && submitText && submitSpinner) {
      if (isSubmitting) {
        submitBtn.disabled = true;
        submitText.textContent = this.t.loadingButton;
        submitSpinner.classList.remove('hidden');
      } else {
        submitBtn.disabled = false;
        submitText.textContent = this.t.submitButton;
        submitSpinner.classList.add('hidden');
      }
    }
  }

  showError(message) {
    this.hideMessages();
    
    if (window.AlertUtils) {
      window.AlertUtils.show('error-alert', 'error', message, 
        this.language === 'zh' ? '提交失败' : 'Submission Failed');
    }
    
    const errorMessage = document.getElementById('error-message');
    if (errorMessage) {
      errorMessage.classList.remove('hidden');
    }
  }

  showSuccessModal(data) {
    this.hideMessages();
    
    const modal = document.getElementById('success-modal');
    const modalQuoteId = document.getElementById('modal-quote-id');
    
    if (modalQuoteId && data.id) {
      modalQuoteId.textContent = data.id;
    }
    
    if (modal) {
      modal.classList.remove('hidden');
    }
  }

  closeModal() {
    const modal = document.getElementById('success-modal');
    if (modal) {
      modal.classList.add('hidden');
    }
  }

  resetForm() {
    const form = document.getElementById('create-quote-form');
    if (form) {
      form.reset();
    }
    
    this.clearDraft();
    this.hideDraftBanner();
    
    // Reset file upload
    if (window.fileUploadHandler) {
      window.fileUploadHandler.selectedFiles = [];
      window.fileUploadHandler.displayFileList();
      window.fileUploadHandler.hideMessages();
    }
    
    // Clear validators
    if (window.contactInfoValidator) {
      ['email', 'name', 'phone'].forEach(field => {
        window.contactInfoValidator.clearError(field);
      });
    }
    
    if (window.productSpecValidator) {
      ['material', 'quantity', 'notes'].forEach(field => {
        window.productSpecValidator.clearError(field);
      });
    }
    
    this.hideMessages();
  }

  hideMessages() {
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    
    if (successMessage) successMessage.classList.add('hidden');
    if (errorMessage) errorMessage.classList.add('hidden');
  }

  saveDraft(formData) {
    try {
      const payload = {
        contact: formData.contact,
        product: formData.product,
        savedAt: new Date().toISOString()
      };
      localStorage.setItem(this.storageKey, JSON.stringify(payload));
      this.saveFileMeta(formData.files || []);
    } catch (error) {
      console.warn('Unable to save draft:', error);
    }
  }

  saveFileMeta(files) {
    try {
      if (!files.length) {
        localStorage.removeItem(this.fileMetaKey);
        return;
      }
      const meta = files.map((file) => ({
        name: file.name,
        size: file.size
      }));
      localStorage.setItem(this.fileMetaKey, JSON.stringify(meta));
    } catch (error) {
      console.warn('Unable to save file meta:', error);
    }
  }

  clearDraft() {
    try {
      localStorage.removeItem(this.storageKey);
      localStorage.removeItem(this.fileMetaKey);
    } catch (error) {
      console.warn('Unable to clear draft:', error);
    }
  }

  restoreDraftIfAvailable() {
    try {
      const raw = localStorage.getItem(this.storageKey);
      if (!raw) {
        this.hideDraftBanner();
        return;
      }

      const draft = JSON.parse(raw);
      this.applyDraftToForm(draft);
      const fileMetaRaw = localStorage.getItem(this.fileMetaKey);
      const fileMeta = fileMetaRaw ? JSON.parse(fileMetaRaw) : [];

      const highlight = sessionStorage.getItem(this.restoreFlagKey) === 'pending';
      if (highlight) {
        sessionStorage.removeItem(this.restoreFlagKey);
      }
      this.showDraftBanner(fileMeta);
    } catch (error) {
      console.warn('Unable to restore draft:', error);
      this.hideDraftBanner();
    }
  }

  applyDraftToForm(draft) {
    const contact = draft?.contact || {};
    const product = draft?.product || {};
    const setValue = (id, value) => {
      const el = document.getElementById(id);
      if (el && typeof value === 'string') {
        el.value = value;
      }
    };

    setValue('email', contact.email || '');
    setValue('name', contact.name || '');
    setValue('company', contact.company || '');
    setValue('phone', contact.phone || '');
    setValue('material', product.material || '');

    const quantityEl = document.getElementById('quantity');
    if (quantityEl && product.quantity !== undefined && product.quantity !== null) {
      quantityEl.value = `${product.quantity}`;
    }

    const notesEl = document.getElementById('notes');
    if (notesEl && typeof product.notes === 'string') {
      notesEl.value = product.notes;
      if (window.productSpecValidator?.updateNotesCount) {
        window.productSpecValidator.updateNotesCount();
      }
    }
  }

  showDraftBanner(fileMeta = []) {
    const banner = document.getElementById('draft-restore-banner');
    if (!banner) return;

    banner.classList.remove('hidden');

    const titleEl = document.getElementById('draft-banner-title');
    const descEl = document.getElementById('draft-banner-description');
    const filesEl = document.getElementById('draft-banner-files');

    if (titleEl) titleEl.textContent = this.t.draftTitle;
    if (descEl) descEl.textContent = this.t.draftDescription;

    if (filesEl) {
      filesEl.innerHTML = '';

      const labelItem = document.createElement('li');
      labelItem.classList.add('font-semibold');
      labelItem.textContent = this.t.draftFilesLabel;
      filesEl.appendChild(labelItem);

      if (fileMeta.length) {
        fileMeta.forEach((file) => {
          const li = document.createElement('li');
          li.textContent = `${file.name} (${this.formatFileSize(file.size)})`;
          filesEl.appendChild(li);
        });
      } else {
        const li = document.createElement('li');
        li.textContent = this.t.draftNoFiles;
        filesEl.appendChild(li);
      }
    }

    const dismissBtn = document.getElementById('draft-banner-dismiss');
    if (dismissBtn) {
      dismissBtn.title = this.t.draftDismiss;
    }
  }

  hideDraftBanner() {
    const banner = document.getElementById('draft-restore-banner');
    if (banner) {
      banner.classList.add('hidden');
    }
  }

  formatFileSize(bytes = 0) {
    if (!bytes) return '0 B';
    const thresh = 1024;
    if (Math.abs(bytes) < thresh) {
      return `${bytes} B`;
    }
    const units = ['KB', 'MB', 'GB', 'TB'];
    let u = -1;
    do {
      bytes /= thresh;
      ++u;
    } while (Math.abs(bytes) >= thresh && u < units.length - 1);
    return `${bytes.toFixed(1)} ${units[u]}`;
  }
}

// Initialize form controller when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  window.quoteFormController = new QuoteFormController();
});
</script>

