# =============================================================================
# Geppetto CNC 网站环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================================

# -----------------------------------------------------------------------------
# 必需配置 - 网站无法运行如果缺少这些
# -----------------------------------------------------------------------------

# Supabase 数据库配置
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.your-service-role-key

# 网站基础配置
SITE_URL=https://www.geppetto.studio
PUBLIC_SITE_URL=https://www.geppetto.studio

# -----------------------------------------------------------------------------
# 可选配置 - 用于增强功能
# -----------------------------------------------------------------------------

# Stripe 支付服务 (如需支付功能)
STRIPE_SECRET_KEY=sk_test_51xxx...
STRIPE_WEBHOOK_SECRET=whsec_xxx...

# Resend 邮件服务 (如需邮件通知)
RESEND_API_KEY=re_xxx...

# 邮箱地址配置 (默认值已设置，可覆盖)
ADMIN_EMAIL=business@geppetto.studio
SUPPORT_EMAIL=hello@geppetto.studio

# 开发环境设置
NODE_ENV=development

# -----------------------------------------------------------------------------
# 使用说明
# -----------------------------------------------------------------------------

# 1. 复制此文件为 .env：cp .env.template .env
# 2. 填入你的实际配置值
# 3. 绝不要提交 .env 文件到版本控制
# 4. 生产环境请在 Vercel 等平台的环境变量面板中设置

# 获取 Supabase 配置：
# - 登录 https://supabase.com
# - 选择项目 > Settings > API
# - 复制 URL 和 anon key

# 获取 Stripe 配置：
# - 登录 https://stripe.com
# - Developers > API keys
# - 复制 Secret key 和 Webhook endpoint secret

# 获取 Resend 配置：
# - 登录 https://resend.com
# - API Keys > Create API Key