---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutForm from '../../components/checkout/CheckoutForm.astro';
---

<BaseLayout 
  title="Confirm Order - Select Shipping & Payment | Geppetto Smart Manufacturing"
  description="Confirm your CNC manufacturing order, choose shipping method (Express Air, Standard Air, Economy Sea) and payment options. Transparent pricing, secure payment."
  keywords={[
    "order confirmation", "CNC manufacturing order", "shipping options", "payment method selection",
    "express air shipping", "standard shipping", "economy sea freight", "manufacturing order payment",
    "bank transfer", "PayPal payment", "wire transfer", "installment payment"
  ]}
  ogImage="/images/og-checkout.jpg"
  structuredData={{
    type: 'webpage',
    data: {
      '@type': 'CheckoutPage',
      'name': 'Order Confirmation Page',
      'description': 'Confirm CNC manufacturing order with shipping and payment selection',
      'provider': {
        '@type': 'Organization',
        'name': 'Geppetto Smart Manufacturing'
      }
    }
  }}
>
  <CheckoutForm language="en" />
</BaseLayout>