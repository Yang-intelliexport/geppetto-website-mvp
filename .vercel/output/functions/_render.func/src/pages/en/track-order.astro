---
// English Order Tracking Page
// Complete quote and order inquiry functionality

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthenticatedOrderTracker from '../../components/order/AuthenticatedOrderTracker.tsx';
---

<BaseLayout 
  title="Order Tracking - Track Your Quotes & Orders | Geppetto"
  description="Track your quote requests and order progress at Geppetto. Use your email address or order ID to quickly view current status, pricing information, and production progress."
  canonicalURL="https://geppetto.studio/en/track-order"
  language="en"
>
  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-16 px-4 sm:px-6 lg:px-8">
    <!-- Page Title Section -->
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Order Tracking Center
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Enter your email address or order ID to view real-time status updates for your quote requests and orders
      </p>
      
      <!-- Feature Overview -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 text-left">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-blue-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">Quick Search</h3>
          </div>
          <p class="text-gray-600 text-sm">
            Use your registered email or 8-digit order ID to quickly find all your quotes and orders
          </p>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-green-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">Real-time Status</h3>
          </div>
          <p class="text-gray-600 text-sm">
            From quote request to production completion, transparent status updates and progress tracking
          </p>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-purple-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">Detailed Information</h3>
          </div>
          <p class="text-gray-600 text-sm">
            View detailed quotes, engineer notes, and estimated delivery times
          </p>
        </div>
      </div>
    </div>

    <!-- Order Tracking Component with Authentication -->
    <AuthenticatedOrderTracker client:load language="en" />
    
    <!-- Help Information -->
    <div class="max-w-4xl mx-auto mt-12">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-blue-600 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-blue-900 mb-2">Need Help?</h3>
            <div class="text-blue-800 space-y-2 text-sm">
              <p><strong>Search Methods:</strong></p>
              <ul class="list-disc ml-6 space-y-1">
                <li>Use the email address you provided when submitting your quote</li>
                <li>Use the 8-digit order ID from your confirmation email (e.g., A1B2C3D4)</li>
                <li>Use the full order UUID (supports full or partial matching)</li>
              </ul>
              <p class="mt-3">
                <strong>Can't find your order?</strong> Please check that your email address is correct, or contact our support team:
                <a href="mailto:hello@geppetto.studio" class="font-medium underline hover:no-underline">
                  hello@geppetto.studio
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Guide -->
    <div class="max-w-4xl mx-auto mt-8">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">📋 Order Status Guide</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <div class="text-center p-3 bg-yellow-50 rounded-lg border border-yellow-200">
            <div class="text-2xl mb-2">📋</div>
            <div class="font-semibold text-yellow-800">Pending</div>
            <div class="text-xs text-yellow-700 mt-1">Quote request received</div>
          </div>
          <div class="text-center p-3 bg-blue-50 rounded-lg border border-blue-200">
            <div class="text-2xl mb-2">🔍</div>
            <div class="font-semibold text-blue-800">Reviewing</div>
            <div class="text-xs text-blue-700 mt-1">Engineer is reviewing</div>
          </div>
          <div class="text-center p-3 bg-purple-50 rounded-lg border border-purple-200">
            <div class="text-2xl mb-2">💰</div>
            <div class="font-semibold text-purple-800">Quoted</div>
            <div class="text-xs text-purple-700 mt-1">Awaiting your confirmation</div>
          </div>
          <div class="text-center p-3 bg-green-50 rounded-lg border border-green-200">
            <div class="text-2xl mb-2">📦</div>
            <div class="font-semibold text-green-800">Ordered</div>
            <div class="text-xs text-green-700 mt-1">In production</div>
          </div>
          <div class="text-center p-3 bg-gray-50 rounded-lg border border-gray-200">
            <div class="text-2xl mb-2">✅</div>
            <div class="font-semibold text-gray-800">Completed</div>
            <div class="text-xs text-gray-700 mt-1">Order archived</div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<!-- Page-level Styles -->
<style>
  /* Ensure smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
  
  /* Optimize mobile display */
  @media (max-width: 640px) {
    .grid-cols-1.md\\:grid-cols-3 {
      gap: 1rem;
    }
    
    .grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-5 {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>