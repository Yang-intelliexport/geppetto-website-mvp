---
// 中文版订单追踪页面
// 提供完整的报价和订单查询功能

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthenticatedOrderTracker from '../../components/order/AuthenticatedOrderTracker.tsx';
---

<BaseLayout 
  title="订单追踪 - 查询您的报价和订单状态 | Geppetto"
  description="查询您在Geppetto的报价申请和订单进度。使用邮箱地址或订单编号即可快速查看当前状态、报价信息和生产进度。"
  canonicalURL={`${import.meta.env.PUBLIC_SITE_URL || 'https://www.geppetto.studio'}/zh/track-order`}
  language="zh"
>
  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-16 px-4 sm:px-6 lg:px-8">
    <!-- 页面标题区域 -->
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        订单追踪中心
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        输入您的邮箱地址或订单编号，实时查看报价申请和订单的最新状态
      </p>
      
      <!-- 功能说明 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 text-left">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-blue-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">快速查询</h3>
          </div>
          <p class="text-gray-600 text-sm">
            使用注册邮箱或8位订单编号，快速找到您的所有报价和订单
          </p>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-green-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">实时状态</h3>
          </div>
          <p class="text-gray-600 text-sm">
            从报价申请到生产完成，全程透明的状态更新和进度追踪
          </p>
        </div>
        
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <div class="flex items-center mb-4">
            <div class="bg-purple-100 rounded-lg p-2">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 ml-3">详细信息</h3>
          </div>
          <p class="text-gray-600 text-sm">
            查看详细的报价信息、工程师备注和预计交付时间
          </p>
        </div>
      </div>
    </div>

    <!-- 订单追踪组件 with Authentication -->
    <AuthenticatedOrderTracker client:load language="zh" />
    
    <!-- 帮助信息 -->
    <div class="max-w-4xl mx-auto mt-12">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-blue-600 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-blue-900 mb-2">需要帮助？</h3>
            <div class="text-blue-800 space-y-2 text-sm">
              <p><strong>查询方式：</strong></p>
              <ul class="list-disc ml-6 space-y-1">
                <li>使用您提交报价时填写的邮箱地址</li>
                <li>使用订单确认邮件中的8位编号（如：A1B2C3D4）</li>
                <li>使用完整的订单UUID（支持完整或部分匹配）</li>
              </ul>
              <p class="mt-3">
                <strong>找不到订单？</strong> 请检查邮箱地址是否正确，或联系我们的客服团队：
                <a href="mailto:hello@geppetto.studio" class="font-medium underline hover:no-underline">
                  hello@geppetto.studio
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 状态说明 -->
    <div class="max-w-4xl mx-auto mt-8">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">📋 订单状态说明</h3>
        <div class="space-y-6">
          <!-- 报价阶段 -->
          <div>
            <h4 class="text-sm font-medium text-gray-900 mb-3">📝 报价阶段（Quote Phase）</h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="text-center p-3 bg-yellow-50 rounded-lg border border-yellow-200">
                <div class="text-xl mb-1">📋</div>
                <div class="font-semibold text-yellow-800 text-sm">待处理</div>
                <div class="text-xs text-yellow-700 mt-1">申请已收到</div>
              </div>
              <div class="text-center p-3 bg-blue-50 rounded-lg border border-blue-200">
                <div class="text-xl mb-1">🤖</div>
                <div class="font-semibold text-blue-800 text-sm">AI评估</div>
                <div class="text-xs text-blue-700 mt-1">智能分析中</div>
              </div>
              <div class="text-center p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                <div class="text-xl mb-1">🔍</div>
                <div class="font-semibold text-indigo-800 text-sm">专家审核</div>
                <div class="text-xs text-indigo-700 mt-1">人工审核中</div>
              </div>
              <div class="text-center p-3 bg-purple-50 rounded-lg border border-purple-200">
                <div class="text-xl mb-1">💰</div>
                <div class="font-semibold text-purple-800 text-sm">已报价</div>
                <div class="text-xs text-purple-700 mt-1">可支付下单</div>
              </div>
            </div>
          </div>
          
          <!-- 订单阶段 -->
          <div>
            <h4 class="text-sm font-medium text-gray-900 mb-3">📦 订单阶段（Order Phase）</h4>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
              <div class="text-center p-3 bg-green-50 rounded-lg border border-green-200">
                <div class="text-xl mb-1">💳</div>
                <div class="font-semibold text-green-800 text-sm">支付成功</div>
                <div class="text-xs text-green-700 mt-1">进入生产</div>
              </div>
              <div class="text-center p-3 bg-orange-50 rounded-lg border border-orange-200">
                <div class="text-xl mb-1">⚙️</div>
                <div class="font-semibold text-orange-800 text-sm">制造中</div>
                <div class="text-xs text-orange-700 mt-1">CNC加工</div>
              </div>
              <div class="text-center p-3 bg-blue-50 rounded-lg border border-blue-200">
                <div class="text-xl mb-1">🔍</div>
                <div class="font-semibold text-blue-800 text-sm">质量检测</div>
                <div class="text-xs text-blue-700 mt-1">精度测量</div>
              </div>
              <div class="text-center p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                <div class="text-xl mb-1">📦</div>
                <div class="font-semibold text-indigo-800 text-sm">打包中</div>
                <div class="text-xs text-indigo-700 mt-1">准备发货</div>
              </div>
              <div class="text-center p-3 bg-gray-50 rounded-lg border border-gray-200">
                <div class="text-xl mb-1">✅</div>
                <div class="font-semibold text-gray-800 text-sm">已交付</div>
                <div class="text-xs text-gray-700 mt-1">订单完成</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<!-- 页面级样式 -->
<style>
  /* 确保页面滚动平滑 */
  html {
    scroll-behavior: smooth;
  }
  
  /* 优化移动端显示 */
  @media (max-width: 640px) {
    .grid-cols-1.md\\:grid-cols-3 {
      gap: 1rem;
    }
    
    .grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-5 {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>